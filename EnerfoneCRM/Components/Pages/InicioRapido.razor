            // Parsear resultado
            resultadoServicios = ParsearResultado(salida);

            if (resultadoServicios.Importados > 0)
            {
                mensajeExito = $"Importación completada: {resultadoServicios.Importados} servicios importados.";
            }
            else if (resultadoServicios.Errores > 0 || resultadoServicios.DetalleErrores.Any())
            {
                mensajeError = $"Errores encontrados. Revisa los detalles.";
            }
            else if (salida.Contains("[OK]", StringComparison.OrdinalIgnoreCase))
            {
