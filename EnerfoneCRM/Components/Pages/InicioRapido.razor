            // Log para debug en consola
            Console.WriteLine($"[ImportarServicios] ExitCode: {proceso.ExitCode}");
            Console.WriteLine($"[ImportarServicios] Salida: {salida}");
            if (!string.IsNullOrWhiteSpace(errores))
