@page "/mi-perfil"
@rendermode InteractiveServer
@using EnerfoneCRM.Services
@using EnerfoneCRM.Models
@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject PerfilSuperAdminService PerfilService
@inject UsuarioService UsuarioService
@inject ILogger<MiPerfil> Logger
@inject NavigationManager NavigationManager

<PageTitle>Mi Perfil - EnerfoneCRM</PageTitle>

@if (cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 text-muted">Cargando...</p>
    </div>
}
else if (!AuthService.EsSuperAdmin)
{
    <div class="container mt-4">
        <div class="row">
            <div class="col-12">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="bi bi-person-circle me-2"></i>Mi Perfil</h4>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
                                <button type="button" class="btn-close" @onclick="@(() => mensajeError = string.Empty)"></button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(mensajeExito))
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle me-2"></i>@mensajeExito
                                <button type="button" class="btn-close" @onclick="@(() => mensajeExito = string.Empty)"></button>
                            </div>
                        }

                        @if (perfilCargado)
                        {
                        <EditForm Model="@formUsuario" OnValidSubmit="@HandleGuardarPerfilUsuario">
                            <DataAnnotationsValidator />

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Usuario</label>
                                    <input type="text" class="form-control" value="@AuthService.UsuarioActual?.NombreUsuario" readonly disabled />
                                    <div class="form-text">El nombre de usuario no se puede modificar</div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Rol</label>
                                    <input type="text" class="form-control" value="@AuthService.UsuarioActual?.Rol" readonly disabled />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nombre *</label>
                                    <input type="text" class="form-control" @bind="formUsuario.Nombre" placeholder="Ingresa tu nombre" />
                                    <ValidationMessage For="@(() => formUsuario.Nombre)" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Apellidos *</label>
                                    <input type="text" class="form-control" @bind="formUsuario.Apellidos" placeholder="Ingresa tus apellidos" />
                                    <ValidationMessage For="@(() => formUsuario.Apellidos)" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Email *</label>
                                    <input type="email" class="form-control" @bind="formUsuario.Email" placeholder="tucorreo@ejemplo.com" />
                                    <ValidationMessage For="@(() => formUsuario.Email)" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Teléfono</label>
                                    <input type="tel" class="form-control" @bind="formUsuario.Telefono" placeholder="+34612345678" />
                                </div>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center">
                                <a class="btn btn-outline-secondary" href="/cambiar-password">
                                    <i class="bi bi-key me-2"></i>Cambiar contraseña
                                </a>
                                <button type="submit" class="btn btn-primary" disabled="@guardando">
                                    @if (guardando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-save me-2"></i>
                                    }
                                    Guardar cambios
                                </button>
                            </div>
                        </EditForm>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-person-circle me-2"></i>Mi Perfil</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted">Este perfil es global y exclusivo de superadmin. No pertenece a ninguna empresa. Las solicitudes de nuevos usuarios se notificarán al email indicado aquí.</p>
                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
                            <button type="button" class="btn-close" @onclick="@(() => mensajeError = string.Empty)"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(mensajeExito))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>@mensajeExito
                            <button type="button" class="btn-close" @onclick="@(() => mensajeExito = string.Empty)"></button>
                        </div>
                    }

                    @if (perfilCargado)
                    {
                    <EditForm Model="@model" OnValidSubmit="@HandleGuardarPerfil">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Usuario</label>
                                <input type="text" class="form-control" value="@AuthService.UsuarioActual?.NombreUsuario" readonly disabled />
                                <div class="form-text">El nombre de usuario no se puede modificar</div>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Rol</label>
                                <input type="text" class="form-control" value="Superadmin global" readonly disabled />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombre *</label>
                                <input type="text" class="form-control" @bind="model.Nombre" placeholder="Ingresa tu nombre" />
                                <ValidationMessage For="@(() => model.Nombre)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Apellidos *</label>
                                <input type="text" class="form-control" @bind="model.Apellidos" placeholder="Ingresa tus apellidos" />
                                <ValidationMessage For="@(() => model.Apellidos)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Email *</label>
                                <input type="email" class="form-control" @bind="model.Email" placeholder="tucorreo@ejemplo.com" />
                                <ValidationMessage For="@(() => model.Email)" />
                                <div class="form-text">Destinatario de los avisos de solicitud de nuevos usuarios de todas las empresas.</div>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <input type="tel" class="form-control" @bind="model.Telefono" placeholder="+34612345678" />
                                <ValidationMessage For="@(() => model.Telefono)" />
                                <div class="form-text">Formato recomendado: +34612345678 (para WhatsApp)</div>
                            </div>
                        </div>

                        <hr class="my-4" />
                        <h5 class="mb-3"><i class="bi bi-geo-alt me-2"></i>Datos de Contacto</h5>

                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <input type="text" class="form-control" @bind="model.Direccion" placeholder="Calle, número, piso..." />
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Código Postal</label>
                                <div class="input-group">
                                    <input type="text" class="form-control" @bind="model.CodigoPostal" placeholder="28001" maxlength="10" />
                                </div>
                                <ValidationMessage For="@(() => model.CodigoPostal)" />
                            </div>

                            <div class="col-md-8 mb-3">
                                <label class="form-label">Localidad</label>
                                <input type="text" class="form-control" @bind="model.Localidad" placeholder="Madrid" />
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </button>
                            <button type="submit" class="btn btn-primary" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Guardando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-2"></i>
                                    <span>Guardar Cambios</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                    }
                </div>
            </div>

            <div class="mt-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title"><i class="bi bi-info-circle me-2"></i>Información</h6>
                        <ul class="small mb-0">
                            <li>Los campos marcados con * son obligatorios</li>
                            <li>Los cambios se aplican al perfil global, independientemente de la empresa seleccionada</li>
                            <li>Este formulario no modifica las fichas de los usuarios de las empresas</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
}

@code {
    private PerfilSuperAdmin model = new();
    private PerfilUsuarioForm formUsuario = new();
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool guardando = false;
    private bool cargando = true;
    private bool perfilCargado;

    private sealed class PerfilUsuarioForm
    {
        [Required(ErrorMessage = "El nombre es obligatorio")]
        public string? Nombre { get; set; }

        [Required(ErrorMessage = "Los apellidos son obligatorios")]
        public string? Apellidos { get; set; }

        [Required(ErrorMessage = "El email es obligatorio")]
        [EmailAddress(ErrorMessage = "El email no es válido")]
        public string? Email { get; set; }

        public string? Telefono { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!AuthService.EstaAutenticado || AuthService.UsuarioActual == null)
            {
                NavigationManager.NavigateTo("/login", true);
                return;
            }

            try
            {
                if (AuthService.EsSuperAdmin)
                {
                    model = await PerfilService.ObtenerAsync() ?? new PerfilSuperAdmin();
                    perfilCargado = true;
                }
                else
                {
                    var usuario = await UsuarioService.ObtenerPorIdAsync(AuthService.UsuarioActual.Id);
                    if (usuario != null)
                    {
                        formUsuario = new PerfilUsuarioForm
                        {
                            Nombre = usuario.Nombre,
                            Apellidos = usuario.Apellidos,
                            Email = usuario.Email,
                            Telefono = usuario.Telefono
                        };
                        perfilCargado = true;
                    }
                }
            }
            catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
            {
                Logger.LogError(ex, "No se pudo cargar el perfil");
                mensajeError = "No se pudo cargar el perfil. Comprueba la conexión y que se haya aplicado la actualización de base de datos.";
            }
            
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task HandleGuardarPerfilUsuario()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
        guardando = true;

        try
        {
            var (exito, mensaje) = await UsuarioService.ActualizarPerfilPropioAsync(
                AuthService.UsuarioActual!.Id,
                formUsuario.Nombre,
                formUsuario.Apellidos,
                formUsuario.Email!,
                formUsuario.Telefono);

            if (exito)
            {
                mensajeExito = mensaje;
            }
            else
            {
                mensajeError = mensaje;
            }
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException or UnauthorizedAccessException)
        {
            Logger.LogError(ex, "No se pudo actualizar el perfil del usuario");
            mensajeError = "No se pudo actualizar el perfil. Inténtalo de nuevo.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task HandleGuardarPerfil()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
        guardando = true;

        try
        {
            if (!AuthService.EsSuperAdmin || !perfilCargado)
            {
                mensajeError = "Solo superadmin puede editar su perfil global.";
                return;
            }
            var (exito, mensaje) = await PerfilService.GuardarAsync(model);

            if (exito)
            {
                mensajeExito = mensaje;
            }
            else
            {
                mensajeError = mensaje;
            }
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            Logger.LogError(ex, "No se pudo actualizar el perfil global de superadmin");
            mensajeError = "No se pudo actualizar el perfil global. Inténtalo de nuevo.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/", false);
    }

}
