@page "/noticias"
@page "/mensajes-bienvenida"
@layout Layout.MainLayout
@implements IDisposable
@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@using Microsoft.AspNetCore.Components.Forms
@inject AuthService AuthService
@inject MensajeBienvenidaService MensajeBienvenidaService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject EmpresaContext EmpresaContext
@rendermode InteractiveServer

<PageTitle>Noticias - Voltia Solutions</PageTitle>

@if (cargandoSesion)
{
    <div class="text-center mt-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (!AuthService.EstaAutenticado)
{
    <div class="text-center mt-5">
        <p>Redirigiendo al login</p>
    </div>
}
else if (!AuthService.EsAdminOBackoffice)
{
    <div class="container mt-5">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Acceso Denegado</h4>
            <p>No tienes permisos para acceder a esta sección. Solo los administradores y personal de backoffice pueden gestionar las noticias.</p>
            <hr>
            <a href="/" class="btn btn-primary">Volver al Inicio</a>
        </div>
    </div>
}
else
{
    <div class="container-fluid mt-4">
        <div class="row mb-4">
            <div class="col">
                <h2 class="fw-bold">
                    <i class="bi bi-megaphone me-2"></i>Noticias
                </h2>
                <p class="text-muted">Gestiona las noticias que se muestran a los usuarios al iniciar la aplicación</p>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="NuevoMensaje">
                    <i class="bi bi-plus-circle me-2"></i>Nuevo Mensaje
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@mensajeExito
                <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
                <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
            </div>
        }

        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (mensajes == null || !mensajes.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox display-1 text-muted"></i>
                            <p class="text-muted mt-3">No hay noticias configuradas</p>
                            <button class="btn btn-primary" @onclick="NuevoMensaje">
                                <i class="bi bi-plus-circle me-2"></i>Crear Primera Noticia
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Título</th>
                                        <th>Fecha Inicio</th>
                                        <th>Fecha Fin</th>
                                        <th>Prioridad</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mensaje in mensajes)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@mensaje.Titulo</strong>
                                                @if (mensaje.Imagenes != null && mensaje.Imagenes.Any())
                                                {
                                                    <i class="bi bi-images ms-2 text-muted" title="@mensaje.Imagenes.Count imagen(es)"></i>
                                                }
                                            </td>
                                            <td>@mensaje.FechaInicio.ToString("dd/MM/yyyy")</td>
                                            <td>@(mensaje.FechaFin?.ToString("dd/MM/yyyy") ?? "Sin límite")</td>
                                            <td>
                                                <span class="badge bg-secondary">@mensaje.Prioridad</span>
                                            </td>
                                            <td>
                                                @if (mensaje.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactivo</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <button class="btn btn-outline-primary" @onclick="() => EditarMensaje(mensaje.Id)" title="Editar">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-outline-warning" @onclick="() => CambiarEstado(mensaje.Id, !mensaje.Activo)" title="@(mensaje.Activo ? "Desactivar" : "Activar")">
                                                        <i class="bi bi-@(mensaje.Activo ? "toggle-on" : "toggle-off")"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger" @onclick="() => ConfirmarEliminar(mensaje.Id)" title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @* Modal para crear/editar mensaje *@
    @if (mostrarModal && mensajeEditando != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            @if (mensajeEditando.Id == 0)
                            {
                                <text>Nueva Noticia</text>
                            }
                            else
                            {
                                <text>Editar Noticia</text>
                            }
                        </h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>
                    <EditForm Model="@mensajeEditando" OnValidSubmit="GuardarMensaje">
                        <DataAnnotationsValidator />
                        <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                            @if (!string.IsNullOrEmpty(mensajeErrorModal))
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="bi bi-exclamation-triangle me-2"></i>@mensajeErrorModal
                                    <button type="button" class="btn-close" @onclick="() => mensajeErrorModal = string.Empty"></button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(mensajeExitoModal))
                            {
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="bi bi-check-circle me-2"></i>@mensajeExitoModal
                                    <button type="button" class="btn-close" @onclick="() => mensajeExitoModal = string.Empty"></button>
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label">Título *</label>
                                <InputText class="form-control" @bind-Value="mensajeEditando.Titulo" />
                                <ValidationMessage For="@(() => mensajeEditando.Titulo)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Contenido (opcional)</label>
                                <InputTextArea class="form-control" rows="6" @bind-Value="mensajeEditando.Contenido" />
                                <small class="text-muted">Usa saltos de línea para separar párrafos</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Imágenes</label>
                                <div class="input-group">
                                    <label class="form-control" style="cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        <InputFile id="imagenesInput" OnChange="CargarImagenes" accept="image/*" multiple style="display: none;" />
                                        @if (archivosImagenes.Count == 0)
                                        {
                                            <span class="text-muted">Ningún archivo seleccionado</span>
                                        }
                                        else
                                        {
                                            <span>@archivosImagenes.Count imagen(es) seleccionada(s)</span>
                                        }
                                    </label>
                                    <label for="imagenesInput" class="btn btn-outline-secondary" style="cursor: pointer;">
                                        <i class="bi bi-upload me-1"></i>Seleccionar imágenes
                                    </label>
                                </div>
                                
                                @* Mostrar imágenes existentes *@
                                @if (mensajeEditando.Imagenes != null && mensajeEditando.Imagenes.Any())
                                {
                                    <div class="mt-3">
                                        <h6>Imágenes actuales:</h6>
                                        <div class="row g-2">
                                            @foreach (var imagen in mensajeEditando.Imagenes.OrderBy(i => i.Orden))
                                            {
                                                <div class="col-md-4">
                                                    <div class="border rounded p-2 bg-light text-center position-relative">
                                                        <img src="@imagen.ImagenUrl" alt="Imagen" class="img-fluid rounded" style="max-height: 150px;" />
                                                        <div class="mt-2">
                                                            <small class="text-muted">Orden: @imagen.Orden</small>
                                                        </div>
                                                        <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="() => EliminarImagenExistente(imagen.Id)">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                
                                @* Mostrar preview de nuevas imágenes *@
                                @if (archivosImagenes.Count > 0)
                                {
                                    <div class="mt-3">
                                        <h6>Nuevas imágenes a agregar:</h6>
                                        <div class="row g-2">
                                            @for (int i = 0; i < archivosImagenes.Count; i++)
                                            {
                                                var index = i;
                                                <div class="col-md-4">
                                                    <div class="border rounded p-2 bg-light text-center">
                                                        <div class="text-truncate">
                                                            <i class="bi bi-file-image"></i> @archivosImagenes[index].Name
                                                        </div>
                                                        <div class="mt-2">
                                                            <small class="text-muted">Tamaño: @(archivosImagenes[index].Size / 1024 / 1024 > 0 ? $"{archivosImagenes[index].Size / 1024 / 1024:F2} MB" : $"{archivosImagenes[index].Size / 1024:F2} KB")</small>
                                                        </div>
                                                        <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="() => EliminarImagenNueva(index)">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                
                                <small class="text-muted d-block mt-2">Formatos permitidos: JPG, PNG, GIF. Tamaño máximo por imagen: 50MB</small>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Fecha de Inicio *</label>
                                    <InputDate class="form-control" @bind-Value="mensajeEditando.FechaInicio" />
                                    <ValidationMessage For="@(() =>  mensajeEditando.FechaInicio)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Fecha de Fin</label>
                                    <InputDate class="form-control" @bind-Value="mensajeEditando.FechaFin" />
                                    <small class="text-muted">Dejar vacío para sin límite</small>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Prioridad</label>
                                    <InputNumber class="form-control" @bind-Value="mensajeEditando.Prioridad" />
                                    <small class="text-muted">Mayor número = mayor prioridad</small>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check mt-4">
                                        <InputCheckbox class="form-check-input" @bind-Value="mensajeEditando.Activo" id="chkActivo" />
                                        <label class="form-check-label" for="chkActivo">
                                            Mensaje activo
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-2"></i>Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    @* Modal de confirmación de eliminación *@
    @if (mostrarModalEliminar)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Confirmar Eliminación</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEliminar"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Estás seguro de que deseas eliminar esta noticia?</p>
                        <p class="text-danger mb-0">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">Cancelar</button>
                        <button type="button" class="btn btn-danger" @onclick="EliminarMensaje">
                            <i class="bi bi-trash me-2"></i>Eliminar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private sealed record ImagenPendiente(string Name, long Size, string RutaTemporal);

    private bool cargandoSesion = true;
    private bool cargando = true;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;
    private string mensajeExitoModal = string.Empty;
    private string mensajeErrorModal = string.Empty;
    private List<MensajeBienvenida> mensajes = new();
    private MensajeBienvenida mensajeEditando = new();
    private bool mostrarModal = false;
    private bool mostrarModalEliminar = false;
    private int mensajeEliminarId = 0;
    private List<ImagenPendiente> archivosImagenes = new();
    private List<int> imagenesAEliminar = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.CargarSesionAsync();
            
            if (!AuthService.EstaAutenticado)
            {
                Navigation.NavigateTo("/login", false);
                return;
            }
            
            if (!AuthService.EsAdminOBackoffice)
            {
                cargandoSesion = false;
                StateHasChanged();
                return;
            }
            
            cargandoSesion = false;
            await CargarMensajes();
            StateHasChanged();
        }
    }

    private async Task CargarMensajes()
    {
        try
        {
            cargando = true;
            mensajes = await MensajeBienvenidaService.ObtenerTodosLosAsAsync();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar los mensajes: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoMensaje()
    {
        mensajeEditando = new MensajeBienvenida
        {
            FechaInicio = DateTime.Now,
            Activo = true,
            Prioridad = 0,
            UsuarioCreacionId = AuthService.UsuarioActual?.Id,
            Imagenes = new List<NoticiaImagen>()
        };
        LimpiarImagenesTemporales();
        imagenesAEliminar.Clear();
        mostrarModal = true;
    }

    private async Task EditarMensaje(int id)
    {
        try
        {
            var mensaje = await MensajeBienvenidaService.ObtenerMensajePorIdAsync(id);
            if (mensaje != null)
            {
                mensajeEditando = mensaje;
                if (mensajeEditando.Imagenes == null)
                {
                    mensajeEditando.Imagenes = new List<NoticiaImagen>();
                }
                LimpiarImagenesTemporales();
                imagenesAEliminar.Clear();
                mostrarModal = true;
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar el mensaje:  {ex.Message}";
        }
    }

    private async Task CargarImagenes(InputFileChangeEventArgs e)
    {
        try
        {
            mensajeError = string.Empty;
            var archivosNuevos = e.GetMultipleFiles(10); // Máximo 10 imágenes a la vez
            var imagenesAgregadas = 0;
            
            // Process files immediately in the event handler to preserve Blazor context
            var directorioTemporal = Path.Combine(EmpresaContext.RutaStorage(Configuration), "temp", "noticias");
            Directory.CreateDirectory(directorioTemporal);
            
            foreach (var archivo in archivosNuevos)
            {
                // Validar tamaño (50MB máximo)
                if (archivo.Size > 50 * 1024 * 1024)
                {
                    mensajeError = $"La imagen {archivo.Name} no puede superar los 50MB";
                    continue;
                }

                // Validar tipo de archivo
                var tiposPermitidos = new[] { "image/jpeg", "image/jpg", "image/png", "image/gif" };
                if (!tiposPermitidos.Contains(archivo.ContentType))
                {
                    mensajeError = $"El archivo {archivo.Name} no es una imagen válida (JPG, PNG o GIF)";
                    continue;
                }

                var rutaTemporal = Path.Combine(directorioTemporal, $"{Guid.NewGuid():N}.tmp");
                try
                {
                    // Read the file immediately while the Blazor context is still valid
                    await using (var origen = archivo.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024))
                    {
                        await using var destino = new FileStream(rutaTemporal, FileMode.CreateNew, FileAccess.Write, FileShare.None, 81920, useAsync: true);
                        await origen.CopyToAsync(destino);
                    }
                    
                    archivosImagenes.Add(new ImagenPendiente(archivo.Name, archivo.Size, rutaTemporal));
                    imagenesAgregadas++;
                }
                catch (Exception exArchivo)
                {
                    EliminarArchivoTemporal(rutaTemporal);
                    mensajeError = $"Error al cargar la imagen {archivo.Name}: {exArchivo.Message}";
                }
            }

            if (imagenesAgregadas > 0 && string.IsNullOrEmpty(mensajeError))
            {
                mensajeExito = $"{imagenesAgregadas} imagen(es) agregada(s)";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar las imágenes: {ex.Message}";
        }
    }

    private void EliminarImagenNueva(int index)
    {
        if (index >= 0 && index < archivosImagenes.Count)
        {
            EliminarArchivoTemporal(archivosImagenes[index].RutaTemporal);
            archivosImagenes.RemoveAt(index);
        }
    }

    private void EliminarImagenExistente(int imagenId)
    {
        imagenesAEliminar.Add(imagenId);
        
        // Remover de la lista visual
        if (mensajeEditando.Imagenes != null)
        {
            var imagen = mensajeEditando.Imagenes.FirstOrDefault(i => i.Id == imagenId);
            if (imagen != null)
            {
                mensajeEditando.Imagenes.Remove(imagen);
            }
        }
    }

    private async Task GuardarMensaje()
    {
        try
        {
            // Limpiar mensajes anteriores
            mensajeErrorModal = string.Empty;
            mensajeExitoModal = string.Empty;

            bool exito;
            bool esNuevo = mensajeEditando.Id == 0;
            
            // Primero guardar o actualizar el mensaje
            if (esNuevo)
            {
                var resultado = await MensajeBienvenidaService.CrearMensajeAsync(mensajeEditando);
                
                if (resultado.id == 0)
                {
                    mensajeErrorModal = $"Error al crear el mensaje: {resultado.error ?? "Error desconocido"}";
                    return;
                }
                
                mensajeEditando.Id = resultado.id;
            }
            else
            {
                exito = await MensajeBienvenidaService.ActualizarMensajeAsync(mensajeEditando);
                if (!exito)
                {
                    mensajeErrorModal = "Error al actualizar el mensaje";
                    return;
                }
            }

            // Eliminar imágenes marcadas para eliminar
            if (imagenesAEliminar.Any())
            {
                foreach (var imagenId in imagenesAEliminar)
                {
                    await MensajeBienvenidaService.EliminarImagenAsync(imagenId);
                }
            }

            // Guardar nuevas imágenes
            if (archivosImagenes.Any())
            {
                // Limpiar mensajes anteriores
                mensajeErrorModal = string.Empty;
                
                // Obtener las imágenes actuales del mensaje para calcular el orden correcto
                var imagenesActuales = await MensajeBienvenidaService.ObtenerImagenesNoticiaAsync(mensajeEditando.Id);
                var siguienteOrden = imagenesActuales?.Count ?? 0;

                foreach (var archivo in archivosImagenes.ToList())
                {
                    string? rutaFinal = null;
                    try
                    {
                        var imagenGuardada = await GuardarImagenAsync(archivo);
                        rutaFinal = imagenGuardada.RutaCompleta;
                        if (string.IsNullOrEmpty(imagenGuardada.Url))
                        {
                            mensajeErrorModal = $"Error al guardar la imagen: {archivo.Name}";
                            continue;
                        }

                        var nuevaImagen = new NoticiaImagen
                        {
                            MensajeId = mensajeEditando.Id,
                            ImagenUrl = imagenGuardada.Url,
                            Orden = siguienteOrden,
                            FechaCreacion = DateTime.Now
                        };

                        if (!await MensajeBienvenidaService.AgregarImagenAsync(nuevaImagen))
                        {
                            mensajeErrorModal = $"Error al guardar la imagen: {archivo.Name}";
                            EliminarArchivoTemporal(rutaFinal);
                            continue;
                        }

                        siguienteOrden++;
                        archivosImagenes.Remove(archivo);
                        EliminarArchivoTemporal(archivo.RutaTemporal);
                    }
                    catch (Exception exImg)
                    {
                        if (!string.IsNullOrEmpty(rutaFinal))
                            EliminarArchivoTemporal(rutaFinal);
                        mensajeErrorModal = $"Error al procesar la imagen {archivo.Name}: {exImg.Message}";
                    }
                }
            }

            // Si llegamos aquí sin errores, cerramos el modal y mostramos éxito
            if (string.IsNullOrEmpty(mensajeErrorModal))
            {
                mensajeExito = esNuevo ? "Noticia creada correctamente" : "Noticia actualizada correctamente";
                CerrarModal();
                await CargarMensajes();
            }
        }
        catch (Exception ex)
        {
            mensajeErrorModal = $"Error inesperado: {ex.Message}";
            if (ex.InnerException != null)
            {
                mensajeErrorModal += $" | Detalle: {ex.InnerException.Message}";
            }
        }
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        mensajeEditando = new();
        LimpiarImagenesTemporales();
        imagenesAEliminar.Clear();
        mensajeErrorModal = string.Empty;
        mensajeExitoModal = string.Empty;
    }

    private async Task<(string Url, string RutaCompleta)> GuardarImagenAsync(ImagenPendiente archivo)
    {
        var storagePath = EmpresaContext.RutaStorage(Configuration);
        
        // Crear directorio si no existe
        var uploadsPath = Path.Combine(storagePath, "uploads", "mensajes");
        if (!Directory.Exists(uploadsPath))
        {
            Directory.CreateDirectory(uploadsPath);
        }

        // Generar nombre único para el archivo
        var extension = Path.GetExtension(archivo.Name);
        var nombreArchivo = $"{Guid.NewGuid()}{extension}";
        var rutaCompleta = Path.Combine(uploadsPath, nombreArchivo);

        try
        {
            await using var origen = new FileStream(archivo.RutaTemporal, FileMode.Open, FileAccess.Read, FileShare.Read, 81920, useAsync: true);
            await using var destino = new FileStream(rutaCompleta, FileMode.CreateNew, FileAccess.Write, FileShare.None, 81920, useAsync: true);
            await origen.CopyToAsync(destino);
        }
        catch
        {
            EliminarArchivoTemporal(rutaCompleta);
            throw;
        }

        // Retornar la ruta para acceso web
        return (EmpresaContext.UrlStorage(Configuration, $"uploads/mensajes/{nombreArchivo}"), rutaCompleta);
    }

    private void LimpiarImagenesTemporales()
    {
        foreach (var archivo in archivosImagenes)
            EliminarArchivoTemporal(archivo.RutaTemporal);
        archivosImagenes.Clear();
    }

    private static void EliminarArchivoTemporal(string ruta)
    {
        try
        {
            if (File.Exists(ruta)) File.Delete(ruta);
        }
        catch { }
    }

    public void Dispose() => LimpiarImagenesTemporales();

    private async Task CambiarEstado(int id, bool nuevoEstado)
    {
        try
        {
            var exito = await MensajeBienvenidaService.CambiarEstadoMensajeAsync(id, nuevoEstado);
            if (exito)
            {
                mensajeExito = nuevoEstado ? "Mensaje activado" : "Mensaje desactivado";
                await CargarMensajes();
            }
            else
            {
                mensajeError = "Error al cambiar el estado del mensaje";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
    }

    private void ConfirmarEliminar(int id)
    {
        mensajeEliminarId = id;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        mensajeEliminarId = 0;
    }

    private async Task EliminarMensaje()
    {
        try
        {
            var exito = await MensajeBienvenidaService.EliminarMensajeAsync(mensajeEliminarId);
            if (exito)
            {
                mensajeExito = "Mensaje eliminado correctamente";
                await CargarMensajes();
            }
            else
            {
                mensajeError = "Error al eliminar el mensaje";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            CerrarModalEliminar();
        }
    }
}
