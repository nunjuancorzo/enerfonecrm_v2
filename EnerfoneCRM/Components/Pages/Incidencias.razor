    private async Task CargarComentarios()
    {
        if (incidenciaSeleccionada == null) return;

        try
        {
            comentariosIncidencia = null; // Mostrar loading
            StateHasChanged();

            using var context = DbContextProvider.CreateDbContext();
            comentariosIncidencia = await context.ComentariosIncidencias
                .Where(c => c.IncidenciaId == incidenciaSeleccionada.Id)
                .OrderBy(c => c.FechaCreacion)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[INCIDENCIAS] Error al cargar comentarios: {ex.Message}");
            comentariosIncidencia = new List<ComentarioIncidencia>();
        }
    }

    private async Task AgregarComentario()
    {
        if (incidenciaSeleccionada == null) return;
        if (string.IsNullOrWhiteSpace(nuevoComentario)) return;
        if (AuthService.UsuarioActual == null) return;

        try
        {
            guardandoComentario = true;
            mensajeError = string.Empty;

            using var context = DbContextProvider.CreateDbContext();

            // Crear el comentario
            var nombreUsuario = !string.IsNullOrWhiteSpace(AuthService.UsuarioActual.Nombre) 
                ? $"{AuthService.UsuarioActual.Nombre} {AuthService.UsuarioActual.Apellidos}".Trim()
                : AuthService.UsuarioActual.NombreUsuario;

            var comentario = new ComentarioIncidencia
            {
                IncidenciaId = incidenciaSeleccionada.Id,
                UsuarioId = AuthService.UsuarioActual.Id,
                NombreUsuario = nombreUsuario,
                Comentario = nuevoComentario.Trim(),
                FechaCreacion = DateTime.Now,
                EmailEnviado = enviarEmailConComentario
            };

            context.ComentariosIncidencias.Add(comentario);
            await context.SaveChangesAsync();

            // Enviar email si está marcado
            if (enviarEmailConComentario && !string.IsNullOrEmpty(incidenciaSeleccionada.EmailUsuario))
            {
                await EnviarEmailComentario(incidenciaSeleccionada, comentario);
            }

            // Limpiar y recargar
            nuevoComentario = string.Empty;
            enviarEmailConComentario = false;
            await CargarComentarios();

            mensajeExito = enviarEmailConComentario 
                ? "Comentario agregado y email enviado correctamente" 
                : "Comentario agregado correctamente";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al agregar comentario: {ex.Message}";
            Console.WriteLine($"[INCIDENCIAS] Error al agregar comentario: {ex.Message}");
        }
        finally
        {
            guardandoComentario = false;
        }
    }

    private async Task EnviarEmailComentario(Incidencia incidencia, ComentarioIncidencia comentario)
    {
        try
        {
            var asunto = $"Nuevo comentario en tu incidencia - {incidencia.Asunto}";
            var cuerpo = GenerarEmailComentario(incidencia, comentario);

            var (exito, mensaje) = await EmailService.EnviarEmailSimpleAsync(
                incidencia.EmailUsuario,
                asunto,
                cuerpo
            );

            if (!exito)
            {
                Console.WriteLine($"[INCIDENCIAS] Error al enviar email de comentario: {mensaje}");
            }
            else
            {
                Console.WriteLine($"[INCIDENCIAS] Email de comentario enviado a {incidencia.EmailUsuario}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[INCIDENCIAS] Error al enviar email: {ex.Message}");
        }
    }

