@page "/incidencias"
@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@using EnerfoneCRM.Data
@using Microsoft.EntityFrameworkCore
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject DbContextProvider DbContextProvider
@inject EmailService EmailService
@inject IncidenciaImagenService IncidenciaImagenService
@inject RevolappsIncidenciasService RevolappsIncidenciasService
@rendermode InteractiveServer

<PageTitle>Gestión de Incidencias - EnerfoneCRM</PageTitle>

@if (!AuthService.EstaAutenticado)
{
    <div class="text-center mt-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p>Verificando sesión...</p>
    </div>
}
else
{
    <div class="container-fluid mt-4">
        <div class="row mb-4">
            <div class="col">
                <h2>
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                    Gestión de Incidencias
                </h2>
                <p class="text-muted">
                    @if (AuthService.EsAdministrador)
                    {
                        <span>Visualiza y gestiona todas las incidencias del sistema</span>
                    }
                    else
                    {
                        <span>Visualiza tus incidencias reportadas</span>
                    }
                </p>
            </div>
            <div class="col-auto">
                <button class="btn btn-danger" @onclick='() => NavigationManager.NavigateTo("/enviar-incidencia")'>
                    <i class="bi bi-plus-circle me-2"></i>Nueva Incidencia
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@mensajeExito
                <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@mensajeError
                <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
            </div>
        }

        <!-- Filtros -->
        <div class="card mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Estado</label>
                        <label class="form-label">Estado</label>
                        <select class="form-select" value="@filtroEstado" @onchange="e => FiltrarPorEstado(e.Value?.ToString())">
                            <option value="SinResolver">Sin resolver (por defecto)</option>
                            <option value="">Todos</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Pendiente subir PRO">Pendiente subir PRO</option>
                            <option value="En validación">En validación</option>
                            <option value="En Proceso">En Proceso</option>
                            <option value="Resuelta">Resuelta</option>
                            <option value="Cerrada">Cerrada</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Prioridad</label>
                        <select class="form-select" @onchange="e => FiltrarPorPrioridad(e.Value?.ToString())">
                            <option value="">Todas</option>
                            <option value="Crítica">Crítica</option>
                            <option value="Alta">Alta</option>
                            <option value="Media">Media</option>
                            <option value="Baja">Baja</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Buscar</label>
                        <input type="text" class="form-control" placeholder="Buscar por asunto o descripción..." 
                               @oninput="e => BuscarTexto(e.Value?.ToString())" />
                    </div>
                </div>
            </div>
        </div>

        @if (cargando)
        {
            <div class="text-center">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else if (!incidenciasFiltradas.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>No se encontraron incidencias
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Usuario</th>
                            <th>Asunto</th>
                            <th>Tipo</th>
                            <th>Prioridad</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var incidencia in incidenciasFiltradas)
                        {
                            <tr class="fila-ficha" @ondblclick="() => MostrarDetalle(incidencia)">
                                <td>@incidencia.Id</td>
                                <td>@incidencia.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div>@incidencia.NombreUsuario</div>
                                    <small class="text-muted">@incidencia.EmailUsuario</small>
                                </td>
                                <td>
                                    <strong>@incidencia.Asunto</strong>
                                    @if (incidencia.TieneImagen)
                                    {
                                        <i class="bi bi-image text-info ms-1" title="Con imagen adjunta"></i>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@incidencia.TipoIncidencia</span></td>
                                <td>
                                    <span class="badge @ObtenerClasePrioridad(incidencia.Prioridad)">
                                        @incidencia.Prioridad
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @ObtenerClaseEstado(incidencia.Estado)">
                                        @incidencia.Estado
                                    </span>
                                </td>
                                <td class="text-nowrap" @ondblclick:stopPropagation="true">
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-warning" @onclick="() => MostrarDetalle(incidencia)"
                                                title="Editar incidencia" aria-label="@($"Editar incidencia #{incidencia.Id}")">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Modal de Detalle -->
        @if (incidenciaSeleccionada != null && mostrarModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Detalle de Incidencia #@incidenciaSeleccionada.Id
                            </h5>
                            <button type="button" class="btn-close" @onclick="CerrarModal" disabled="@(guardando || cargandoImagen)"></button>
                        </div>
                        <div class="modal-body" data-imagen-incidencia>
                            @if (!string.IsNullOrEmpty(mensajeError))
                            {
                                <div class="alert alert-danger" role="alert">@mensajeError</div>
                            }
                            @if (!string.IsNullOrEmpty(mensajeExito))
                            {
                                <div class="alert alert-success" role="status">@mensajeExito</div>
                            }
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Usuario:</strong> @incidenciaSeleccionada.NombreUsuario
                                </div>
                                <div class="col-md-6">
                                    <strong>Email:</strong> @incidenciaSeleccionada.EmailUsuario
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <strong>Fecha creación:</strong> @incidenciaSeleccionada.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                </div>
                                <div class="col-md-6">
                                    @if (incidenciaSeleccionada.FechaActualizacion.HasValue)
                                    {
                                        <strong>Última actualización:</strong> @incidenciaSeleccionada.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                </div>
                            </div>
                            <div class="mb-3">
                                <strong>Asunto:</strong>
                                <p>@incidenciaSeleccionada.Asunto</p>
                            </div>
                            <div class="row mb-3">
                                @if (AuthService.PuedeGestionarIncidencias && incidenciaEdicion != null)
                                {
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold" for="tipo-incidencia-detalle">Tipo</label>
                                        <select id="tipo-incidencia-detalle" class="form-select" @bind="incidenciaEdicion.TipoIncidencia" disabled="@guardando">
                                            @foreach (var tipo in tiposIncidencia) { <option value="@tipo">@tipo</option> }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold" for="prioridad-incidencia-detalle">Prioridad</label>
                                        <select id="prioridad-incidencia-detalle" class="form-select" @bind="incidenciaEdicion.Prioridad" disabled="@guardando">
                                            @foreach (var prioridad in prioridadesIncidencia) { <option value="@prioridad">@prioridad</option> }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold" for="estado-incidencia-detalle">Estado</label>
                                        <select id="estado-incidencia-detalle" class="form-select" @bind="incidenciaEdicion.Estado" disabled="@guardando">
                                            @foreach (var estado in estadosIncidencia) { <option value="@estado">@estado</option> }
                                        </select>
                                    </div>
                                }
                                else
                                {
                                <div class="col-md-4">
                                    <strong>Tipo:</strong> <span class="badge bg-secondary">@incidenciaSeleccionada.TipoIncidencia</span>
                                </div>
                                <div class="col-md-4">
                                    <strong>Prioridad:</strong> 
                                    <span class="badge @ObtenerClasePrioridad(incidenciaSeleccionada.Prioridad)">
                                        @incidenciaSeleccionada.Prioridad
                                    </span>
                                </div>
                                <div class="col-md-4">
                                    <strong>Estado:</strong> 
                                    <span class="badge @ObtenerClaseEstado(incidenciaSeleccionada.Estado)">
                                        @incidenciaSeleccionada.Estado
                                    </span>
                                </div>
                                }
                            </div>
                            <div class="mb-3">
                                <strong>Descripción:</strong>
                                <div class="border p-3 bg-light rounded">
                                    @incidenciaSeleccionada.Descripcion
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(incidenciaSeleccionada.ObservacionesAdmin))
                            {
                                <div class="mb-3">
                                    <strong>Observaciones del Administrador:</strong>
                                    <div class="border p-3 bg-warning bg-opacity-10 rounded">
                                        @incidenciaSeleccionada.ObservacionesAdmin
                                    </div>
                                </div>
                            }

                            <!-- Sección de Comentarios -->
                            <div class="mb-3">
                                <hr class="my-4" />
                                <h6 class="mb-3">
                                    <i class="bi bi-chat-dots me-2"></i>Comentarios
                                    @if (comentariosIncidencia != null && comentariosIncidencia.Any())
                                    {
                                        <span class="badge bg-primary">@comentariosIncidencia.Count</span>
                                    }
                                </h6>

                                @if (comentariosIncidencia == null)
                                {
                                    <div class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm" role="status">
                                            <span class="visually-hidden">Cargando comentarios...</span>
                                        </div>
                                    </div>
                                }
                                else if (comentariosIncidencia.Any())
                                {
                                    <div class="comentarios-lista mb-3" style="max-height: 300px; overflow-y: auto;">
                                        @foreach (var comentario in comentariosIncidencia.OrderBy(c => c.FechaCreacion))
                                        {
                                            <div class="border rounded p-3 mb-2 @(comentario.EmailEnviado ? "bg-success bg-opacity-10" : "bg-light")">
                                                <div class="d-flex justify-content-between mb-2">
                                                    <strong class="text-primary">
                                                        <i class="bi bi-person-circle me-1"></i>@comentario.NombreUsuario
                                                    </strong>
                                                    <small class="text-muted">
                                                        @comentario.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                                        @if (comentario.EmailEnviado)
                                                        {
                                                            <i class="bi bi-envelope-check ms-2 text-success" title="Email enviado"></i>
                                                        }
                                                    </small>
                                                </div>
                                                <div class="text-dark mb-2">
                                                    @comentario.Comentario
                                                </div>
                                                @if (!comentario.EmailEnviado && (AuthService.EsAdministrador || AuthService.EsBackoffice) && !string.IsNullOrEmpty(incidenciaSeleccionada?.EmailUsuario))
                                                {
                                                    <div class="d-flex justify-content-end">
                                                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                                                @onclick="() => EnviarEmailComentarioExistente(comentario)"
                                                                disabled="@enviandoEmailComentarioId.Contains(comentario.Id)">
                                                            @if (enviandoEmailComentarioId.Contains(comentario.Id))
                                                            {
                                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-envelope me-1"></i>
                                                            }
                                                            Enviar por email
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info mb-3">
                                        <i class="bi bi-info-circle me-2"></i>No hay comentarios aún
                                    </div>
                                }

                                @if (AuthService.EsAdministrador || AuthService.EsBackoffice)
                                {
                                    <div class="border rounded p-3 bg-light">
                                        <label class="form-label fw-bold">
                                            <i class="bi bi-plus-circle me-1"></i>Agregar comentario
                                        </label>
                                        <textarea class="form-control mb-2" rows="3" @bind="nuevoComentario" 
                                                  placeholder="Escribe un comentario para el usuario..."></textarea>
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" id="enviarEmailComentario" @bind="enviarEmailConComentario">
                                            <label class="form-check-label" for="enviarEmailComentario">
                                                <i class="bi bi-envelope me-1"></i>Enviar notificación por email al usuario
                                            </label>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="AgregarComentario" 
                                                disabled="@(string.IsNullOrWhiteSpace(nuevoComentario) || guardandoComentario)">
                                            @if (guardandoComentario)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            <i class="bi bi-send me-1"></i>Agregar comentario
                                        </button>
                                    </div>
                                }
                            </div>

                            @if (AuthService.PuedeGestionarIncidencias)
                            {
                                <SelectorImagenIncidencia @key="versionImagen" OnCambio="ImagenSeleccionada" OnCargaCambio="@(cargando => cargandoImagen = cargando)" Disabled="@guardando" />
                            }

                            @if (incidenciaSeleccionada is { TieneImagen: true } incidenciaConImagen && !string.IsNullOrEmpty(incidenciaConImagen.NombreImagen))
                            {
                                <div class="mb-3">
                                    <strong>Imagen adjunta:</strong>
                                    <div class="mt-2">
                                        <img src="/storage/incidencias/@incidenciaConImagen.NombreImagen"
                                             alt="Imagen de incidencia" 
                                             class="img-fluid rounded border cursor-pointer"
                                             style="max-height: 300px; cursor: pointer;"
                                             @onclick="() => AbrirImagenCompleta(incidenciaConImagen.NombreImagen)"
                                             title="Click para ampliar" />
                                        <div class="text-muted small mt-1">
                                            <i class="bi bi-info-circle me-1"></i>Click en la imagen para ampliar
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            @if (AuthService.PuedeGestionarIncidencias)
                            {
                                <button type="button" class="btn btn-primary" @onclick="GuardarCambios" disabled="@(guardando || cargandoImagen)">
                                    <i class="bi bi-save me-2"></i>Guardar cambios
                                </button>
                            }
                            <button type="button" class="btn btn-outline-primary" @onclick="EnviarIncidenciaARevolapps" disabled="@(enviandoARevolapps || guardando)">
                                @if (enviandoARevolapps)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Enviando...</span>
                                }
                                else
                                {
                                    <i class="bi bi-box-arrow-up-right me-2"></i>
                                    <span>Enviar a Incidencias</span>
                                }
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal" disabled="@(guardando || cargandoImagen)">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Modal para ampliar imagen -->
        @if (mostrarImagenCompleta && !string.IsNullOrEmpty(imagenAmpliadaNombre))
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.9);" @onclick="CerrarImagenCompleta">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content bg-transparent border-0">
                        <div class="modal-header border-0 pb-0">
                            <button type="button" class="btn-close btn-close-white" @onclick="CerrarImagenCompleta"></button>
                        </div>
                        <div class="modal-body text-center">
                            <img src="/storage/incidencias/@imagenAmpliadaNombre" 
                                 alt="Imagen ampliada" 
                                 class="img-fluid rounded"
                                 style="max-height: 85vh;" />
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Modal de Edición (solo administrador) -->
        @if (incidenciaEdicion != null && mostrarModalEdicion && AuthService.PuedeGestionarIncidencias)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="bi bi-pencil me-2"></i>
                                Editar Incidencia #@incidenciaEdicion.Id
                            </h5>
                            <button type="button" class="btn-close" @onclick="CerrarModalEdicion"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Tipo</label>
                                    <select class="form-select" @bind="incidenciaEdicion.TipoIncidencia" disabled="@guardando">
                                        @foreach (var tipo in tiposIncidencia) { <option value="@tipo">@tipo</option> }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Prioridad</label>
                                    <select class="form-select" @bind="incidenciaEdicion.Prioridad" disabled="@guardando">
                                        @foreach (var prioridad in prioridadesIncidencia) { <option value="@prioridad">@prioridad</option> }
                                    </select>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Estado</label>
                                <select class="form-select" @bind="incidenciaEdicion.Estado">
                                    <option value="Pendiente">Pendiente</option>
                                    <option value="Pendiente subir PRO">Pendiente subir PRO</option>
                                    <option value="En validación">En validación</option>
                                    <option value="En Proceso">En Proceso</option>
                                    <option value="Resuelta">Resuelta</option>
                                    <option value="Cerrada">Cerrada</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Observaciones del Administrador</label>
                                <textarea class="form-control" rows="5" @bind="incidenciaEdicion.ObservacionesAdmin" 
                                          placeholder="Añade observaciones o comentarios sobre la incidencia..."></textarea>
                            </div>
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>
                                <strong>Usuario:</strong> @incidenciaEdicion.NombreUsuario<br />
                                <strong>Asunto:</strong> @incidenciaEdicion.Asunto
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModalEdicion">Cancelar</button>
                            <button type="button" class="btn btn-primary" @onclick="GuardarCambios" disabled="@guardando">
                                @if (guardando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                <i class="bi bi-save me-2"></i>Guardar Cambios
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private static readonly IReadOnlyList<string> tiposIncidencia = Incidencia.TiposPermitidos;
    private static readonly IReadOnlyList<string> prioridadesIncidencia = Incidencia.PrioridadesPermitidas;
    private static readonly IReadOnlyList<string> estadosIncidencia = Incidencia.EstadosPermitidos;
    private List<Incidencia> incidencias = new();
    private List<Incidencia> incidenciasFiltradas = new();
    private Incidencia? incidenciaSeleccionada = null;
    private Incidencia? incidenciaEdicion = null;
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool mostrarModalEdicion = false;
    private bool guardando = false;
    private ImagenIncidenciaAdjunta? imagenPendiente;
    private int versionImagen;
    private bool cargandoImagen;
    private bool enviandoARevolapps = false;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;
    private string filtroEstado = "SinResolver";
    private string filtroPrioridad = string.Empty;
    private string filtroBusqueda = string.Empty;
    private bool mostrarImagenCompleta = false;
    private string? imagenAmpliadaNombre = null;

    // Variables para comentarios
    private List<ComentarioIncidencia>? comentariosIncidencia = null;
    private string nuevoComentario = string.Empty;
    private bool enviarEmailConComentario = false;
    private bool guardandoComentario = false;
    private HashSet<int> enviandoEmailComentarioId = new HashSet<int>();

    protected override async Task OnInitializedAsync()
    {
        await CargarIncidencias();
    }

    private async Task CargarIncidencias()
    {
        try
        {
            cargando = true;
            using var context = DbContextProvider.CreateDbContext();

            if (AuthService.PuedeGestionarIncidencias)
            {
                // El administrador y backoffice con permisos ven todas las incidencias
                incidencias = await context.Incidencias
                    .OrderByDescending(i => i.FechaCreacion)
                    .ToListAsync();
            }
            else
            {
                // Otros usuarios solo ven sus propias incidencias
                incidencias = await context.Incidencias
                    .Where(i => i.UsuarioId == AuthService.UsuarioActual!.Id)
                    .OrderByDescending(i => i.FechaCreacion)
                    .ToListAsync();
            }

            AplicarFiltros();
        }
        catch (MySqlConnector.MySqlException mysqlEx) when (mysqlEx.Message.Contains("doesn't exist"))
        {
            mensajeError = "La tabla de incidencias no existe en la base de datos. Por favor, ejecuta el script SQL: EnerfoneCRM/Data/Incidencias.sql";
            Console.WriteLine($"[INCIDENCIAS] Error MySQL: {mysqlEx.Message}");
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar incidencias: {ex.Message}";
            Console.WriteLine($"[INCIDENCIAS] Error al cargar: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void AplicarFiltros()
    {
        incidenciasFiltradas = incidencias;

        if (!string.IsNullOrEmpty(filtroEstado))
        {
            if (filtroEstado == "SinResolver")
            {
                // Filtro especial: excluir las resueltas y cerradas
                incidenciasFiltradas = incidenciasFiltradas
                    .Where(i => i.Estado != "Resuelta" && i.Estado != "Cerrada")
                    .ToList();
            }
            else
            {
                incidenciasFiltradas = incidenciasFiltradas
                    .Where(i => i.Estado == filtroEstado)
                    .ToList();
            }
        }

        if (!string.IsNullOrEmpty(filtroPrioridad))
        {
            incidenciasFiltradas = incidenciasFiltradas
                .Where(i => i.Prioridad == filtroPrioridad)
                .ToList();
        }

        if (!string.IsNullOrEmpty(filtroBusqueda))
        {
            incidenciasFiltradas = incidenciasFiltradas
                .Where(i => i.Asunto.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ||
                           i.Descripcion.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void FiltrarPorEstado(string? estado)
    {
        filtroEstado = estado ?? string.Empty;
        AplicarFiltros();
    }

    private void FiltrarPorPrioridad(string? prioridad)
    {
        filtroPrioridad = prioridad ?? string.Empty;
        AplicarFiltros();
    }

    private void BuscarTexto(string? texto)
    {
        filtroBusqueda = texto ?? string.Empty;
        AplicarFiltros();
    }

