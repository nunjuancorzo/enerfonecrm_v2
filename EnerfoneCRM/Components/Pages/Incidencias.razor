    private async Task EnviarEmailComentarioExistente(ComentarioIncidencia comentario)
    {
        if (incidenciaSeleccionada == null) return;
        if (string.IsNullOrEmpty(incidenciaSeleccionada.EmailUsuario)) return;

        try
        {
            enviandoEmailComentarioId.Add(comentario.Id);
            StateHasChanged();
            mensajeError = string.Empty;

            // Enviar el email
            await EnviarEmailComentario(incidenciaSeleccionada, comentario);

            // Actualizar el estado en la base de datos
            using var context = DbContextProvider.CreateDbContext();
            var comentarioDb = await context.ComentariosIncidencias
                .FirstOrDefaultAsync(c => c.Id == comentario.Id);
            
            if (comentarioDb != null)
            {
                comentarioDb.EmailEnviado = true;
                await context.SaveChangesAsync();
            }

            // Recargar comentarios para reflejar el cambio
            await CargarComentarios();

            mensajeExito = "Email enviado correctamente";
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al enviar email: {ex.Message}";
            Console.WriteLine($"[INCIDENCIAS] Error al enviar email de comentario existente: {ex.Message}");
        }
        finally
        {
            enviandoEmailComentarioId.Remove(comentario.Id);
            StateHasChanged();
        }
    }
