    private void EditarIncidencia(Incidencia incidencia, bool abrirModal = true)
    {
        if (!AuthService.PuedeGestionarIncidencias) return;
        incidenciaEdicion = new Incidencia
        {
            Id = incidencia.Id,
            Asunto = incidencia.Asunto,
            TipoIncidencia = incidencia.TipoIncidencia,
            Prioridad = incidencia.Prioridad,
            Descripcion = incidencia.Descripcion,
            UsuarioId = incidencia.UsuarioId,
            NombreUsuario = incidencia.NombreUsuario,
            EmailUsuario = incidencia.EmailUsuario,
            Estado = incidencia.Estado,
            FechaCreacion = incidencia.FechaCreacion,
            FechaActualizacion = incidencia.FechaActualizacion,
            ObservacionesAdmin = incidencia.ObservacionesAdmin,
            TieneImagen = incidencia.TieneImagen,
            NombreImagen = incidencia.NombreImagen
        };
        mostrarModalEdicion = abrirModal;
    }

    private void CerrarModalEdicion()
    {
        mostrarModalEdicion = false;
        incidenciaEdicion = null;
    }

    private async Task GuardarCambios()
    {
        if (incidenciaEdicion == null || guardando || cargandoImagen || !AuthService.PuedeGestionarIncidencias) return;
        if (!tiposIncidencia.Contains(incidenciaEdicion.TipoIncidencia) || !prioridadesIncidencia.Contains(incidenciaEdicion.Prioridad) || !estadosIncidencia.Contains(incidenciaEdicion.Estado))
        {
            mensajeError = "Selecciona un tipo, una prioridad y un estado válidos.";
            return;
        }

        var edicion = incidenciaEdicion;
        var imagenNueva = imagenPendiente;
        string? nombreCreado = null;
        var guardadoEnBd = false;
        try
        {
            guardando = true;
            mensajeError = string.Empty;

            using var context = DbContextProvider.CreateDbContext();
            var incidenciaDb = await context.Incidencias.FindAsync(edicion.Id);
            
            if (incidenciaDb == null)
            {
                mensajeError = "Incidencia no encontrada";
                return;
            }

            var notificarResolucion = incidenciaDb.AplicarCambiosGestion(edicion);

            if (imagenNueva != null)
            {
                nombreCreado = await IncidenciaImagenService.GuardarAsync(imagenNueva);
                incidenciaDb.NombreImagen = nombreCreado;
                incidenciaDb.TieneImagen = true;
            }

            await context.SaveChangesAsync();
            guardadoEnBd = true;
            imagenPendiente = null;
            versionImagen++;

            // Enviar email si el estado cambió a "Resuelta"
            if (notificarResolucion && !string.IsNullOrEmpty(incidenciaDb.EmailUsuario))
            {
                await EnviarEmailIncidenciaResuelta(incidenciaDb);
            }

            mensajeExito = "Incidencia actualizada correctamente";
            var idDetalle = mostrarModal ? incidenciaSeleccionada?.Id : null;
            CerrarModalEdicion();
            await CargarIncidencias();
            if (idDetalle.HasValue)
            {
                incidenciaSeleccionada = incidencias.FirstOrDefault(incidencia => incidencia.Id == idDetalle.Value);
                if (incidenciaSeleccionada != null) EditarIncidencia(incidenciaSeleccionada, false);
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar cambios: {ex.Message}";
            Console.WriteLine($"[INCIDENCIAS] Error al guardar: {ex.Message}");
        }
        finally
        {
            guardando = false;
            if (!guardadoEnBd && nombreCreado != null)
            {
                try { IncidenciaImagenService.EliminarSinGuardar(nombreCreado); }
                catch (Exception excepcion) { Console.WriteLine($"[INCIDENCIAS] No se pudo limpiar el adjunto pendiente: {excepcion.Message}"); }
            }
        }
    }

    private async Task EnviarEmailIncidenciaResuelta(Incidencia incidencia)
    {
        try
