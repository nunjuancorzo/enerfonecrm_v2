@page "/tarifas-telefonia/edicion-masiva"
@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@using Microsoft.JSInterop
@rendermode InteractiveServer
@inject TarifaTelefoniaService TarifaTelefoniaService
@inject AuthService AuthService
@inject DbContextProvider DbContextProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Edición Masiva de Tarifas Telefonía</PageTitle>

@if (AuthService.UsuarioActual?.Rol != "Administrador")
{
    <div class="container mt-5">
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            No tienes permisos para acceder a esta sección.
        </div>
    </div>
}
else
{
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-telephone me-2"></i>Edición Masiva de Tarifas Telefonía</h2>
        <button class="btn btn-outline-secondary" @onclick="@(() => Navigation.NavigateTo("/inicio-rapido"))">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
            <button type="button" class="btn-close" @onclick="@(() => mensajeError = string.Empty)"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@mensajeExito
            <button type="button" class="btn-close" @onclick="@(() => mensajeExito = string.Empty)"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex gap-2 flex-wrap mb-3">
                <button class="btn btn-success" @onclick="AgregarNuevaFila" disabled="@guardando">
                    <i class="bi bi-plus-circle me-2"></i>Nueva Fila
                </button>
                <button class="btn btn-primary" @onclick="CopiarFilasSeleccionadas" disabled="@(guardando || !filasSeleccionadas.Any())">
                    <i class="bi bi-files me-2"></i>Copiar (@filasSeleccionadas.Count)
                </button>
                <button class="btn btn-info" @onclick="PegarFilas" disabled="@guardando">
                    <i class="bi bi-clipboard me-2"></i>Pegar
                </button>
                <button class="btn btn-warning" @onclick="GuardarCambios" disabled="@guardando">
                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-save me-2"></i>
                    }
                    Guardar Cambios
                </button>
            </div>

            <div class="alert alert-info py-2">
                <small>
                    <strong>Atajos de teclado:</strong>
                    <kbd>Ctrl+C</kbd> Copiar con ID |
                    <kbd>Ctrl+V</kbd> Pegar desde Excel |
                    <strong>Tip:</strong> Copia desde Excel con cabeceras. Si incluyes ID, se actualizarán las filas existentes.
                </small>
            </div>

            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-3">Cargando tarifas...</p>
                </div>
            }
            else
            {
                <div class="table-responsive" style="max-height: 70vh; overflow: auto;">
                    <table class="table table-sm table-bordered table-hover mb-0" id="tarifasTelefoniaTable" style="table-layout: fixed; width: 100%; min-width: 5000px;">
                        <thead class="table-light sticky-top" style="top: 0; z-index: 10;">
                            <tr>
                                <th style="width: 50px;">
                                    <input type="checkbox" class="form-check-input" 
                                           @onchange="ToggleSeleccionarTodas" 
                                           checked="@(filasSeleccionadas.Count == tarifas.Count && tarifas.Any())" />
                                </th>
                                <th style="width: 80px;">ID</th>
                                <th style="width: 150px;">Compañía*</th>
                                <th style="width: 150px;">Tipo*</th>
                                <th style="width: 150px;">Tarifa</th>
                                <th style="width: 120px;">Fibra</th>
                                <th style="width: 120px;">GB Móvil</th>
                                <th style="width: 120px;">Móvil 2</th>
                                <th style="width: 100px;">TV 1</th>
                                <th style="width: 100px;">TV 2</th>
                                <th style="width: 100px;">Precio (old)</th>
                                <th style="width: 120px;">Comisión (old)</th>
                                <th style="width: 120px;">Precio €*</th>
                                <th style="width: 120px;">Comisión €*</th>
                                <th style="width: 120px;">Permanencia</th>
                                <th style="width: 120px;">Días Penal.</th>
                                <th style="width: 140px;">Tipo Penal.</th>
                                <th style="width: 100px;">Activa</th>
                                <th style="width: 100px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (tarifa, index) in tarifas.Select((t, i) => (t, i)))
                            {
                                <tr class="@(filasSeleccionadas.Contains(index) ? "table-active" : "")">
                                    <td>
                                        <input type="checkbox" class="form-check-input" 
                                               checked="@filasSeleccionadas.Contains(index)"
                                               @onchange="@(() => ToggleSeleccionFila(index))" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" 
                                               @bind="tarifa.Id" readonly style="background-color: #e9ecef;" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.Compania" placeholder="Compañía" required />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.Tipo" placeholder="Tipo" required />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.Tarifa" placeholder="Tarifa" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.Fibra" placeholder="Fibra" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.GbMovil" placeholder="GB" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.Movil2" placeholder="Móvil 2" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.Tv1" placeholder="TV 1" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.Tv2" placeholder="TV 2" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.Precio" placeholder="Precio" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.Comision" placeholder="Comisión" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm" 
                                               @bind="tarifa.PrecioNew" placeholder="0.00" required />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm" 
                                               @bind="tarifa.ComisionNew" placeholder="0.00" required />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm" 
                                               @bind="tarifa.Permanencia" placeholder="Permanencia" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" 
                                               @bind="tarifa.DiasPenalizacion" placeholder="Días" />
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm" @bind="tarifa.TipoPenalizacion">
                                            <option value="">-- Seleccionar --</option>
                                            <option value="Total">Total</option>
                                            <option value="Proporcional">Proporcional</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="checkbox" class="form-check-input" 
                                               @bind="tarifa.Activa" />
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-danger" @onclick="@(() => EliminarFila(index))" disabled="@guardando">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <small class="text-muted">
                        Total de tarifas: <strong>@tarifas.Count</strong> | 
                        Seleccionadas: <strong>@filasSeleccionadas.Count</strong>
                    </small>
                </div>
            }
        </div>
    </div>
</div>
}

@code {
    private List<TarifaTelefonia> tarifas = new();
    private List<TarifaTelefonia> filasCopia = new();
    private HashSet<int> filasSeleccionadas = new();
    private bool cargando = true;
    private bool guardando = false;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private DotNetObjectReference<TarifasTelefoniaEdicionMasiva>? dotNetReference;

    protected override async Task OnInitializedAsync()
    {
        await CargarTarifas();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetReference = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initializeExcelLikePaste", dotNetReference);
        }
    }

    private async Task CargarTarifas()
    {
        try
        {
            cargando = true;
            mensajeExito = string.Empty;
            mensajeError = string.Empty;

            var todasLasTarifas = await TarifaTelefoniaService.ObtenerTodasAsync();
            tarifas = todasLasTarifas.OrderByDescending(t => t.Id).ToList();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar tarifas: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AgregarNuevaFila()
    {
        var nuevaTarifa = new TarifaTelefonia
        {
            Id = 0,
            Compania = string.Empty,
            Tipo = string.Empty,
            PrecioNew = 0,
            ComisionNew = 0,
            Activa = true,
            FechaCarga = DateTime.Now
        };
        tarifas.Insert(0, nuevaTarifa);
    }

    private void EliminarFila(int index)
    {
        if (index >= 0 && index < tarifas.Count)
        {
            tarifas.RemoveAt(index);
        }
    }

    private void ToggleSeleccionFila(int index)
    {
        if (filasSeleccionadas.Contains(index))
        {
            filasSeleccionadas.Remove(index);
        }
        else
        {
            filasSeleccionadas.Add(index);
        }
    }

    private void ToggleSeleccionarTodas(ChangeEventArgs e)
    {
        if ((bool?)e.Value == true)
        {
            filasSeleccionadas = Enumerable.Range(0, tarifas.Count).ToHashSet();
        }
        else
        {
            filasSeleccionadas.Clear();
        }
    }

    private async Task CopiarFilasSeleccionadas()
    {
        filasCopia.Clear();
        var datosParaPortapapeles = new List<string>();
        
        foreach (var index in filasSeleccionadas.OrderBy(x => x))
        {
            if (index >= 0 && index < tarifas.Count)
            {
                var tarifaOriginal = tarifas[index];
                
                var copia = new TarifaTelefonia
                {
                    Id = tarifaOriginal.Id,
                    Compania = tarifaOriginal.Compania,
                    Tipo = tarifaOriginal.Tipo,
                    Tarifa = tarifaOriginal.Tarifa,
                    Fibra = tarifaOriginal.Fibra,
                    GbMovil = tarifaOriginal.GbMovil,
                    Movil2 = tarifaOriginal.Movil2,
                    Tv1 = tarifaOriginal.Tv1,
                    Tv2 = tarifaOriginal.Tv2,
                    Precio = tarifaOriginal.Precio,
                    Comision = tarifaOriginal.Comision,
                    PrecioNew = tarifaOriginal.PrecioNew,
                    ComisionNew = tarifaOriginal.ComisionNew,
                    Permanencia = tarifaOriginal.Permanencia,
                    DiasPenalizacion = tarifaOriginal.DiasPenalizacion,
                    TipoPenalizacion = tarifaOriginal.TipoPenalizacion,
                    Activa = tarifaOriginal.Activa,
                    FechaCarga = tarifaOriginal.FechaCarga
                };
                filasCopia.Add(copia);
                
                var fila = string.Join("\t",
                    tarifaOriginal.Id.ToString(),
                    tarifaOriginal.Compania ?? "",
                    tarifaOriginal.Tipo ?? "",
                    tarifaOriginal.Tarifa ?? "",
                    tarifaOriginal.Fibra ?? "",
                    tarifaOriginal.GbMovil ?? "",
                    tarifaOriginal.Movil2 ?? "",
                    tarifaOriginal.Tv1 ?? "",
                    tarifaOriginal.Tv2 ?? "",
                    tarifaOriginal.Precio ?? "",
                    tarifaOriginal.Comision ?? "",
                    tarifaOriginal.PrecioNew.ToString(),
                    tarifaOriginal.ComisionNew.ToString(),
                    tarifaOriginal.Permanencia ?? "",
                    tarifaOriginal.DiasPenalizacion?.ToString() ?? "",
                    tarifaOriginal.TipoPenalizacion ?? "",
                    tarifaOriginal.Activa ? "1" : "0"
                );
                datosParaPortapapeles.Add(fila);
            }
        }
        
        if (datosParaPortapapeles.Any())
        {
            var cabeceras = string.Join("\t",
                "ID", "Compania", "Tipo", "Tarifa", "Fibra", "GbMovil", "Movil2",
                "Tv1", "Tv2", "Precio", "Comision", "PrecioNew", "ComisionNew",
                "Permanencia", "DiasPenalizacion", "TipoPenalizacion", "Activa"
            );
            
            var textoConCabeceras = cabeceras + "\n" + string.Join("\n", datosParaPortapapeles);
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", textoConCabeceras);
            mensajeExito = $"✓ {filasCopia.Count} fila(s) copiada(s) con ID. Al pegar, los registros con ID se actualizarán, sin ID se crearán como nuevos.";
        }
        else
        {
            mensajeExito = "No hay filas seleccionadas para copiar.";
        }
        
        StateHasChanged();
    }

    private async Task PegarFilas()
    {
        try
        {
            var textoPortapapeles = await JSRuntime.InvokeAsync<string>("navigator.clipboard.readText");
            
            if (string.IsNullOrWhiteSpace(textoPortapapeles))
            {
                mensajeError = "El portapapeles está vacío.";
                return;
            }

            await ProcesarYAgregarFilas(textoPortapapeles);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al leer del portapapeles: {ex.Message}";
        }
    }

    [JSInvokable]
    public async Task PasteRowsFromJS(List<List<string>> rowsData)
    {
        try
        {
            if (rowsData == null || rowsData.Count == 0) return;
            
            int filasCreadas = 0;
            int filasActualizadas = 0;
            var tarifasNuevos = new List<TarifaTelefonia>();
            var tarifasActualizados = new List<(TarifaTelefonia tarifa, int indiceOriginal)>();
            
            foreach (var rowData in rowsData)
            {
                int idTarifa = 0;
                if (rowData.Count > 0 && int.TryParse(rowData[0], out int parsedId))
                {
                    idTarifa = parsedId;
                }

                var tarifa = new TarifaTelefonia
                {
                    Id = idTarifa,
                    Compania = string.Empty,
                    Tipo = string.Empty,
                    PrecioNew = 0,
                    ComisionNew = 0,
                    Activa = true,
                    FechaCarga = DateTime.Now
                };
                
                if (rowData.Count > 1 && !string.IsNullOrWhiteSpace(rowData[1])) tarifa.Compania = rowData[1];
                if (rowData.Count > 2 && !string.IsNullOrWhiteSpace(rowData[2])) tarifa.Tipo = rowData[2];
                if (rowData.Count > 3 && !string.IsNullOrWhiteSpace(rowData[3])) tarifa.Tarifa = rowData[3];
                if (rowData.Count > 4 && !string.IsNullOrWhiteSpace(rowData[4])) tarifa.Fibra = rowData[4];
                if (rowData.Count > 5 && !string.IsNullOrWhiteSpace(rowData[5])) tarifa.GbMovil = rowData[5];
                if (rowData.Count > 6 && !string.IsNullOrWhiteSpace(rowData[6])) tarifa.Movil2 = rowData[6];
                if (rowData.Count > 7 && !string.IsNullOrWhiteSpace(rowData[7])) tarifa.Tv1 = rowData[7];
                if (rowData.Count > 8 && !string.IsNullOrWhiteSpace(rowData[8])) tarifa.Tv2 = rowData[8];
                if (rowData.Count > 9 && !string.IsNullOrWhiteSpace(rowData[9])) tarifa.Precio = rowData[9];
                if (rowData.Count > 10 && !string.IsNullOrWhiteSpace(rowData[10])) tarifa.Comision = rowData[10];
                if (rowData.Count > 11 && decimal.TryParse(rowData[11], out var precioNew)) tarifa.PrecioNew = precioNew;
                if (rowData.Count > 12 && decimal.TryParse(rowData[12], out var comisionNew)) tarifa.ComisionNew = comisionNew;
                if (rowData.Count > 13 && !string.IsNullOrWhiteSpace(rowData[13])) tarifa.Permanencia = rowData[13];
                if (rowData.Count > 14 && int.TryParse(rowData[14], out var diasPenal)) tarifa.DiasPenalizacion = diasPenal;
                if (rowData.Count > 15 && !string.IsNullOrWhiteSpace(rowData[15])) tarifa.TipoPenalizacion = rowData[15];
                if (rowData.Count > 16) tarifa.Activa = rowData[16] == "1" || rowData[16].ToLower() == "true";
                
                if (idTarifa > 0)
                {
                    var indiceExistente = tarifas.FindIndex(t => t.Id == idTarifa);
                    if (indiceExistente >= 0)
                    {
                        ActualizarTarifa(tarifas[indiceExistente], tarifa);
                        tarifasActualizados.Add((tarifas[indiceExistente], indiceExistente));
                        filasActualizadas++;
                    }
                    else
                    {
                        tarifasNuevos.Add(tarifa);
                        filasCreadas++;
                    }
                }
                else
                {
                    tarifa.Id = 0;
                    tarifasNuevos.Add(tarifa);
                    filasCreadas++;
                }
            }
            
            if (tarifasActualizados.Any())
            {
                foreach (var (tarifa, indice) in tarifasActualizados.OrderByDescending(x => x.indiceOriginal))
                {
                    tarifas.RemoveAt(indice);
                }
                tarifasActualizados.Reverse();
                foreach (var (tarifa, _) in tarifasActualizados)
                {
                    tarifas.Insert(0, tarifa);
                }
            }
            
            if (tarifasNuevos.Any())
            {
                tarifasNuevos.Reverse();
                foreach (var tarifa in tarifasNuevos)
                {
                    tarifas.Insert(0, tarifa);
                }
            }
            
            if (filasCreadas > 0 || filasActualizadas > 0)
            {
                var mensajes = new List<string>();
                if (filasCreadas > 0) mensajes.Add($"{filasCreadas} nueva(s)");
                if (filasActualizadas > 0) mensajes.Add($"{filasActualizadas} actualizada(s)");
                
                mensajeExito = $"✓ {string.Join(" y ", mensajes)} fila(s) al inicio. No olvides guardar.";
            }
            
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al pegar filas: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task PegarDesdePortapapeles(string textoPortapapeles)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(textoPortapapeles))
            {
                return;
            }

            await ProcesarYAgregarFilas(textoPortapapeles);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al pegar: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ProcesarYAgregarFilas(string textoPortapapeles)
    {
        var lineas = textoPortapapeles.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
        
        if (lineas.Length == 0)
        {
            mensajeError = "No hay datos para pegar.";
            return;
        }

        var primeraLinea = lineas[0].Split('\t');
        var esLineaCabecera = primeraLinea.Length > 0 && 
                              (primeraLinea[0].Trim().Equals("ID", StringComparison.OrdinalIgnoreCase) ||
                               primeraLinea[0].Trim().Equals("id", StringComparison.OrdinalIgnoreCase));
        
        var indiceInicio = esLineaCabecera ? 1 : 0;
        
        var rowsData = new List<List<string>>();
        for (int i = indiceInicio; i < lineas.Length; i++)
        {
            var columnas = lineas[i].Split('\t');
            rowsData.Add(columnas.ToList());
        }

        await PasteRowsFromJS(rowsData);
    }

    private void ActualizarTarifa(TarifaTelefonia destino, TarifaTelefonia origen)
    {
        destino.Compania = origen.Compania;
        destino.Tipo = origen.Tipo;
        destino.Tarifa = origen.Tarifa;
        destino.Fibra = origen.Fibra;
        destino.GbMovil = origen.GbMovil;
        destino.Movil2 = origen.Movil2;
        destino.Tv1 = origen.Tv1;
        destino.Tv2 = origen.Tv2;
        destino.Precio = origen.Precio;
        destino.Comision = origen.Comision;
        destino.PrecioNew = origen.PrecioNew;
        destino.ComisionNew = origen.ComisionNew;
        destino.Permanencia = origen.Permanencia;
        destino.DiasPenalizacion = origen.DiasPenalizacion;
        destino.TipoPenalizacion = origen.TipoPenalizacion;
        destino.Activa = origen.Activa;
    }

    private async Task GuardarCambios()
    {
        try
        {
            guardando = true;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;
            StateHasChanged();

            await using var context = DbContextProvider.CreateDbContext();
            
            int creados = 0;
            int actualizados = 0;
            var errores = new List<string>();

            foreach (var tarifa in tarifas)
            {
                if (string.IsNullOrWhiteSpace(tarifa.Compania))
                {
                    errores.Add($"Fila con ID {tarifa.Id}: El campo Compañía es obligatorio");
                    continue;
                }
                
                if (string.IsNullOrWhiteSpace(tarifa.Tipo))
                {
                    errores.Add($"Fila con ID {tarifa.Id}: El campo Tipo es obligatorio");
                    continue;
                }

                if (tarifa.Id == 0)
                {
                    tarifa.FechaCarga = DateTime.Now;
                    context.TarifasTelefonia.Add(tarifa);
                    creados++;
                }
                else
                {
                    var existente = await context.TarifasTelefonia.FindAsync(tarifa.Id);
                    if (existente != null)
                    {
                        existente.Compania = tarifa.Compania;
                        existente.Tipo = tarifa.Tipo;
                        existente.Tarifa = tarifa.Tarifa;
                        existente.Fibra = tarifa.Fibra;
                        existente.GbMovil = tarifa.GbMovil;
                        existente.Movil2 = tarifa.Movil2;
                        existente.Tv1 = tarifa.Tv1;
                        existente.Tv2 = tarifa.Tv2;
                        existente.Precio = tarifa.Precio;
                        existente.Comision = tarifa.Comision;
                        existente.PrecioNew = tarifa.PrecioNew;
                        existente.ComisionNew = tarifa.ComisionNew;
                        existente.Permanencia = tarifa.Permanencia;
                        existente.DiasPenalizacion = tarifa.DiasPenalizacion;
                        existente.TipoPenalizacion = tarifa.TipoPenalizacion;
                        existente.Activa = tarifa.Activa;
                        
                        context.TarifasTelefonia.Update(existente);
                        actualizados++;
                    }
                }
            }

            await context.SaveChangesAsync();

            if (errores.Any())
            {
                mensajeError = string.Join("<br/>", errores);
            }

            var mensaje = new List<string>();
            if (creados > 0) mensaje.Add($"{creados} tarifa(s) creada(s)");
            if (actualizados > 0) mensaje.Add($"{actualizados} tarifa(s) actualizada(s)");
            
            if (mensaje.Any())
            {
                mensajeExito = $"✓ {string.Join(" y ", mensaje)}";
            }

            await CargarTarifas();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar cambios: {ex.Message}";
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        dotNetReference?.Dispose();
    }
}
