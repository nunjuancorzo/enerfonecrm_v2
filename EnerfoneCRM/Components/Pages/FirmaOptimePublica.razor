@page "/firma-optime/{Token}"
@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@using Microsoft.JSInterop
@layout Layout.EmptyLayout
@rendermode InteractiveServer
@inject OptimeFirmaService OptimeFirmaService
@inject IJSRuntime JS

<PageTitle>Firma de documentacion</PageTitle>
<div class="firma-publica-shell"><main class="firma-publica-card">
    <header class="firma-publica-header">
        <h1>Documentación de alta de Punto de Venta</h1>
        <p>Consulta el documento y completa el proceso de firma.</p>
    </header>
    @if (cargando)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted">Cargando documentación...</p></div>
    }
    else if (firma == null)
    {
        <div class="alert alert-danger">El enlace no es válido, ha caducado o ya no está disponible.</div>
    }
    else if (firma.Estado == EstadoSolicitudFirma.Firmado)
    {
        <div class="alert alert-success"><strong>Proceso completado.</strong><br />El documento ya ha sido firmado.</div>
        <button class="btn btn-outline-primary w-100" @onclick="() => AbrirDocumento(true)"><i class="bi bi-file-pdf me-2"></i>Consultar documento firmado</button>
    }
    else if (!confirmando)
    {
        <section class="firma-resumen">
            <p>Hola <strong>@firma.NombreDestinatario</strong>.</p>
            <p class="mb-1">Tiene disponible el siguiente documento para su firma.</p>
            <dl class="row small mb-0">
                <dt class="col-5">Documento</dt><dd class="col-7">@OptimeFirma.Titulo(firma.TipoDocumento)</dd>
                <dt class="col-5">Válido hasta</dt><dd class="col-7">@firma.FechaCaducidadUtc.ToLocalTime().ToString("dd/MM/yyyy")</dd>
            </dl>
        </section>
        <section class="firma-documento-lista">
            <h2>Documentación</h2>
            <button class="documento-item" @onclick="() => AbrirDocumento(false)"><i class="bi bi-file-earmark-pdf"></i><span>@OptimeFirma.Titulo(firma.TipoDocumento)</span><i class="bi bi-eye ms-auto"></i></button>
        </section>
        <label class="form-check firma-check"><input class="form-check-input" type="checkbox" @bind="acepto" /><span>He leído y acepto la documentación mostrada.</span></label>
        <button class="btn btn-primary btn-lg w-100" disabled="@(!acepto)" @onclick="() => confirmando = true"><i class="bi bi-arrow-right me-2"></i>Continuar</button>
    }
    else
    {
        <div class="firma-confirmacion">
            <h2>Confirmar firma</h2>
            <p>Está a punto de firmar: <strong>@OptimeFirma.Titulo(firma.TipoDocumento)</strong>.</p>
            <label class="form-label fw-semibold">Realice su firma</label>
            <canvas id="@canvasId" width="700" height="250" class="firma-canvas"></canvas>
            <div class="d-flex justify-content-between mt-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick="Limpiar"><i class="bi bi-eraser me-1"></i>Borrar</button>
                <span class="small text-muted">Use el dedo, ratón o lápiz</span>
            </div>
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger mt-3">@error</div>
            }
            <button class="btn btn-success btn-lg w-100 mt-3" @onclick="Firmar" disabled="@firmando"><i class="bi bi-pen me-2"></i>Confirmar y firmar</button>
        </div>
    }
    <footer class="firma-publica-footer">Este enlace es personal. La firma se captura de forma manuscrita en pantalla.</footer>
</main></div>

<style>
    .firma-publica-shell { min-height: 100vh; background: linear-gradient(135deg,#eef4f8,#fff); padding: 1rem; }
    .firma-publica-card { max-width: 720px; margin: 0 auto; background: #fff; border: 1px solid #dbe4ea; border-radius: .5rem; box-shadow: 0 .75rem 2rem rgba(15,42,61,.08); padding: 1.25rem; }
    .firma-publica-header { border-bottom: 1px solid #e5e7eb; padding-bottom: 1rem; margin-bottom: 1rem; }
    .firma-publica-header h1 { font-size: 1.55rem; margin-bottom: .35rem; }
    .firma-publica-header p { color: #64748b; margin: 0; }
    .firma-resumen { background: #f8fafc; border-left: 4px solid #0d6efd; padding: 1rem; margin-bottom: 1.25rem; }
    .firma-documento-lista h2, .firma-confirmacion h2 { font-size: 1.1rem; }
    .documento-item { display: flex; align-items: center; gap: .75rem; width: 100%; border: 1px solid #dbe4ea; background: #fff; border-radius: .35rem; padding: .85rem; text-align: left; color: #172b4d; }
    .documento-item:hover { background: #f8fafc; }
    .documento-item i:first-child { color: #dc3545; font-size: 1.25rem; }
    .firma-check { display: flex; gap: .6rem; align-items: flex-start; margin: 1.25rem 0; }
    .firma-canvas { display: block; width: 100%; height: 190px; border: 1px dashed #94a3b8; border-radius: .35rem; background: #fff; touch-action: none; }
    .firma-publica-footer { border-top: 1px solid #e5e7eb; color: #64748b; font-size: .75rem; margin-top: 1.5rem; padding-top: 1rem; }
</style>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private const string canvasId = "firmaOptimeCanvas";
    private OptimeFirma? firma;
    private bool cargando = true;
    private bool acepto;
    private bool confirmando;
    private bool canvasInicializado;
    private bool firmando;
    private string error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        firma = await OptimeFirmaService.ObtenerPorTokenAsync(Token);
        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (confirmando && !canvasInicializado)
        {
            await JS.InvokeVoidAsync("publicSigning.start", canvasId);
            canvasInicializado = true;
        }
    }

    private async Task AbrirDocumento(bool firmado)
    {
        var contenido = firmado ? firma?.DocumentoFirmado : firma?.DocumentoOriginal;
        if (firma == null || contenido == null) return;
        await JS.InvokeVoidAsync("openFileInNewTab", OptimeFirmaService.NombreArchivo(firma.TipoDocumento, firmado), Convert.ToBase64String(contenido), "application/pdf");
    }

    private async Task Limpiar() => await JS.InvokeVoidAsync("publicSigning.clear", canvasId);

    private async Task Firmar()
    {
        firmando = true;
        error = string.Empty;
        try
        {
            if (!await JS.InvokeAsync<bool>("publicSigning.hasInk", canvasId))
            {
                error = "No se ha añadido ninguna firma. Dibuje su firma para continuar.";
                return;
            }

            var data = await JS.InvokeAsync<string>("publicSigning.dataUrl", canvasId);
            var pos = data.IndexOf(',');
            if (pos < 0)
            {
                error = "No se ha añadido ninguna firma. Dibuje su firma para continuar.";
                return;
            }

            var ipPublicaCliente = await JS.InvokeAsync<string>("publicSigning.getPublicIp");
            var resultado = await OptimeFirmaService.CompletarFirmaAsync(Token, Convert.FromBase64String(data[(pos + 1)..]), ipPublicaCliente);
            if (resultado.Exito)
                firma = await OptimeFirmaService.ObtenerPorTokenAsync(Token);
            else
                error = resultado.Mensaje;
        }
        catch (Exception)
        {
            error = "No se ha podido procesar la firma. Revise el recuadro e inténtelo de nuevo.";
        }
        finally
        {
            firmando = false;
        }
    }
}
