    private async Task PegarFilas()
    {
        try
        {
            var textoPortapapeles = await JSRuntime.InvokeAsync<string>("navigator.clipboard.readText");
            
            if (string.IsNullOrWhiteSpace(textoPortapapeles))
            {
                mensajeError = "El portapapeles está vacío.";
                return;
            }

            await ProcesarYAgregarFilas(textoPortapapeles);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al leer del portapapeles: {ex.Message}";
        }
    }

    [JSInvokable]
    public async Task PegarDesdePortapapeles(string textoPortapapeles)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(textoPortapapeles))
            {
                return;
            }

            await ProcesarYAgregarFilas(textoPortapapeles);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al pegar: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ProcesarYAgregarFilas(string textoPortapapeles)
    {
        var lineas = textoPortapapeles.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
        int filasCreadas = 0;
        int filasActualizadas = 0;
        var contratosNuevos = new List<Contrato>();
        var contratosActualizados = new List<(Contrato contrato, int indiceOriginal)>();
        
        foreach (var linea in lineas)
        {
            var columnas = linea.Split('\t');
            
            // Omitir línea de cabeceras
            if (columnas.Length > 0 && (columnas[0].Trim().Equals("ID", StringComparison.OrdinalIgnoreCase) || 
                                        columnas[0].Trim().Equals("UsuarioID", StringComparison.OrdinalIgnoreCase)))
                continue;
            
            if (columnas.Length < 2)
                continue;

            // Leer el ID de la primera columna
            int idContrato = 0;
            if (columnas.Length > 0 && int.TryParse(columnas[0].Trim(), out int parsedId))
            {
                idContrato = parsedId;
            }

            var contrato = new Contrato
            {
                Id = idContrato,
                Tipo = "energia",
                FechaCreacion = DateTime.Now,
                UsuarioComercializadoraId = columnas.Length > 1 && int.TryParse(columnas[1].Trim(), out int usuarioId) ? usuarioId : null,
                NombreCliente = columnas.Length > 2 ? columnas[2].Trim() : "",
                Dni = columnas.Length > 3 ? columnas[3].Trim() : "",
                Telefono = columnas.Length > 4 ? columnas[4].Trim() : "",
                EnComercializadora = columnas.Length > 5 ? columnas[5].Trim() : "",
                EnTarifa = columnas.Length > 6 ? columnas[6].Trim() : "",
                EnCups = columnas.Length > 7 ? columnas[7].Trim() : "",
                EnCupsGas = columnas.Length > 8 ? columnas[8].Trim() : "",
                TipoOperacion = columnas.Length > 9 ? columnas[9].Trim() : "",
                PotenciaContratadaP1 = columnas.Length > 10 && decimal.TryParse(columnas[10].Trim(), out decimal p1) ? p1 : null,
                PotenciaContratadaP2 = columnas.Length > 11 && decimal.TryParse(columnas[11].Trim(), out decimal p2) ? p2 : null,
                PotenciaContratadaP3 = columnas.Length > 12 && decimal.TryParse(columnas[12].Trim(), out decimal p3) ? p3 : null,
                PotenciaContratadaP4 = columnas.Length > 13 && decimal.TryParse(columnas[13].Trim(), out decimal p4) ? p4 : null,
                PotenciaContratadaP5 = columnas.Length > 14 && decimal.TryParse(columnas[14].Trim(), out decimal p5) ? p5 : null,
                PotenciaContratadaP6 = columnas.Length > 15 && decimal.TryParse(columnas[15].Trim(), out decimal p6) ? p6 : null,
                ConsumoAnual = columnas.Length > 16 && decimal.TryParse(columnas[16].Trim(), out decimal consumoAnual) ? consumoAnual : null,
                ConsumoAnualGas = columnas.Length > 17 && decimal.TryParse(columnas[17].Trim(), out decimal consumoGas) ? consumoGas : null,
                PeajeLuz = columnas.Length > 18 ? columnas[18].Trim() : "",
                PeajeGas = columnas.Length > 19 ? columnas[19].Trim() : "",
                Direccion = columnas.Length > 20 ? columnas[20].Trim() : "",
                CodigoPostal = columnas.Length > 21 ? columnas[21].Trim() : "",
                Iban = columnas.Length > 22 ? columnas[22].Trim() : "",
                Estado = columnas.Length > 23 ? columnas[23].Trim() : "",
                Comision = columnas.Length > 24 && decimal.TryParse(columnas[24].Trim(), out decimal comision) ? comision : null,
                Observaciones = columnas.Length > 25 ? columnas[25].Trim() : ""
            };

            // Si tiene ID válido, buscar y actualizar el existente
            if (idContrato > 0)
            {
                var indiceExistente = contratos.FindIndex(c => c.Id == idContrato);
                if (indiceExistente >= 0)
                {
                    var contratoExistente = contratos[indiceExistente];
                    contratoExistente.UsuarioComercializadoraId = contrato.UsuarioComercializadoraId;
                    contratoExistente.NombreCliente = contrato.NombreCliente;
                    contratoExistente.Dni = contrato.Dni;
                    contratoExistente.Telefono = contrato.Telefono;
                    contratoExistente.EnComercializadora = contrato.EnComercializadora;
                    contratoExistente.EnTarifa = contrato.EnTarifa;
                    contratoExistente.EnCups = contrato.EnCups;
                    contratoExistente.EnCupsGas = contrato.EnCupsGas;
                    contratoExistente.TipoOperacion = contrato.TipoOperacion;
                    contratoExistente.PotenciaContratadaP1 = contrato.PotenciaContratadaP1;
                    contratoExistente.PotenciaContratadaP2 = contrato.PotenciaContratadaP2;
                    contratoExistente.PotenciaContratadaP3 = contrato.PotenciaContratadaP3;
                    contratoExistente.PotenciaContratadaP4 = contrato.PotenciaContratadaP4;
                    contratoExistente.PotenciaContratadaP5 = contrato.PotenciaContratadaP5;
                    contratoExistente.PotenciaContratadaP6 = contrato.PotenciaContratadaP6;
                    contratoExistente.ConsumoAnual = contrato.ConsumoAnual;
                    contratoExistente.ConsumoAnualGas = contrato.ConsumoAnualGas;
                    contratoExistente.PeajeLuz = contrato.PeajeLuz;
                    contratoExistente.PeajeGas = contrato.PeajeGas;
                    contratoExistente.Direccion = contrato.Direccion;
                    contratoExistente.CodigoPostal = contrato.CodigoPostal;
                    contratoExistente.Iban = contrato.Iban;
                    contratoExistente.Estado = contrato.Estado;
                    contratoExistente.Comision = contrato.Comision;
                    contratoExistente.Observaciones = contrato.Observaciones;
                    
                    contratosActualizados.Add((contratoExistente, indiceExistente));
                    filasActualizadas++;
                }
                else
                {
                    contratosNuevos.Add(contrato);
                    filasCreadas++;
                }
            }
            else
            {
                contrato.Id = 0;
                contratosNuevos.Add(contrato);
                filasCreadas++;
            }
        }
        
        // Mover contratos actualizados al inicio
        if (contratosActualizados.Any())
        {
            foreach (var (contrato, indice) in contratosActualizados.OrderByDescending(x => x.indiceOriginal))
            {
                contratos.RemoveAt(indice);
            }
            contratosActualizados.Reverse();
            foreach (var (contrato, _) in contratosActualizados)
            {
                contratos.Insert(0, contrato);
            }
        }
        
        // Insertar todas las filas nuevas al inicio
        if (contratosNuevos.Any())
        {
            contratosNuevos.Reverse();
            foreach (var contrato in contratosNuevos)
            {
                contratos.Insert(0, contrato);
            }
        }
        
        if (filasCreadas > 0 || filasActualizadas > 0)
        {
            var mensajes = new List<string>();
            if (filasCreadas > 0) mensajes.Add($"{filasCreadas} nueva(s)");
            if (filasActualizadas > 0) mensajes.Add($"{filasActualizadas} actualizada(s)");
            
            mensajeExito = $"✓ {string.Join(" y ", mensajes)} fila(s) al inicio de la lista. No olvides guardar.";
            filasSeleccionadas.Clear();
        }
        else
        {
            mensajeError = "No se pudieron procesar las filas del portapapeles.";
        }
        
        StateHasChanged();
    }

    private async Task GuardarCambios()
    {
        try
        {
            guardando = true;
            erroresValidacion.Clear();
            mensajeExito = string.Empty;
            mensajeError = string.Empty;

            // Validar todos los contratos
            if (!await ValidarContratos())
            {
                mensajeError = "Por favor, corrige los errores de validación antes de guardar.";
                return;
            }

            int creados = 0;
            int actualizados = 0;
            int errores = 0;

            await using var context = DbContextProvider.CreateDbContext();

            foreach (var contrato in contratos)
            {
                try
                {
                    // Asignar usuario actual si no tiene
                    if (contrato.UsuarioComercializadoraId == null || contrato.UsuarioComercializadoraId == 0)
                    {
                        contrato.UsuarioComercializadoraId = AuthService.UsuarioActual?.Id;
                    }

                    // Asignar fecha de creación si es nuevo
                    if (contrato.Id == 0 && contrato.FechaCreacion == null)
                    {
                        contrato.FechaCreacion = DateTime.Now;
                    }

                    if (contrato.Id == 0)
                    {
                        context.Contratos.Add(contrato);
                        await context.SaveChangesAsync();
                        creados++;
                    }
                    else
                    {
                        context.Contratos.Update(contrato);
                        await context.SaveChangesAsync();
                        actualizados++;
                    }
                }
                catch (Exception ex)
                {
                    errores++;
                    erroresValidacion.Add($"Error en contrato {(contrato.Id > 0 ? contrato.Id.ToString() : "nuevo")}: {ex.Message}");
                }
            }

            if (errores == 0)
            {
                mensajeExito = $"✓ Cambios guardados correctamente. Creados: {creados}, Actualizados: {actualizados}";
                await CargarContratos();
            }
            else
            {
                mensajeError = $"Se guardaron algunos cambios pero hubo {errores} error(es). Creados: {creados}, Actualizados: {actualizados}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar cambios: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task<bool> ValidarContratos()
    {
        bool esValido = true;
        erroresValidacion.Clear();

        await using var context = DbContextProvider.CreateDbContext();
        var usuariosValidos = await context.Usuarios.Select(u => u.Id).ToListAsync();

        for (int i = 0; i < contratos.Count; i++)
        {
            var contrato = contratos[i];
            var prefijo = $"Fila {i + 1}";

            // Validación 1: Nombre Cliente obligatorio
            if (string.IsNullOrWhiteSpace(contrato.NombreCliente))
            {
                erroresValidacion.Add($"{prefijo}: Nombre Cliente es obligatorio");
                esValido = false;
            }

            // Validación 2: DNI obligatorio
            if (string.IsNullOrWhiteSpace(contrato.Dni))
            {
                erroresValidacion.Add($"{prefijo}: DNI es obligatorio");
                esValido = false;
            }

            // Validación 3: Comercializadora obligatorio
            if (string.IsNullOrWhiteSpace(contrato.EnComercializadora))
            {
                erroresValidacion.Add($"{prefijo}: Comercializadora es obligatorio");
                esValido = false;
            }

            // Validación 4: Tarifa obligatorio
            if (string.IsNullOrWhiteSpace(contrato.EnTarifa))
            {
                erroresValidacion.Add($"{prefijo}: Tarifa es obligatorio");
                esValido = false;
            }

            // Validación 5: Estado obligatorio
            if (string.IsNullOrWhiteSpace(contrato.Estado))
            {
                erroresValidacion.Add($"{prefijo}: Estado es obligatorio");
                esValido = false;
            }

            // Validación 6: ID Usuario debe existir si tiene valor
            if (contrato.UsuarioComercializadoraId.HasValue && contrato.UsuarioComercializadoraId.Value > 0)
            {
                if (!usuariosValidos.Contains(contrato.UsuarioComercializadoraId.Value))
                {
                    erroresValidacion.Add($"{prefijo}: El ID Usuario {contrato.UsuarioComercializadoraId.Value} no existe");
                    esValido = false;
                }
            }
        }

        return esValido;
    }

