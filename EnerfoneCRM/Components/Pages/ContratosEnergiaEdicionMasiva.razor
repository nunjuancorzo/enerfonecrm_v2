    private void OnCupsInput(ChangeEventArgs e, Contrato contrato, string propertyName)
    {
        var value = e.Value?.ToString() ?? "";
        // Eliminar espacios
        value = value.Replace(" ", "");
        // Limitar a 20 caracteres
        if (value.Length > 20)
        {
            value = value.Substring(0, 20);
        }
        
        // Actualizar la propiedad correspondiente
        if (propertyName == nameof(contrato.EnCups))
        {
            contrato.EnCups = value;
        }
        else if (propertyName == nameof(contrato.EnCupsGas))
        {
            contrato.EnCupsGas = value;
        }
    }
