@page "/contratos-energia-edicion-masiva"
@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@using EnerfoneCRM.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@rendermode InteractiveServer
@inject ContratoService ContratoService
@inject UsuarioService UsuarioService
@inject AuthService AuthService
@inject DbContextProvider DbContextProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Edición Masiva de Contratos Energía - CorCRM</PageTitle>

@if (inicializando)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (AuthService.UsuarioActual?.Rol != "Administrador")
{
    <div class="container mt-5">
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            No tienes permisos para acceder a esta sección.
        </div>
    </div>
}
else
{
    <div class="container-fluid p-4">
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2><i class="bi bi-table me-2"></i>Edición Masiva de Contratos Energía</h2>
                    <p class="text-muted mb-0">Edita múltiples contratos de energía de forma simultánea. Puedes copiar y pegar desde Excel.</p>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-secondary" @onclick="CargarContratos" disabled="@guardando">
                    <i class="bi bi-arrow-clockwise me-2"></i>Recargar
                </button>
                <button class="btn btn-info" @onclick="CopiarFilasSeleccionadas" disabled="@(filasSeleccionadas.Count == 0)">
                    <i class="bi bi-copy me-2"></i>Copiar (@filasSeleccionadas.Count)
                </button>
                <button class="btn btn-warning" @onclick="PegarFilas">
                    <i class="bi bi-clipboard-plus me-2"></i>Pegar
                </button>
                <button class="btn btn-success" @onclick="AgregarNuevaFila" disabled="@guardando">
                    <i class="bi bi-plus-circle me-2"></i>Añadir Fila
                </button>
                <button class="btn btn-primary" @onclick="GuardarCambios" disabled="@guardando">
                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    <i class="bi bi-save me-2"></i>Guardar Cambios
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle me-2"></i>@mensajeExito
                <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
                <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
            </div>
        }

        @if (erroresValidacion.Any())
        {
            <div class="alert alert-warning alert-dismissible fade show">
                <strong>Errores de validación:</strong>
                <ul class="mb-0 mt-2">
                    @foreach (var error in erroresValidacion.Take(10))
                    {
                        <li><small>@error</small></li>
                    }
                    @if (erroresValidacion.Count > 10)
                    {
                        <li><small><em>... y @(erroresValidacion.Count - 10) errores más</em></small></li>
                    }
                </ul>
                <button type="button" class="btn-close" @onclick="() => erroresValidacion.Clear()"></button>
            </div>
        }

        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
                <p class="mt-3 text-muted">Cargando contratos...</p>
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: calc(100vh - 300px); overflow: auto;">
                        <table class="table table-sm table-bordered table-hover mb-0" id="contratosEnergiaTable" style="table-layout: fixed; width: 100%; min-width: 7000px;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width: 60px;">
                                        <input type="checkbox" @onchange="ToggleSeleccionarTodas" />
                                    </th>
                                    <th style="width: 100px;">Acciones</th>
                                    <th style="width: 120px;">ID</th>
                                    <th style="width: 150px;">Usuario ID</th>
                                    <th style="width: 250px;">Nombre Cliente*</th>
                                    <th style="width: 200px;">DNI*</th>
                                    <th style="width: 180px;">Teléfono</th>
                                    <th style="width: 250px;">Comercializadora*</th>
                                    <th style="width: 250px;">Tarifa*</th>
                                    <th style="width: 300px;">CUPS</th>
                                    <th style="width: 300px;">CUPS Gas</th>
                                    <th style="width: 250px;">Tipo Operación</th>
                                    <th style="width: 150px;">Potencia P1</th>
                                    <th style="width: 150px;">Potencia P2</th>
                                    <th style="width: 150px;">Potencia P3</th>
                                    <th style="width: 150px;">Potencia P4</th>
                                    <th style="width: 150px;">Potencia P5</th>
                                    <th style="width: 150px;">Potencia P6</th>
                                    <th style="width: 180px;">Consumo Anual</th>
                                    <th style="width: 180px;">Consumo Gas</th>
                                    <th style="width: 180px;">Peaje Luz</th>
                                    <th style="width: 180px;">Peaje Gas</th>
                                    <th style="width: 350px;">Dirección</th>
                                    <th style="width: 150px;">CP</th>
                                    <th style="width: 350px;">IBAN</th>
                                    <th style="width: 200px;">Estado*</th>
                                    <th style="width: 180px;">Comisión</th>
                                    <th style="width: 400px;">Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (contrato, index) in contratos.Select((c, i) => (c, i)))
                                {
                                    <tr data-row-index="@index" class="@(filasSeleccionadas.Contains(index) ? "row-selected" : "")">
                                        <td class="text-center">
                                            <input type="checkbox" checked="@filasSeleccionadas.Contains(index)" @onchange="() => ToggleSeleccionFila(index)" />
                                        </td>
                                        <td class="text-center">
                                            @if (contrato.Id == 0)
                                            {
                                                <button class="btn btn-sm btn-danger" @onclick="() => EliminarFila(index)" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </td>
                                        <td class="bg-light text-muted">
                                            @if (contrato.Id > 0)
                                            {
                                                @contrato.Id
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Nuevo</span>
                                            }
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" @bind="contrato.UsuarioComercializadoraId" 
                                                   @onpaste="@((e) => OnPaste(e, index, "UsuarioComercializadoraId"))" min="1" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.NombreCliente" 
                                                   @onpaste="@((e) => OnPaste(e, index, "NombreCliente"))" maxlength="255" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.Dni" 
                                                   @onpaste="@((e) => OnPaste(e, index, "Dni"))" maxlength="50" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.Telefono" 
                                                   @onpaste="@((e) => OnPaste(e, index, "Telefono"))" maxlength="20" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.EnComercializadora" 
                                                   @onpaste="@((e) => OnPaste(e, index, "EnComercializadora"))" maxlength="255" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.EnTarifa" 
                                                   @onpaste="@((e) => OnPaste(e, index, "EnTarifa"))" maxlength="255" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.EnCups" 
                                                   @oninput="@((e) => OnCupsInput(e, contrato, nameof(contrato.EnCups)))"
                                                   @onpaste="@((e) => OnPaste(e, index, "EnCups"))" maxlength="20" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.EnCupsGas" 
                                                   @oninput="@((e) => OnCupsInput(e, contrato, nameof(contrato.EnCupsGas)))"
                                                   @onpaste="@((e) => OnPaste(e, index, "EnCupsGas"))" maxlength="20" />
                                        </td>
                                        <td>
                                            <select class="form-control form-control-sm" @bind="contrato.TipoOperacion">
                                                <option value="">-- Seleccionar --</option>
                                                <option value="Alta">Alta</option>
                                                <option value="Cambio Titular">Cambio Titular</option>
                                                <option value="Cambio Comercializadora">Cambio Comercializadora</option>
                                                <option value="Modificación Contrato">Modificación Contrato</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" @bind="contrato.PotenciaContratadaP1" 
                                                   @onpaste="@((e) => OnPaste(e, index, "PotenciaContratadaP1"))" step="0.001" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" @bind="contrato.PotenciaContratadaP2" 
                                                   @onpaste="@((e) => OnPaste(e, index, "PotenciaContratadaP2"))" step="0.001" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" @bind="contrato.PotenciaContratadaP3" 
                                                   @onpaste="@((e) => OnPaste(e, index, "PotenciaContratadaP3"))" step="0.001" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" @bind="contrato.PotenciaContratadaP4" 
                                                   @onpaste="@((e) => OnPaste(e, index, "PotenciaContratadaP4"))" step="0.001" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" @bind="contrato.PotenciaContratadaP5" 
                                                   @onpaste="@((e) => OnPaste(e, index, "PotenciaContratadaP5"))" step="0.001" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" @bind="contrato.PotenciaContratadaP6" 
                                                   @onpaste="@((e) => OnPaste(e, index, "PotenciaContratadaP6"))" step="0.001" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" @bind="contrato.ConsumoAnual" 
                                                   @onpaste="@((e) => OnPaste(e, index, "ConsumoAnual"))" step="0.01" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" @bind="contrato.ConsumoAnualGas" 
                                                   @onpaste="@((e) => OnPaste(e, index, "ConsumoAnualGas"))" step="0.01" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.PeajeLuz" 
                                                   @onpaste="@((e) => OnPaste(e, index, "PeajeLuz"))" maxlength="100" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.PeajeGas" 
                                                   @onpaste="@((e) => OnPaste(e, index, "PeajeGas"))" maxlength="100" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.Direccion" 
                                                   @onpaste="@((e) => OnPaste(e, index, "Direccion"))" maxlength="500" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.CodigoPostal" 
                                                   @onpaste="@((e) => OnPaste(e, index, "CodigoPostal"))" maxlength="10" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.Iban" 
                                                   @onpaste="@((e) => OnPaste(e, index, "Iban"))" maxlength="34" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm" @bind="contrato.Estado" 
                                                   @onpaste="@((e) => OnPaste(e, index, "Estado"))" maxlength="50" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm" @bind="contrato.Comision" 
                                                   @onpaste="@((e) => OnPaste(e, index, "Comision"))" step="0.01" />
                                        </td>
                                        <td>
                                            <textarea class="form-control form-control-sm" @bind="contrato.Observaciones" 
                                                      @onpaste="@((e) => OnPaste(e, index, "Observaciones"))" rows="1"></textarea>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">
                            <i class="bi bi-info-circle me-2"></i>
                            Total de registros: <strong>@contratos.Count</strong> 
                            (@contratos.Count(c => c.Id == 0) nuevos, @contratos.Count(c => c.Id > 0) existentes)
                        </span>
                        <div>
                            <span class="text-muted me-3">* Campos obligatorios</span>
                            <button class="btn btn-sm btn-success" @onclick="AgregarNuevaFila" disabled="@guardando">
                                <i class="bi bi-plus-circle me-2"></i>Añadir Fila
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-success mb-3">
                <h6><i class="bi bi-check-circle me-2"></i>Cómo usar copiar/pegar:</h6>
                <ol class="mb-0">
                    <li><strong>Copiar filas:</strong> Marca los checkboxes → Clic en "Copiar" (incluye el ID)</li>
                    <li><strong>Pegar para editar:</strong> Las filas con ID se actualizarán en lugar de duplicarse</li>
                    <li><strong>Pegar sin ID:</strong> Crea nuevos registros (borra el ID en Excel para duplicar)</li>
                    <li><strong>Filas editadas/nuevas:</strong> Aparecen al inicio de la lista para fácil localización</li>
                </ol>
            </div>

            <div class="alert alert-info mt-3">
                <h6><i class="bi bi-lightbulb me-2"></i>Consejos de uso:</h6>
                <ul class="mb-0">
                    <li><strong>Pegar en celdas:</strong> Copia desde Excel y pega directamente en campos individuales</li>
                    <li><strong>Pegar filas completas:</strong> Usa <kbd>Ctrl</kbd>+<kbd>V</kbd> o el botón "Pegar" para añadir filas nuevas</li>
                    <li>Los campos marcados con * son obligatorios</li>
                    <li>El campo ID no es editable para registros existentes</li>
                    <li>Añade nuevas filas vacías con el botón "Añadir Fila"</li>
                    <li>Guarda todos los cambios cuando termines de editar</li>
                </ul>
            </div>
        }
    </div>
}

@code {
    private List<Contrato> contratos = new();
    private bool inicializando = true;
    private bool cargando = false;
    private bool guardando = false;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;
    private List<string> erroresValidacion = new();
    private DotNetObjectReference<ContratosEnergiaEdicionMasiva>? dotnetReference;
    
    private HashSet<int> filasSeleccionadas = new();
    private List<Contrato> filasCopia = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Esperar a que AuthService se inicialice
            var intentos = 0;
            while (AuthService.UsuarioActual == null && intentos < 10)
            {
                await Task.Delay(100);
                intentos++;
            }
            
            inicializando = false;
            
            if (AuthService.UsuarioActual == null)
            {
                mensajeError = "No se pudo cargar la información del usuario";
                return;
            }
            
            if (AuthService.UsuarioActual.Rol != "Administrador")
            {
                mensajeError = $"No tienes permisos (Rol: {AuthService.UsuarioActual.Rol})";
                return;
            }
            
            await CargarContratos();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error en inicialización: {ex.Message}";
            inicializando = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                dotnetReference = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("initializeContratosEnergiaPaste", dotnetReference);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ENERGIA] Error inicializando JavaScript (no crítico): {ex.Message}");
                // No es crítico, la página puede funcionar sin la funcionalidad de pegar
            }
        }
    }
    
    public void Dispose()
    {
        dotnetReference?.Dispose();
    }
    
    [JSInvokable]
    public async Task PasteRowsFromJS(List<List<string>> rowsData)
    {
        try
        {
            if (rowsData == null || rowsData.Count == 0) return;
            
            // El orden de campos en la tabla (con ID como primera columna):
            // ID, UsuarioComercializadoraId, NombreCliente, Dni, Telefono, EnComercializadora, EnTarifa, EnCups, EnCupsGas,
            // TipoOperacion, PotenciaContratadaP1, P2, P3, P4, P5, P6, ConsumoAnual, ConsumoAnualGas, PeajeLuz, PeajeGas,
            // Direccion, CodigoPostal, Iban, Estado, Comision, Observaciones
            
            int filasCreadas = 0;
            int filasActualizadas = 0;
            var contratosNuevos = new List<Contrato>();
            var contratosActualizados = new List<(Contrato contrato, int indiceOriginal)>();
            
            foreach (var rowData in rowsData)
            {
                // Leer el ID de la primera columna
                int idContrato = 0;
                if (rowData.Count > 0 && int.TryParse(rowData[0], out int parsedId))
                {
                    idContrato = parsedId;
                }

                var contrato = new Contrato
                {
                    Id = idContrato,
                    Tipo = "energia",
                    FechaCreacion = DateTime.Now
                };
                
                // Mapear datos según el índice (todos desplazados +1 por el ID)
                if (rowData.Count > 1 && !string.IsNullOrWhiteSpace(rowData[1]))
                {
                    if (int.TryParse(rowData[1], out int usuarioId))
                        contrato.UsuarioComercializadoraId = usuarioId;
                }
                if (rowData.Count > 2 && !string.IsNullOrWhiteSpace(rowData[2])) contrato.NombreCliente = rowData[2];
                if (rowData.Count > 3 && !string.IsNullOrWhiteSpace(rowData[3])) contrato.Dni = rowData[3];
                if (rowData.Count > 4 && !string.IsNullOrWhiteSpace(rowData[4])) contrato.Telefono = rowData[4];
                if (rowData.Count > 5 && !string.IsNullOrWhiteSpace(rowData[5])) contrato.EnComercializadora = rowData[5];
                if (rowData.Count > 6 && !string.IsNullOrWhiteSpace(rowData[6])) contrato.EnTarifa = rowData[6];
                if (rowData.Count > 7 && !string.IsNullOrWhiteSpace(rowData[7])) contrato.EnCups = rowData[7];
                if (rowData.Count > 8 && !string.IsNullOrWhiteSpace(rowData[8])) contrato.EnCupsGas = rowData[8];
                if (rowData.Count > 9 && !string.IsNullOrWhiteSpace(rowData[9])) contrato.TipoOperacion = rowData[9];
                if (rowData.Count > 10 && !string.IsNullOrWhiteSpace(rowData[10]))
                {
                    if (decimal.TryParse(rowData[10], out decimal p1))
                        contrato.PotenciaContratadaP1 = p1;
                }
                if (rowData.Count > 11 && !string.IsNullOrWhiteSpace(rowData[11]))
                {
                    if (decimal.TryParse(rowData[11], out decimal p2))
                        contrato.PotenciaContratadaP2 = p2;
                }
                if (rowData.Count > 12 && !string.IsNullOrWhiteSpace(rowData[12]))
                {
                    if (decimal.TryParse(rowData[12], out decimal p3))
                        contrato.PotenciaContratadaP3 = p3;
                }
                if (rowData.Count > 13 && !string.IsNullOrWhiteSpace(rowData[13]))
                {
                    if (decimal.TryParse(rowData[13], out decimal p4))
                        contrato.PotenciaContratadaP4 = p4;
                }
                if (rowData.Count > 14 && !string.IsNullOrWhiteSpace(rowData[14]))
                {
                    if (decimal.TryParse(rowData[14], out decimal p5))
                        contrato.PotenciaContratadaP5 = p5;
                }
                if (rowData.Count > 15 && !string.IsNullOrWhiteSpace(rowData[15]))
                {
                    if (decimal.TryParse(rowData[15], out decimal p6))
                        contrato.PotenciaContratadaP6 = p6;
                }
                if (rowData.Count > 16 && !string.IsNullOrWhiteSpace(rowData[16]))
                {
                    if (decimal.TryParse(rowData[16], out decimal consumoAnual))
                        contrato.ConsumoAnual = consumoAnual;
                }
                if (rowData.Count > 17 && !string.IsNullOrWhiteSpace(rowData[17]))
                {
                    if (decimal.TryParse(rowData[17], out decimal consumoGas))
                        contrato.ConsumoAnualGas = consumoGas;
                }
                if (rowData.Count > 18 && !string.IsNullOrWhiteSpace(rowData[18])) contrato.PeajeLuz = rowData[18];
                if (rowData.Count > 19 && !string.IsNullOrWhiteSpace(rowData[19])) contrato.PeajeGas = rowData[19];
                if (rowData.Count > 20 && !string.IsNullOrWhiteSpace(rowData[20])) contrato.Direccion = rowData[20];
                if (rowData.Count > 21 && !string.IsNullOrWhiteSpace(rowData[21])) contrato.CodigoPostal = rowData[21];
                if (rowData.Count > 22 && !string.IsNullOrWhiteSpace(rowData[22])) contrato.Iban = rowData[22];
                if (rowData.Count > 23 && !string.IsNullOrWhiteSpace(rowData[23])) contrato.Estado = rowData[23];
                if (rowData.Count > 24 && !string.IsNullOrWhiteSpace(rowData[24]))
                {
                    if (decimal.TryParse(rowData[24], out decimal comision))
                        contrato.Comision = comision;
                }
                if (rowData.Count > 25 && !string.IsNullOrWhiteSpace(rowData[25])) contrato.Observaciones = rowData[25];
                
                // Si tiene ID válido, buscar y actualizar el existente
                if (idContrato > 0)
                {
                    var indiceExistente = contratos.FindIndex(c => c.Id == idContrato);
                    if (indiceExistente >= 0)
                    {
                        // Actualizar el contrato existente
                        var contratoExistente = contratos[indiceExistente];
                        contratoExistente.UsuarioComercializadoraId = contrato.UsuarioComercializadoraId;
                        contratoExistente.NombreCliente = contrato.NombreCliente;
                        contratoExistente.Dni = contrato.Dni;
                        contratoExistente.Telefono = contrato.Telefono;
                        contratoExistente.EnComercializadora = contrato.EnComercializadora;
                        contratoExistente.EnTarifa = contrato.EnTarifa;
                        contratoExistente.EnCups = contrato.EnCups;
                        contratoExistente.EnCupsGas = contrato.EnCupsGas;
                        contratoExistente.TipoOperacion = contrato.TipoOperacion;
                        contratoExistente.PotenciaContratadaP1 = contrato.PotenciaContratadaP1;
                        contratoExistente.PotenciaContratadaP2 = contrato.PotenciaContratadaP2;
                        contratoExistente.PotenciaContratadaP3 = contrato.PotenciaContratadaP3;
                        contratoExistente.PotenciaContratadaP4 = contrato.PotenciaContratadaP4;
                        contratoExistente.PotenciaContratadaP5 = contrato.PotenciaContratadaP5;
                        contratoExistente.PotenciaContratadaP6 = contrato.PotenciaContratadaP6;
                        contratoExistente.ConsumoAnual = contrato.ConsumoAnual;
                        contratoExistente.ConsumoAnualGas = contrato.ConsumoAnualGas;
                        contratoExistente.PeajeLuz = contrato.PeajeLuz;
                        contratoExistente.PeajeGas = contrato.PeajeGas;
                        contratoExistente.Direccion = contrato.Direccion;
                        contratoExistente.CodigoPostal = contrato.CodigoPostal;
                        contratoExistente.Iban = contrato.Iban;
                        contratoExistente.Estado = contrato.Estado;
                        contratoExistente.Comision = contrato.Comision;
                        contratoExistente.Observaciones = contrato.Observaciones;
                        
                        contratosActualizados.Add((contratoExistente, indiceExistente));
                        filasActualizadas++;
                    }
                    else
                    {
                        // ID no encontrado, agregar como nuevo
                        contratosNuevos.Add(contrato);
                        filasCreadas++;
                    }
                }
                else
                {
                    // Sin ID, agregar como nuevo
                    contrato.Id = 0;
                    contratosNuevos.Add(contrato);
                    filasCreadas++;
                }
            }
            
            // Mover contratos actualizados al inicio
            if (contratosActualizados.Any())
            {
                foreach (var (contrato, indice) in contratosActualizados.OrderByDescending(x => x.indiceOriginal))
                {
                    contratos.RemoveAt(indice);
                }
                contratosActualizados.Reverse();
                foreach (var (contrato, _) in contratosActualizados)
                {
                    contratos.Insert(0, contrato);
                }
            }
            
            // Insertar todas las filas nuevas al inicio
            if (contratosNuevos.Any())
            {
                contratosNuevos.Reverse();
                foreach (var contrato in contratosNuevos)
                {
                    contratos.Insert(0, contrato);
                }
            }
            
            if (filasCreadas > 0 || filasActualizadas > 0)
            {
                var mensajes = new List<string>();
                if (filasCreadas > 0) mensajes.Add($"{filasCreadas} nueva(s)");
                if (filasActualizadas > 0) mensajes.Add($"{filasActualizadas} actualizada(s)");
                
                mensajeExito = $"✓ {string.Join(" y ", mensajes)} fila(s) al inicio. No olvides guardar.";
            }
            
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al pegar filas: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CargarContratos()
    {
        try
        {
            cargando = true;
            mensajeExito = string.Empty;
            mensajeError = string.Empty;
            erroresValidacion.Clear();

            var todosLosContratos = await ContratoService.ObtenerTodosPorTipoAsync(
                "energia",
                AuthService.UsuarioActual?.Rol,
                AuthService.UsuarioActual?.NombreUsuario,
                AuthService.UsuarioActual?.Id
            );
            
            if (todosLosContratos != null)
            {
                contratos = todosLosContratos.OrderByDescending(c => c.Id).ToList();
            }
            else
            {
                contratos = new List<Contrato>();
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar contratos: {ex.Message}";
            contratos = new List<Contrato>();
        }
        finally
        {
            cargando = false;
        }
    }

