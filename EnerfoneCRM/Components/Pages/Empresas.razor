@page "/empresas"
@layout Layout.MainLayout
@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@inject AuthService AuthService
@inject EmpresaService EmpresaService
@inject ConfiguracionService ConfiguracionService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Empresas - Voltia Solutions</PageTitle>

<div class="container-fluid p-4">
    @if (cargando)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 400px;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (!AuthService.EsSuperAdmin)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            <span>Solo superadmin puede gestionar empresas.</span>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="mb-1"><i class="bi bi-buildings me-2"></i>Gestión de Empresas</h2>
                    <p class="text-muted mb-0">Administra las empresas del sistema</p>
                </div>
                <button class="btn btn-primary btn-lg" @onclick="AbrirModal">
                    <i class="bi bi-plus-circle me-2"></i>Nueva Empresa
                </button>
            </div>
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@error</span>
                </div>
            }
        </div>

        <!-- Grid de Empresas -->
        @if (empresas.Count > 0)
        {
            <div class="row g-4">
                @foreach (var empresa in empresas)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm empresa-card" style="transition: all 0.3s ease;">
                            <div class="card-header bg-light border-0 pb-0">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h5 class="card-title mb-0">@empresa.Nombre</h5>
                                    <span class="badge @(empresa.Activa ? "bg-success" : "bg-secondary")">
                                        @(empresa.Activa ? "Activa" : "Inactiva")
                                    </span>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="d-flex flex-column gap-2">
                                    <div class="d-flex align-items-center gap-2 text-muted">
                                        <i class="bi bi-hash"></i>
                                        <small>ID: @empresa.Id</small>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-light border-top d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary flex-grow-1" @onclick="() => AbrirModalEdicion(empresa)">
                                    <i class="bi bi-pencil me-1"></i>Editar
                                </button>
                                <button class="btn btn-sm btn-outline-secondary flex-grow-1" disabled="@(!empresa.Activa)" @onclick="() => GestionarUsuarios(empresa)">
                                    <i class="bi bi-people me-1"></i>Usuarios
                                </button>
                                <button class="btn btn-sm btn-outline-danger" disabled="@guardando" @onclick="() => Eliminar(empresa)" title="Eliminar empresa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-info-circle"></i>
                <span>No hay empresas registradas. Crea una nueva para comenzar.</span>
            </div>
        }
    }
</div>

<!-- Modal de Edición/Creación -->
<div class="modal @(mostrarModal ? "show" : "")" style="display: @(mostrarModal ? "block" : "none");" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">
                    <i class="bi @(edicion.Id == 0 ? "bi-plus-circle" : "bi-pencil-square") me-2"></i>
                    @(edicion.Id == 0 ? "Nueva Empresa" : "Editar Empresa")
                </h5>
                <button type="button" class="btn-close" @onclick="CerrarModal" disabled="@guardando"></button>
            </div>
            <EditForm Model="edicion" OnValidSubmit="Guardar" class="needs-validation">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(modalError))
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@modalError</span>
                        </div>
                    }
                    <div class="mb-3">
                        <label for="empresa-nombre" class="form-label">
                            <strong>Nombre de la Empresa</strong>
                            <span class="text-danger">*</span>
                        </label>
                        <InputText id="empresa-nombre" class="form-control form-control-lg" 
                                   @bind-Value="edicion.Nombre" placeholder="Ej: Enerfone Solutions" />
                        <ValidationMessage For="@(() => edicion.Nombre)" class="text-danger small mt-1" />
                    </div>

                    <div class="form-check form-switch mb-3">
                        <InputCheckbox id="empresa-activa" class="form-check-input" @bind-Value="edicion.Activa" />
                        <label class="form-check-label" for="empresa-activa">
                            <strong>Empresa Activa</strong>
                            <br />
                            <small class="text-muted">Los usuarios solo pueden acceder a empresas activas</small>
                        </label>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <InputCheckbox id="empresa-optime" class="form-check-input" @bind-Value="formularioOptimeHabilitado" />
                        <label class="form-check-label" for="empresa-optime">
                            <strong>Habilitar Formulario de Optime</strong>
                            <br />
                            <small class="text-muted">Permite a esta empresa captar colaboradores a través del formulario de Optime</small>
                        </label>
                    </div>

                    @if (edicion.Id > 0)
                    {
                        <div class="alert alert-info d-flex gap-2">
                            <i class="bi bi-info-circle flex-shrink-0"></i>
                            <div>
                                <strong>Información de la Ficha</strong>
                                <br />
                                <small>ID de la empresa: <strong>@edicion.Id</strong></small>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModal" disabled="@guardando">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        @(edicion.Id == 0 ? "Crear Empresa" : "Guardar Cambios")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@if (mostrarModal)
{
    <div class="modal-backdrop fade show"></div>
}

<style>
    .empresa-card {
        border: 1px solid #e9ecef;
        cursor: default;
    }
    
    .empresa-card:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        transform: translateY(-2px);
    }

    .modal.show {
        animation: slideIn 0.3s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-50px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private bool cargando = true;
    private bool guardando;
    private bool mostrarModal;
    private string? error;
    private string? modalError;
    private Empresa edicion = new();
    private List<Empresa> empresas = new();
    private bool formularioOptimeHabilitado;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthService.CargarSesionAsync();
        if (AuthService.EsSuperAdmin)
        {
            try 
            { 
                empresas = await EmpresaService.ObtenerTodasAsync();
            }
            catch 
            { 
                error = "No se pudieron cargar las empresas. Compruebe la migración de la base de datos.";
            }
        }
        cargando = false;
        StateHasChanged();
    }

    private async Task AbrirModal()
    {
        edicion = new Empresa { Activa = true };
        formularioOptimeHabilitado = false;
        modalError = null;
        mostrarModal = true;
        await Task.CompletedTask;
    }

    private async Task AbrirModalEdicion(Empresa empresa)
    {
        edicion = new Empresa 
        { 
            Id = empresa.Id, 
            Nombre = empresa.Nombre, 
            Activa = empresa.Activa,
            FormularioOptimeHabilitado = empresa.FormularioOptimeHabilitado
        };
        formularioOptimeHabilitado = empresa.FormularioOptimeHabilitado;
        modalError = null;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        modalError = null;
    }

    private async Task Guardar()
    {
        guardando = true;
        modalError = null;
        try
        {
            // Actualizar el estado de Optime antes de guardar
            edicion.FormularioOptimeHabilitado = formularioOptimeHabilitado;
            await EmpresaService.GuardarAsync(edicion);
            
            empresas = await EmpresaService.ObtenerTodasAsync();
            CerrarModal();
            error = null;
        }
        catch (Exception ex) 
        { 
            modalError = ex.Message;
        }
        finally 
        { 
            guardando = false;
        }
    }

    private async Task Eliminar(Empresa empresa)
    {
        if (!confirm($"¿Está seguro de que desea eliminar la empresa '{empresa.Nombre}'?"))
            return;

        guardando = true;
        error = null;
        try
        {
            // Asumiendo que el servicio tiene un método Delete
            // await EmpresaService.EliminarAsync(empresa.Id);
            error = "La funcionalidad de eliminación no está disponible en esta versión.";
            empresas = await EmpresaService.ObtenerTodasAsync();
        }
        catch (Exception ex) 
        { 
            error = ex.Message;
        }
        finally 
        { 
            guardando = false;
        }
    }

    private async Task GestionarUsuarios(Empresa empresa)
    {
        try
        {
            await AuthService.SeleccionarEmpresaAsync(empresa.Id);
            Navigation.NavigateTo("/usuarios", forceLoad: true);
        }
        catch (Exception ex) 
        { 
            error = ex.Message;
        }
    }

    private bool confirm(string mensaje)
    {
        return true;
    }
}