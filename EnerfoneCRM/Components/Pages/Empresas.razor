@page "/empresas"
@layout Layout.MainLayout
@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@inject AuthService AuthService
@inject EmpresaService EmpresaService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Empresas - Voltia Solutions</PageTitle>

<div class="container-fluid p-4">
    @if (cargando)
    {
        <div class="spinner-border" role="status"><span class="visually-hidden">Cargando...</span></div>
    }
    else if (!AuthService.EsSuperAdmin)
    {
        <div class="alert alert-danger">Solo superadmin puede gestionar empresas.</div>
    }
    else
    {
        <h2><i class="bi bi-buildings me-2"></i>Empresas</h2>
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        <EditForm Model="edicion" OnValidSubmit="Guardar" class="row g-3 align-items-end my-3">
            <DataAnnotationsValidator />
            <div class="col-12 col-md-7">
                <label for="empresa-nombre" class="form-label">Nombre</label>
                <InputText id="empresa-nombre" class="form-control" @bind-Value="edicion.Nombre" />
                <ValidationMessage For="@(() => edicion.Nombre)" />
            </div>
            <div class="col-auto">
                <div class="form-check form-switch mb-2">
                    <InputCheckbox id="empresa-activa" class="form-check-input" @bind-Value="edicion.Activa" />
                    <label for="empresa-activa" class="form-check-label">Activa</label>
                </div>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@guardando" title="Guardar empresa" aria-label="Guardar empresa"><i class="bi bi-save"></i></button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Nueva" title="Nueva empresa" aria-label="Nueva empresa"><i class="bi bi-plus-lg"></i></button>
            </div>
        </EditForm>
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead><tr><th>Empresa</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var empresa in empresas)
                    {
                        <tr>
                            <td>@empresa.Nombre</td>
                            <td>@(empresa.Activa ? "Activa" : "Inactiva")</td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => Editar(empresa)" title="Editar empresa" aria-label="Editar empresa"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-outline-primary btn-sm" disabled="@(!empresa.Activa)" @onclick="() => GestionarUsuarios(empresa)" title="Gestionar usuarios" aria-label="Gestionar usuarios"><i class="bi bi-people"></i></button>
                            </td>
                        </tr>
                    }
                    @if (empresas.Count == 0)
                    {
                        <tr><td colspan="3">No hay empresas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private bool cargando = true;
    private bool guardando;
    private string? error;
    private Empresa edicion = new();
    private List<Empresa> empresas = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await AuthService.CargarSesionAsync();
        if (AuthService.EsSuperAdmin)
        {
            try { empresas = await EmpresaService.ObtenerTodasAsync(); }
            catch { error = "No se pudieron cargar las empresas. Compruebe la migracion de la base de datos."; }
        }
        cargando = false;
        StateHasChanged();
    }

    private void Nueva() { edicion = new(); error = null; }
    private void Editar(Empresa empresa) => edicion = new Empresa { Id = empresa.Id, Nombre = empresa.Nombre, Activa = empresa.Activa };

    private async Task Guardar()
    {
        guardando = true;
        error = null;
        try
        {
            await EmpresaService.GuardarAsync(edicion);
            empresas = await EmpresaService.ObtenerTodasAsync();
            Nueva();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { guardando = false; }
    }

    private async Task GestionarUsuarios(Empresa empresa)
    {
        try
        {
            await AuthService.SeleccionarEmpresaAsync(empresa.Id);
            Navigation.NavigateTo("/usuarios", forceLoad: true);
        }
        catch (Exception ex) { error = ex.Message; }
    }
}