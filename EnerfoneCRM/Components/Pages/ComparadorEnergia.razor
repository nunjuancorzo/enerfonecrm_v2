    private async Task AplicarFacturaImportadaAsync(FacturaImportada factura)
    {
        var errores = FacturaImportacionService.ValidarParaAplicar(factura);
        if (errores.Count > 0) throw new ArgumentException(string.Join(" ", errores));
        var suministro = factura.Obtener("tipo_suministro") ?? tipoSuministro;
        var tipoClienteAnterior = tipoCliente;
        NuevaComparacion();
        tipoCliente = tipoClienteAnterior;
        await CambiarSuministro(suministro);
        cups = factura.Obtener("cups") ?? string.Empty;
        companiaActual = factura.Obtener("comercializadora_actual") ?? string.Empty;
        if (!string.IsNullOrEmpty(companiaActual) && !listadoCompanias.Contains(companiaActual)) listadoCompanias.Add(companiaActual);
        var peaje = factura.Obtener(suministro == "Gas" ? "peaje_gas" : "peaje_luz");
        if (suministro == "Gas") tarifaActual = peaje ?? string.Empty;
        else
        {
            var normalizado = ComparadorCalculoService.NormalizarPeaje(peaje);
            tarifaActual = normalizado is "2.0" or "3.0" or "6.1" ? normalizado + "TD" : string.Empty;
        }
        nombreCliente = factura.Obtener("nombre_cliente") ?? string.Empty;
        emailCliente = factura.Obtener("email_cliente") ?? string.Empty;
        direccionCliente = factura.Obtener("direccion_cliente") ?? string.Empty;
        fechaInicioFacturacion = FacturaImportacionService.TryFecha(factura.Obtener("fecha_inicio"), out var inicio) ? inicio : null;
        fechaFinFacturacion = FacturaImportacionService.TryFecha(factura.Obtener("fecha_fin"), out var fin) ? fin : null;
        totalFacturaActual = NumeroImportado(factura, "total_factura");
        alquilerContador = NumeroImportado(factura, "alquiler_contador");
        otrosConceptos = NumeroImportado(factura, "otros_conceptos");
        porcentajeIVA = NumeroImportado(factura, "iva_porcentaje") ?? 21m;
        porcentajeImpuestoElectricidad = NumeroImportado(factura, "impuesto_electricidad_porcentaje") ?? 5.11m;
        impuestoHidrocarburosGas = NumeroImportado(factura, "impuesto_hidrocarburos_kwh") ?? 0.00234m;
        excedentes = NumeroImportado(factura, "excedentes_kwh");
        excesoPotencia = NumeroImportado(factura, "exceso_potencia");
        energiaReactiva = NumeroImportado(factura, "energia_reactiva");
        financiacionBonoSocial = NumeroImportado(factura, "bono_social");

        var potencias = Enumerable.Range(1, 6).Select(indice => NumeroImportado(factura, $"potencia_p{indice}")).ToArray();
        var consumos = Enumerable.Range(1, 6).Select(indice => NumeroImportado(factura, $"consumo_p{indice}")).ToArray();
        var unidad = factura.Obtener("unidad_potencia");
        var factorPotencia = unidad == "mes" ? 12m / 365m : unidad == "ano" ? 1m / 365m : 1m;
        preciosPotenciaImportados = Enumerable.Range(1, 6).Select(indice => (NumeroImportado(factura, $"precio_potencia_p{indice}") ?? 0) * factorPotencia).ToList();
        preciosEnergiaImportados = Enumerable.Range(1, 6).Select(indice => NumeroImportado(factura, $"precio_energia_p{indice}") ?? 0).ToList();
        potenciaPunta = potencias[0]; potenciaValle = potencias[1];
        potenciaP1 = potencias[0]; potenciaP2 = potencias[1]; potenciaP3 = potencias[2];
        potenciaP4 = potencias[3]; potenciaP5 = potencias[4]; potenciaP6 = potencias[5];
        consumoPunta = consumos[0]; consumoLlano = consumos[1]; consumoValle = consumos[2];
        consumoP1 = consumos[0]; consumoP2 = consumos[1]; consumoP3 = consumos[2];
        consumoP4 = consumos[3]; consumoP5 = consumos[4]; consumoP6 = consumos[5];
        precioPotenciaPunta = preciosPotenciaImportados[0]; precioPotenciaValle = preciosPotenciaImportados[1];
        precioConsumoPunta = preciosEnergiaImportados[0]; precioConsumoLlano = preciosEnergiaImportados[1]; precioConsumoValle = preciosEnergiaImportados[2];
        if (suministro == "Gas") consumoGas = NumeroImportado(factura, "consumo_total");

        mensajeExito = "Datos revisados importados. La comparativa no se ha calculado ni guardado.";
        var avisos = new List<string>();
        if (string.IsNullOrEmpty(companiaActual) || string.IsNullOrEmpty(tarifaActual)) avisos.Add("Falta confirmar comercializadora o peaje.");
        if (!fechaInicioFacturacion.HasValue || !fechaFinFacturacion.HasValue || !totalFacturaActual.HasValue) avisos.Add("Faltan datos de facturación obligatorios.");
        if (suministro == "Luz")
        {
            var numeroPotencias = tarifaActual == "2.0TD" ? 2 : 6;
            var numeroConsumos = tarifaActual == "2.0TD" ? 3 : 6;
            if (potencias.Take(numeroPotencias).Any(valor => !valor.HasValue) || consumos.Take(numeroConsumos).Any(valor => !valor.HasValue))
                avisos.Add("Faltan potencias o consumos por periodo. El consumo total no se ha repartido automáticamente.");
        }
        else avisos.Add("Confirma la unidad del término fijo de las tarifas de gas; no se deduce de la factura actual.");
        if (string.IsNullOrWhiteSpace(factura.Obtener("iva_porcentaje"))) avisos.Add("IVA no identificado: confirma el porcentaje antes de calcular.");
        if (suministro == "Luz" && string.IsNullOrWhiteSpace(factura.Obtener("impuesto_electricidad_porcentaje")))
            avisos.Add("Confirma el impuesto eléctrico; no se ha identificado en la factura.");
        if (suministro == "Gas" && string.IsNullOrWhiteSpace(factura.Obtener("impuesto_hidrocarburos_kwh")))
            avisos.Add("Confirma el impuesto de hidrocarburos; no se ha identificado en la factura.");
        mensajeAviso = string.Join(" ", avisos);
    }

