                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Impuesto electricidad</label>
                                    <div class="input-group">
                                        <input type="number" 
                                               class="form-control text-end" 
                                               @bind="porcentajeImpuestoElectricidad"
                                               step="0.001"
                                               placeholder="5,113"
                                               style="text-align: right;" />
