    private string NotasComparativa => mensajeAviso + (tipoSuministro == "Gas"
        ? $" Término fijo de tarifas interpretado en {(unidadTerminoFijoGas == "Mensual" ? "€/mes" : "€/día")}." : string.Empty);

    private List<decimal> PotenciasParaPdf => tipoSuministro == "Gas" ? new()
        : tarifaActual == "2.0TD" ? new() { potenciaPunta ?? 0, potenciaValle ?? 0 }
        : new() { potenciaP1 ?? 0, potenciaP2 ?? 0, potenciaP3 ?? 0, potenciaP4 ?? 0, potenciaP5 ?? 0, potenciaP6 ?? 0 };

    private decimal ConsumoAnualParaPdf
    {
        get
        {
            if (tipoSuministro == "Luz" && consumoAnual > 0) return consumoAnual.Value;
            var dias = fechaFinFacturacion.HasValue && fechaInicioFacturacion.HasValue
                ? fechaFinFacturacion.Value.DayNumber - fechaInicioFacturacion.Value.DayNumber : 0;
            var consumoPeriodo = tipoSuministro == "Gas" ? consumoGas ?? 0
                : tarifaActual == "2.0TD" ? (consumoPunta ?? 0) + (consumoLlano ?? 0) + (consumoValle ?? 0)
                : (consumoP1 ?? 0) + (consumoP2 ?? 0) + (consumoP3 ?? 0) + (consumoP4 ?? 0) + (consumoP5 ?? 0) + (consumoP6 ?? 0);
            return dias > 0 ? consumoPeriodo * 365m / dias : 0;
        }
    }

