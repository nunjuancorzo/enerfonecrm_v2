    private bool ValidarPaso4Nuevo()
    {
        // Validar que las potencias sean mayores que 0
        if (!potenciaPunta.HasValue || potenciaPunta.Value <= 0 || !potenciaValle.HasValue || potenciaValle.Value <= 0)
            return false;

        return true;
    }

    // MÉTODOS DE VALIDACIÓN ANTIGUOS (mantener para compatibilidad temporal)

    private bool ValidarPaso3()
    {
        if (string.IsNullOrWhiteSpace(nombreCliente))
            return false;

        if (string.IsNullOrWhiteSpace(emailCliente))
            return false;

        // Validar formato de email básico
        if (!emailCliente.Contains("@") || !emailCliente.Contains("."))
            return false;

        if (string.IsNullOrWhiteSpace(direccionCliente))
            return false;

        // Si el switch de consultor está activo, validar esos datos también
        if (mostrarDatosConsultor)
        {
            if (string.IsNullOrWhiteSpace(nombreConsultor))
                return false;

            if (string.IsNullOrWhiteSpace(telefonoConsultor))
                return false;

            // Validar que el teléfono tenga al menos 9 dígitos
            var digitosTelefono = new string(telefonoConsultor.Where(char.IsDigit).ToArray());
            if (digitosTelefono.Length < 9)
                return false;

            if (string.IsNullOrWhiteSpace(emailConsultor))
                return false;

            // Validar formato de email del consultor
            if (!emailConsultor.Contains("@") || !emailConsultor.Contains("."))
                return false;
        }

        return true;
    }

    private bool ValidarPaso4()
    {
        // Validar que el consumo anual sea mayor que 0
        if (!consumoAnual.HasValue || consumoAnual.Value <= 0)
            return false;

        // Validar que las potencias tengan valor
        if (!potenciaPunta.HasValue || potenciaPunta.Value <= 0)
            return false;
        
        if (!potenciaValle.HasValue || potenciaValle.Value <= 0)
            return false;

        // En facturación diaria, las fechas son obligatorias.
        if (tipoFacturacionPotencia == "Diaria" && (!fechaInicioFacturacion.HasValue || !fechaFinFacturacion.HasValue))
            return false;

        // Si ambas fechas existen, validar coherencia.
        if (fechaInicioFacturacion.HasValue && fechaFinFacturacion.HasValue &&
            fechaFinFacturacion.Value <= fechaInicioFacturacion.Value)
            return false;

        return true;
    }

    private string ObtenerUnidadFacturacionPotencia()
    {
        return tipoFacturacionPotencia switch
        {
            "Mensual" => "€/kW/mes",
            "Anual" => "€/kW/año",
            _ => "€/kW/día"
        };
    }

    private decimal ObtenerFactorFacturacionPotenciaAMensual()
    {
        return tipoFacturacionPotencia switch
        {
            "Mensual" => 1m,
            "Anual" => 1m / 12m,
            _ => ObtenerDiasFacturacion()
        };
    }

    private decimal ObtenerDiasFacturacion()
    {
        if (fechaInicioFacturacion.HasValue && fechaFinFacturacion.HasValue)
        {
            var dias = (decimal)(fechaFinFacturacion.Value.DayNumber - fechaInicioFacturacion.Value.DayNumber + 1);
            if (dias > 0)
            {
                // Devolver los días REALES de facturación
                // Fórmula correcta según comparador PHP/JS: potencia × precio × días
                return dias;
            }
        }

        // Si no hay fechas, usar 30 días como defecto
        return 30m;
    }

    private bool TarifaCompatibleConTipoCliente(string? tipoClienteDeTarifa)
    {
        // Mapeo correcto: Particular → Residencial, Empresa → Pyme
        // En la BD: tipo_cliente = "Residencial" o "Pyme"
        var tipoClienteNormalizado = NormalizarTexto(tipoCliente);
        var tipoClienteTarifa = NormalizarTexto(tipoClienteDeTarifa);

        // Si la tarifa no tiene tipo_cliente definido, no se descarta
        if (string.IsNullOrWhiteSpace(tipoClienteTarifa))
            return true;

        // Mapeo: "particular" del formulario → "residencial" de la BD
        if (tipoClienteNormalizado == "particular")
            return tipoClienteTarifa == "residencial" || tipoClienteTarifa == "particular";

        // Mapeo: "empresa" del formulario → "pyme" de la BD
        if (tipoClienteNormalizado == "empresa")
            return tipoClienteTarifa == "pyme" || tipoClienteTarifa == "empresa" || tipoClienteTarifa == "autonomo";

        // Si no coincide con ninguno, permitir por defecto
        return true;
    }

    private static string NormalizarTexto(string? valor)
    {
        if (string.IsNullOrWhiteSpace(valor))
            return string.Empty;

        return valor
            .Trim()
            .ToLowerInvariant()
            .Replace("á", "a")
            .Replace("é", "e")
            .Replace("í", "i")
            .Replace("ó", "o")
            .Replace("ú", "u");
    }

    private bool ValidarPaso5()
    {
        // Validar que las potencias sean mayores que 0
        if (potenciaPunta <= 0 || potenciaValle <= 0)
            return false;

        // Validar que los precios de potencia sean mayores o iguales a 0
        if (precioPotenciaPunta < 0 || precioPotenciaValle < 0)
            return false;

        // Validar que el descuento esté entre 0 y 100
        if (descuentoPotencia < 0 || descuentoPotencia > 100)
            return false;

        return true;
    }

    private bool ValidarPaso7()
    {
        // Validar que al menos un consumo sea mayor que 0
        if (consumoPunta <= 0 && consumoLlano <= 0 && consumoValle <= 0)
            return false;

        // Validar que los precios de consumo sean mayores o iguales a 0
        if (precioConsumoPunta < 0 || precioConsumoLlano < 0 || precioConsumoValle < 0)
            return false;

        // Validar que el descuento esté entre 0 y 100
        if (descuentoConsumo < 0 || descuentoConsumo > 100)
            return false;

        return true;
    }

    private async Task CalcularComparativaGas()
    {
        if (consumoGas is null or <= 0 || string.IsNullOrEmpty(unidadTerminoFijoGas) ||
            porcentajeIVA < 0 || porcentajeIVA > 100 || impuestoHidrocarburosGas < 0 ||
            alquilerContador < 0 || otrosConceptos < 0)
        {
            mensajeError = "Introduce el consumo de gas, confirma la unidad del término fijo y revisa los impuestos e importes.";
            return;
        }

        var factura = new DatosFacturaGas
        {
            FechaInicio = fechaInicioFacturacion!.Value,
            FechaFin = fechaFinFacturacion!.Value,
            TotalReportado = totalFacturaActual!.Value,
            ConsumoKwh = consumoGas.Value,
            TerminoFijoMensual = unidadTerminoFijoGas == "Mensual",
            PorcentajeIVA = porcentajeIVA,
            ImpuestoHidrocarburosPorKwh = impuestoHidrocarburosGas,
            AlquilerEquipos = alquilerContador ?? 0,
            OtrosConceptos = otrosConceptos ?? 0
        };
        var tarifas = await TarifaGasService.ObtenerActivasAsync();
        var factorMensual = 365m / ((factura.FechaFin.DayNumber - factura.FechaInicio.DayNumber) * 12m);
        var descartadas = 0;
        comercializadoras.Clear();
        foreach (var tarifa in tarifas)
        {
            if (!TarifaCompatibleConTipoCliente(tarifa.TipoCliente) ||
                ComparadorCalculoService.NormalizarPeaje(tarifa.PeajeGas).Replace("RL.", "RL") !=
                ComparadorCalculoService.NormalizarPeaje(tarifaActual).Replace("RL.", "RL")) continue;

            ResultadoCalculoComparativa resultado;
            try
            {
                resultado = ComparadorCalculoService.CalcularComparativaGas(factura, tarifa);
            }
            catch (ArgumentException)
            {
                descartadas++;
                continue;
            }
            comercializadoras.Add(new ResultadoComparativa
            {
                IdTarifa = tarifa.Id,
                Empresa = tarifa.Empresa,
                NombreTarifa = tarifa.Nombre,
                CosteTerminoFijo = resultado.Totals.TotalFixedNaturgy * factorMensual,
                CosteEnergia = resultado.Totals.TotalEnergyNaturgy * factorMensual,
                CosteTotal = resultado.Totals.TotalNaturgy,
                CosteMensual = resultado.Totals.TotalNaturgy * factorMensual,
                CosteActual = resultado.Totals.TotalCurrent * factorMensual,
                AhorroMensual = resultado.Totals.SavingMonthly,
                AhorroAnual = resultado.Totals.SavingAnnual,
                PorcentajeAhorro = resultado.Totals.SavingPercentCurrent
            });
        }
        mensajeAviso = "Estimación con precios base; descuentos comerciales, permanencias y servicios adicionales de la tarifa no incluidos.";
        if (descartadas > 0) mensajeAviso += $" Se han excluido {descartadas} tarifas con precios incompletos o no numéricos.";
        var ofertasAntesFiltro = comercializadoras.Count;
        if (mostrarSoloOfertasConAhorro) comercializadoras = comercializadoras.Where(oferta => oferta.AhorroMensual > 0).ToList();
        comercializadoras = comercializadoras.OrderByDescending(oferta => oferta.AhorroMensual).ToList();
        resultadosCalculados = true;
        if (comercializadoras.Count > 0)
            mensajeExito = $"Se encontraron {comercializadoras.Count} ofertas de gas disponibles.";
        else
            mensajeError = ofertasAntesFiltro > 0 ? "Ninguna oferta de gas genera ahorro. Desactiva el filtro para ver todas las opciones." : "No se encontraron tarifas de gas válidas para el peaje y tipo de cliente seleccionados.";
    }

    private Task CompararTarifas() => CalcularComparativa();

