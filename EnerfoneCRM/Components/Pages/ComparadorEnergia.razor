    private async Task VerOfertas()
    {
        // Validar todos los pasos
        mensajeError = string.Empty;
        List<string> errores = new();

        // Validar Paso 1: CUPS
        if (string.IsNullOrWhiteSpace(cups))
            errores.Add("Paso 1: El CUPS es obligatorio");

        // Validar Paso 3: Datos del cliente
        if (string.IsNullOrWhiteSpace(nombreCliente))
            errores.Add("Paso 3: El nombre del cliente es obligatorio");
        if (string.IsNullOrWhiteSpace(emailCliente) || !emailCliente.Contains("@"))
            errores.Add("Paso 3: El email del cliente es inválido");
        if (string.IsNullOrWhiteSpace(direccionCliente))
            errores.Add("Paso 3: La dirección del cliente es obligatoria");

        // Validar consultor si está activo
        if (mostrarDatosConsultor)
        {
            if (string.IsNullOrWhiteSpace(nombreConsultor))
                errores.Add("Paso 3: El nombre del consultor es obligatorio");
            if (string.IsNullOrWhiteSpace(telefonoConsultor))
                errores.Add("Paso 3: El teléfono del consultor es obligatorio");
            if (string.IsNullOrWhiteSpace(emailConsultor) || !emailConsultor.Contains("@"))
                errores.Add("Paso 3: El email del consultor es inválido");
        }

        // Validar Paso 4: Consumo anual y facturación
        if (!consumoAnual.HasValue || consumoAnual.Value <= 0)
            errores.Add("Paso 4: El consumo anual debe ser mayor que 0");
        if (tipoFacturacionPotencia == "Diaria" && (!fechaInicioFacturacion.HasValue || !fechaFinFacturacion.HasValue))
            errores.Add("Paso 4: Para facturación diaria, las fechas de facturación son obligatorias");
        if (fechaInicioFacturacion.HasValue && fechaFinFacturacion.HasValue && 
            fechaFinFacturacion.Value <= fechaInicioFacturacion.Value)
            errores.Add("Paso 4: La fecha de fin debe ser posterior a la de inicio");

        // Validar Paso 5: Potencia
        if (!potenciaPunta.HasValue || potenciaPunta.Value <= 0 || !potenciaValle.HasValue || potenciaValle.Value <= 0)
            errores.Add("Paso 5: Las potencias Punta y Valle son obligatorias");
        if ((precioPotenciaPunta.HasValue && precioPotenciaPunta.Value < 0) || (precioPotenciaValle.HasValue && precioPotenciaValle.Value < 0))
            errores.Add("Paso 5: Los precios de potencia no pueden ser negativos");

        // Paso 7: Los consumos por periodo son opcionales
        // Si no hay consumos por periodo, se usará el consumo anual distribuido proporcionalmente

        // Si hay errores, mostrarlos y no continuar
        if (errores.Any())
        {
            mensajeError = string.Join("<br/>", errores);
            return;
        }

        // Calcular directamente las ofertas
        await CalcularComparativa();
    }

    private void OnTipoIVAChanged()
    {
        porcentajeIVA = tipoIVA switch
        {
            "General" => 21,
            "Reducido" => 10,
            "Superreducido" => 4,
            _ => 21
        };
    }

    private void OnConceptoChanged(string concepto, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        
        if (isChecked && !conceptosSeleccionados.Contains(concepto))
        {
            conceptosSeleccionados.Add(concepto);
            // Inicializar importe si no existe
            if (!importesConceptos.ContainsKey(concepto))
            {
                importesConceptos[concepto] = 0;
            }
        }
        else if (!isChecked && conceptosSeleccionados.Contains(concepto))
        {
            conceptosSeleccionados.Remove(concepto);
            importesConceptos.Remove(concepto);
        }
    }
    
    private void ActualizarImporteConcepto(string concepto, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal importe))
        {
            importesConceptos[concepto] = importe;
        }
        else
        {
            importesConceptos[concepto] = 0;
        }
    }

    private void OnOfertaSeleccionada(int posicion, ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        
        if (isChecked && !ofertasSeleccionadas.Contains(posicion))
        {
            ofertasSeleccionadas.Add(posicion);
        }
        else if (!isChecked && ofertasSeleccionadas.Contains(posicion))
        {
            ofertasSeleccionadas.Remove(posicion);
        }
    }

    private async Task CalcularComparativa()
    {
        calculando = true;
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
        mensajeAviso = string.Empty;
        ofertasSeleccionadas.Clear();
        StateHasChanged();

        try
        {
            // Validar que las fechas de facturación estén definidas
            if (!fechaInicioFacturacion.HasValue || !fechaFinFacturacion.HasValue)
            {
                mensajeError = "Las fechas de inicio y fin de facturación son obligatorias";
                calculando = false;
                StateHasChanged();
                return;
            }

            if (fechaFinFacturacion <= fechaInicioFacturacion)
            {
                mensajeError = "La fecha de fin debe ser posterior a la de inicio de facturación.";
                return;
            }

            // Validar que el total de factura esté informado
            if (!totalFacturaActual.HasValue || totalFacturaActual.Value <= 0)
            {
                mensajeError = "El importe pagado de la factura es obligatorio para el cálculo";
                calculando = false;
                StateHasChanged();
                return;
            }

            if (tipoSuministro == "Gas")
            {
                await CalcularComparativaGas();
                return;
            }

            // Validar potencias según peaje
            bool potenciasValidas = false;
            List<decimal> potencias = new();
            List<decimal> preciosPotenciaActual = new();
            
            if (tarifaActual == "2.0TD")
            {
                potenciasValidas = potenciaPunta.HasValue && potenciaPunta.Value > 0 && 
                                  potenciaValle.HasValue && potenciaValle.Value > 0;
                if (potenciasValidas)
                {
                    potencias = new List<decimal> { potenciaPunta!.Value, potenciaValle!.Value };
                    preciosPotenciaActual = new List<decimal> { precioPotenciaPunta ?? 0, precioPotenciaValle ?? 0 };
                }
            }
            else if (tarifaActual == "3.0TD" || tarifaActual == "6.1TD")
            {
                potenciasValidas = potenciaP1.HasValue && potenciaP2.HasValue && potenciaP3.HasValue &&
                                  potenciaP4.HasValue && potenciaP5.HasValue && potenciaP6.HasValue;
                if (potenciasValidas)
                {
                    potencias = new List<decimal> 
                    {
                        potenciaP1!.Value, potenciaP2!.Value, potenciaP3!.Value,
                        potenciaP4!.Value, potenciaP5!.Value, potenciaP6!.Value
                    };
                    // Precios de potencia actual (si no están, usar 0)
                    preciosPotenciaActual = preciosPotenciaImportados.Count == 6 ? preciosPotenciaImportados.ToList() : new List<decimal> { 0, 0, 0, 0, 0, 0 };
                }
            }

            if (!potenciasValidas)
            {
                mensajeError = $"Debes ingresar todas las potencias requeridas para el peaje {tarifaActual}";
                calculando = false;
                StateHasChanged();
                return;
            }

            // Validar consumos
            List<decimal> consumos = new();
            List<decimal> preciosEnergiaActual = new();

            if (tarifaActual == "2.0TD")
            {
                // 3 periodos de energía para 2.0TD
                consumos = new List<decimal> 
                {
                    consumoPunta ?? 0,
                    consumoLlano ?? 0,
                    consumoValle ?? 0
                };
                preciosEnergiaActual = new List<decimal>
                {
                    precioConsumoPunta ?? 0,
                    precioConsumoLlano ?? 0,
                    precioConsumoValle ?? 0
                };
            }
            else
            {
                // 6 periodos para 3.0TD y 6.1TD
                consumos = new List<decimal>
                {
                    consumoP1 ?? 0, consumoP2 ?? 0, consumoP3 ?? 0,
                    consumoP4 ?? 0, consumoP5 ?? 0, consumoP6 ?? 0
                };
                preciosEnergiaActual = preciosEnergiaImportados.Count == 6 ? preciosEnergiaImportados.ToList() : new List<decimal> { 0, 0, 0, 0, 0, 0 };
            }

            // Preparar datos de la factura actual
            if (consumos.Any(consumo => consumo < 0) || consumos.Sum() <= 0 || potencias.Any(potencia => potencia <= 0))
            {
                mensajeError = "Introduce consumos no negativos y potencias positivas para todos los periodos.";
                return;
            }

            var facturaActualDatos = new DatosFacturaActual
            {
                FechaInicio = fechaInicioFacturacion.Value,
                FechaFin = fechaFinFacturacion.Value,
                TotalReportado = totalFacturaActual.Value,
                PotenciasContratadas = potencias,
                PreciosPotencia = preciosPotenciaActual,
                Consumos = consumos,
                PreciosEnergia = preciosEnergiaActual,
                ExcedentesKwh = excedentes ?? 0,
                Conceptos = new ConceptosAdicionales
                {
                    ExcesoPotencia = excesoPotencia ?? 0,
                    EnergiaReactiva = energiaReactiva ?? 0,
                    DerechosExtension = 0,
                    DerechosAcceso = 0,
                    BonoSocial = financiacionBonoSocial ?? 0,
                    Descuentos = 0,
                    AlquilerEquipos = alquilerContador ?? 0,
                    PrecioExcedente = 0.05m // Precio por defecto
                }
            };

            // Preparar reglas de comparativa
            var reglas = new ReglasComparativa
            {
                PorcentajeImpuestoElectrico = porcentajeImpuestoElectricidad,
                PorcentajeIVA = porcentajeIVA,
                PrecioExcedentesNaturgy = 0.06m,
                NaturgyExcessPower = "copy",
                NaturgyReactive = "zero",
                NaturgyExtensionRights = "zero",
                NaturgyAccessRights = "zero",
                NaturgySocialBonus = "copy",
                NaturgyDiscounts = "zero",
                NaturgyMeterRental = "copy"
            };

            // Obtener todas las tarifas de energía
            var todasLasTarifas = await TarifaLuzService.ObtenerActivasAsync();
            
            Console.WriteLine($"[DEBUG Comparador] Total tarifas en BD: {todasLasTarifas.Count}");
            Console.WriteLine($"[DEBUG Comparador] Tarifa seleccionada: {tarifaActual}");
            Console.WriteLine($"[DEBUG Comparador] Tipo cliente: {tipoCliente}");
            
            comercializadoras.Clear();
            int tarifasActivas = 0;
            int tarifasDescartadasTipoCliente = 0;
            int tarifasDescartadasTipoTarifa = 0;
            int tarifasPreciosInvalidos = 0;
            var factorMensual = 365m / ((fechaFinFacturacion.Value.DayNumber - fechaInicioFacturacion.Value.DayNumber) * 12);

            foreach (var tarifa in todasLasTarifas)
            {
                // Solo incluir tarifas activas
                if (!tarifa.Activa)
                    continue;
                    
                tarifasActivas++;

                // Filtrar por tipo de cliente
                if (!TarifaCompatibleConTipoCliente(tarifa.TipoCliente))
                {
                    tarifasDescartadasTipoCliente++;
                    continue;
                }

                // Filtrar por peaje seleccionado
                if (!string.IsNullOrWhiteSpace(tarifaActual))
                {
                    string peajeBuscado = ComparadorCalculoService.NormalizarPeaje(tarifaActual);
                    string peajeTarifa = ComparadorCalculoService.NormalizarPeaje(tarifa.Peaje);
                    
                    if (!string.Equals(peajeTarifa, peajeBuscado, StringComparison.OrdinalIgnoreCase))
                    {
                        tarifasDescartadasTipoTarifa++;
                        continue;
                    }
                }

                DatosTarifaNaturgy tarifaNaturgyDatos;
                try
                {
                    tarifaNaturgyDatos = ComparadorCalculoService.PrepararTarifaLuz(tarifa);
                    reglas.PrecioExcedentesNaturgy = excedentes > 0 && !string.IsNullOrWhiteSpace(tarifa.Excedentes)
                        ? ComparadorCalculoService.LeerPrecioTarifa(tarifa.Excedentes, "Excedentes") : 0;
                }
                catch (ArgumentException)
                {
                    tarifasPreciosInvalidos++;
                    continue;
                }

                // Calcular comparativa usando el nuevo servicio
                var resultado = ComparadorCalculoService.CalcularComparativa(
                    facturaActualDatos,
                    tarifaNaturgyDatos,
                    reglas
                );

                if (resultado.Status == "error")
                {
                    tarifasPreciosInvalidos++;
                    continue;
                }

                // Convertir resultado al modelo de vista
                comercializadoras.Add(new ResultadoComparativa
                {
                    IdTarifa = tarifa.Id,
                    Empresa = tarifa.Empresa,
                    NombreTarifa = tarifa.Nombre,
                    CosteTerminoFijo = 0, // El término fijo está incluido en totales
                    CostePotencia = resultado.Totals.TotalPowerNaturgy * factorMensual,
                    CosteEnergia = resultado.Totals.TotalEnergyNaturgy * factorMensual,
                    CosteTotal = resultado.Totals.TotalNaturgy,
                    CosteMensual = resultado.Totals.TotalNaturgy * factorMensual,
                    CosteActual = resultado.Totals.TotalCurrent * factorMensual,
                    AhorroMensual = resultado.Totals.SavingMonthly,
                    AhorroAnual = resultado.Totals.SavingAnnual,
                    PorcentajeAhorro = resultado.Totals.SavingPercentCurrent,
                    PrecioPotenciaPunta = tarifaNaturgyDatos.PreciosPotencia.ElementAtOrDefault(0),
                    PrecioPotenciaValle = tarifaNaturgyDatos.PreciosPotencia.ElementAtOrDefault(1),
                    PrecioEnergiaPunta = tarifaNaturgyDatos.PreciosEnergia.ElementAtOrDefault(0),
                    PrecioEnergiaLlano = tarifaNaturgyDatos.PreciosEnergia.ElementAtOrDefault(1),
                    PrecioEnergiaValle = tarifaNaturgyDatos.PreciosEnergia.ElementAtOrDefault(2),
                    TerminoFijoDiario = 0
                });
            }

            Console.WriteLine($"[DEBUG Comparador] Tarifas activas: {tarifasActivas}");
            Console.WriteLine($"[DEBUG Comparador] Tarifas calculadas: {comercializadoras.Count}");

            mensajeAviso = "Estimación con precios base; descuentos comerciales, permanencias y servicios adicionales de la tarifa no incluidos.";
            if (tarifasPreciosInvalidos > 0)
                mensajeAviso += $" Se han excluido {tarifasPreciosInvalidos} tarifas con precios incompletos o no numéricos.";

            // Filtrar para mostrar solo ofertas con ahorro (si está activado)
            int tarifasAntesAhorro = comercializadoras.Count;
            if (mostrarSoloOfertasConAhorro)
            {
                comercializadoras = comercializadoras.Where(c => c.AhorroMensual > 0).ToList();
                Console.WriteLine($"[DEBUG Comparador] Tarifas con ahorro: {comercializadoras.Count}");
            }

            // Ordenar por mejor ahorro
            comercializadoras = comercializadoras.OrderByDescending(c => c.AhorroMensual).ToList();

            resultadosCalculados = true;
            
            if (comercializadoras.Count == 0)
            {
                if (mostrarSoloOfertasConAhorro && tarifasAntesAhorro > 0)
                {
                    mensajeError = $"Se encontraron {tarifasAntesAhorro} ofertas, pero ninguna genera ahorro. " +
                                  $"Desactiva el filtro 'Mostrar solo ofertas con ahorro' para ver todas las opciones.";
                }
                else
                {
                    mensajeError = "No se encontraron tarifas que cumplan con los criterios de búsqueda.";
                }
            }
            else
            {
                mensajeExito = $"Se encontraron {comercializadoras.Count} ofertas disponibles.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al calcular la comparativa: {ex.Message}<br/>{ex.StackTrace}";
            Console.WriteLine($"[ERROR Comparador] {ex.Message}");
            Console.WriteLine($"[ERROR Comparador] {ex.StackTrace}");
        }
        finally
        {
            calculando = false;
            StateHasChanged();
        }
    }

