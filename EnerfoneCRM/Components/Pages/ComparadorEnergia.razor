@page "/comparador/energia"
@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@using System.Linq
@rendermode InteractiveServer
@inject TarifaLuzService TarifaLuzService
@inject TarifaGasService TarifaGasService
@inject ComercializadoraService ComercializadoraService
@inject SipsService SipsService
@inject AuthService AuthService
@inject PdfComparadorService PdfComparadorService
@inject ComparadorCalculoService ComparadorCalculoService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Comparador de Tarifas de Energía - Enerfone CRM</PageTitle>

@if (cargandoSesion)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    @if (!AuthService.EstaAutenticado)
    {
        <div class="alert alert-warning m-4">
            <i class="bi bi-exclamation-triangle me-2"></i>
            No tienes acceso a esta página. Por favor, inicia sesión.
        </div>
    }
    else
    {
        <div class="container-fluid p-4">
            <div class="row mb-4">
                <div class="col-md-12">
                    <h2 class="mb-0">
                        <i class="bi bi-calculator me-2 text-warning"></i>
                        Comparador de Tarifas de Energía
                    </h2>
                    <p class="text-muted">Introduce los datos de tu contrato actual y descubre las tarifas más económicas</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(mensajeExito))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@mensajeExito
                    <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @((MarkupString)mensajeError)
                    <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(mensajeAviso))
            {
                <div class="alert alert-warning" role="alert">@mensajeAviso</div>
            }

            @if (!resultadosCalculados)
            {
                <div class="mb-3"><ImportarFactura OnAplicar="AplicarFacturaImportadaAsync" /></div>
                <!-- Wizard de comparativa -->
                <div class="card shadow-sm mb-4">
                    <div class="card-body p-5">
                                @if (pasoActual == 1)
                        {
                            <div class="d-flex justify-content-center mb-4">
                                <div class="btn-group" role="group" aria-label="Suministro">
                                    <input type="radio" class="btn-check" name="suministro" id="comparativa-luz" checked="@(tipoSuministro == "Luz")" @onchange='() => CambiarSuministro("Luz")' />
                                    <label class="btn btn-outline-warning" for="comparativa-luz"><i class="bi bi-lightning me-2"></i>Luz</label>
                                    <input type="radio" class="btn-check" name="suministro" id="comparativa-gas" checked="@(tipoSuministro == "Gas")" @onchange='() => CambiarSuministro("Gas")' />
                                    <label class="btn btn-outline-warning" for="comparativa-gas"><i class="bi bi-fire me-2"></i>Gas</label>
                                </div>
                            </div>
                            <!-- Título CUPS -->
                            <div class="text-center mb-4">
                                <h4 class="text-muted">Paso 1/3 - Compañía y Tarifa Actual</h4>
                            </div>

                            <!-- Campo CUPS -->
                            <div class="mb-3">
                                <input type="text" 
                                       class="form-control form-control-lg text-center" 
                                       @bind="cups" 
                                       placeholder="Introduce el CUPS (opcional)"
                                       style="border: 2px solid #e0e0e0; border-radius: 10px;" />
                            </div>

                            <!-- Checkbox Consultar SIPS (solo superadmin) -->
                            @if (AuthService.EsSuperAdmin && tipoSuministro == "Luz")
                            {
                                <div class="d-flex justify-content-center mb-5">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" 
                                               type="checkbox" 
                                               role="switch" 
                                               id="switchSips"
                                               checked="@consultarSips"
                                               @onchange="OnConsultarSipsChanged"
                                               disabled="@(string.IsNullOrWhiteSpace(cups))"
                                               style="width: 3rem; height: 1.5rem; cursor: pointer;">
                                        <label class="form-check-label ms-2 fs-6" for="switchSips" style="cursor: pointer;">
                                            Consultar SIPS (autocompletar datos)
                                        </label>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="mb-5"></div>
                            }

                            <!-- Compañía actual y Tarifa -->
                            <div class="row g-4 mb-5">
                                <div class="col-md-6">
                                    <label class="form-label text-muted fw-normal">Compañía actual</label>
                                    <select class="form-select form-select-lg" 
                                            @bind="companiaActual"
                                            style="border: 2px solid #e0e0e0; border-radius: 10px;">
                                        <option value=""></option>
                                        @foreach (var compania in listadoCompanias)
                                        {
                                            <option value="@compania">@compania</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted fw-normal">Tarifa</label>
                                    <select class="form-select form-select-lg" 
                                            @bind="tarifaActual"
                                            style="border: 2px solid #e0e0e0; border-radius: 10px;">
                                        <option value=""></option>
                                        @foreach (var tarifa in PeajesDisponibles)
                                        {
                                            <option value="@tarifa">@tarifa</option>
                                        }
                                        @if (!string.IsNullOrEmpty(tarifaActual) && !PeajesDisponibles.Contains(tarifaActual))
                                        {
                                            <option value="@tarifaActual" selected>@tarifaActual</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- Toggle Particular/Empresa -->
                            <div class="d-flex justify-content-center mb-5">
                                <div class="btn-group" role="group">
                                    <button type="button" 
                                            class="btn btn-lg px-5 @(tipoCliente == "Particular" ? "btn-warning" : "btn-outline-warning")"
                                            @onclick='() => tipoCliente = "Particular"'>
                                        <i class="bi bi-house-door me-2"></i>Particular
                                    </button>
                                    <button type="button" 
                                            class="btn btn-lg px-5 @(tipoCliente == "Empresa" ? "btn-warning" : "btn-outline-warning")"
                                            @onclick='() => tipoCliente = "Empresa"'>
                                        <i class="bi bi-building me-2"></i>Empresa
                                    </button>
                                </div>
                            </div>

                            <!-- Botón de avance -->
                            <div class="d-flex justify-content-center mt-4">
                                <button class="btn btn-warning px-4" 
                                        @onclick="AvanzarPaso1" 
                                        disabled="@(string.IsNullOrWhiteSpace(companiaActual) || string.IsNullOrWhiteSpace(tarifaActual))">
                                    <i class="bi bi-arrow-right me-2"></i>Continuar
                                </button>
                            </div>
                        }
                        else if (pasoActual == 2)
                        {
                            <!-- Título -->
                            <div class="text-center mb-4">
                                <h4 class="fw-bold">Paso 2/3 - Datos del cliente</h4>
                            </div>

                            <!-- Nombre y Email -->
                            <div class="row g-4 mb-4">
                                <div class="col-md-6">
                                    <input type="text" 
                                           class="form-control form-control-lg" 
                                           @bind="nombreCliente" 
                                           placeholder="Nombre completo"
                                           style="border: 2px solid #e0e0e0; border-radius: 10px;" />
                                </div>
                                <div class="col-md-6">
                                    <input type="email" 
                                           class="form-control form-control-lg" 
                                           @bind="emailCliente" 
                                           placeholder="Email"
                                           style="border: 2px solid #e0e0e0; border-radius: 10px;" />
                                </div>
                            </div>

                            <!-- Dirección -->
                            <div class="mb-4">
                                <input type="text" 
                                       class="form-control form-control-lg" 
                                       @bind="direccionCliente" 
                                       placeholder="Dirección completa"
                                       style="border: 2px solid #e0e0e0; border-radius: 10px;" />
                            </div>

                            <!-- Switch: Misma dirección de correspondencia -->
                            <div class="d-flex align-items-center mb-5">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" 
                                           type="checkbox" 
                                           role="switch" 
                                           id="switchDireccion"
                                           @bind="mismaDireccionCorrespondencia"
                                           style="width: 3rem; height: 1.5rem; cursor: pointer;">
                                    <label class="form-check-label ms-2 fs-5" for="switchDireccion" style="cursor: pointer;">
                                        Misma dirección de correspondencia
                                    </label>
                                </div>
                            </div>

                            <!-- Botones de navegación -->
                            <div class="d-flex justify-content-center gap-3 mt-5">
                                <button class="btn btn-outline-warning px-4" 
                                        @onclick="RetrocederPaso">
                                    <i class="bi bi-arrow-left me-2"></i>Atrás
                                </button>
                                <button class="btn btn-warning px-4" 
                                        @onclick="AvanzarPaso2">
                                    <i class="bi bi-arrow-right me-2"></i>Continuar
                                </button>
                            </div>
                        }
                        else if (pasoActual == 3)
                        {
                            <!-- Título -->
                            <div class="text-center mb-4">
                                <h4 class="fw-bold">Paso 3/3 - Datos de facturación y consumo</h4>
                            </div>

                            <!-- Fechas de facturación -->
                            <div class="row g-4 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Inicio facturación</label>
                                    <input type="date" 
                                           class="form-control form-control-lg" 
                                           @bind="fechaInicioFacturacion"
                                           style="border: 2px solid #e0e0e0; border-radius: 10px;" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Fin facturación</label>
                                    <input type="date" 
                                           class="form-control form-control-lg" 
                                           @bind="fechaFinFacturacion"
                                           style="border: 2px solid #e0e0e0; border-radius: 10px;" />
                                </div>
                            </div>

                            <!-- Importe pagado (opcional) -->
                            <div class="row justify-content-center mb-4">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Importe pagado de la factura *</label>
                                    <div class="input-group input-group-lg">
                                        <input type="number"
                                               class="form-control"
                                               @bind="totalFacturaActual"
                                               step="0.01"
                                               min="0"
                                               placeholder="Ej: 59,5"
                                               style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px; text-align: right;" />
                                        <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">€</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Mostrar solo ofertas con ahorro -->
                            <div class="d-flex align-items-center justify-content-center mb-5">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" 
                                           type="checkbox" 
                                           role="switch" 
                                           id="switchAhorro"
                                           @bind="mostrarSoloOfertasConAhorro"
                                           style="width: 3rem; height: 1.5rem; cursor: pointer;">
                                    <label class="form-check-label ms-2 fs-5 fw-bold" for="switchAhorro" style="cursor: pointer;">
                                        Mostrar solo ofertas con ahorro
                                    </label>
                                </div>
                            </div>

                            @if (tipoSuministro == "Gas")
                            {
                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Consumo de la factura (kWh) *</label>
                                        <input type="number" class="form-control" @bind="consumoGas" min="0" step="0.01" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Unidad del término fijo de las tarifas *</label>
                                        <select class="form-select" @bind="unidadTerminoFijoGas">
                                            <option value="">Seleccione...</option>
                                            <option value="Diaria">€/día</option>
                                            <option value="Mensual">€/mes</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">I.V.A. (%)</label>
                                        <select class="form-select" @bind="porcentajeIVA"><option value="0">0</option><option value="5">5</option><option value="10">10</option><option value="21">21</option></select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Impuesto hidrocarburos (€/kWh)</label>
                                        <input type="number" class="form-control" @bind="impuestoHidrocarburosGas" min="0" step="0.00001" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Alquiler de contador del periodo (€)</label>
                                        <input type="number" class="form-control" @bind="alquilerContador" min="0" step="0.01" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Otros conceptos del periodo, antes de IVA (€)</label>
                                        <input type="number" class="form-control" @bind="otrosConceptos" min="0" step="0.01" />
                                    </div>
                                </div>
                            }
                            else
                            {
                            <!-- Consumo anual -->
                            <div class="row justify-content-end mb-4">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-end d-block">Consumo anual</label>
                                    <div class="input-group input-group-lg">
                                        <input type="number" 
                                               class="form-control text-end" 
                                               @bind="consumoAnual"
                                               step="1"
                                               min="0"
                                               placeholder="2110"
                                               style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px;" />
                                        <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">kWh</span>
                                    </div>
                                </div>
                            </div>

                            @if (tarifaActual == "3.0TD" || tarifaActual == "6.1TD")
                            {
                                <div class="row g-3 mb-4">
                                    <div class="col-md-4"><label class="form-label fw-bold">Consumo P1 (kWh)</label><input type="number" class="form-control" @bind="consumoP1" min="0" step="0.01" /></div>
                                    <div class="col-md-4"><label class="form-label fw-bold">Consumo P2 (kWh)</label><input type="number" class="form-control" @bind="consumoP2" min="0" step="0.01" /></div>
                                    <div class="col-md-4"><label class="form-label fw-bold">Consumo P3 (kWh)</label><input type="number" class="form-control" @bind="consumoP3" min="0" step="0.01" /></div>
                                    <div class="col-md-4"><label class="form-label fw-bold">Consumo P4 (kWh)</label><input type="number" class="form-control" @bind="consumoP4" min="0" step="0.01" /></div>
                                    <div class="col-md-4"><label class="form-label fw-bold">Consumo P5 (kWh)</label><input type="number" class="form-control" @bind="consumoP5" min="0" step="0.01" /></div>
                                    <div class="col-md-4"><label class="form-label fw-bold">Consumo P6 (kWh)</label><input type="number" class="form-control" @bind="consumoP6" min="0" step="0.01" /></div>
                                </div>
                            }
                            else
                            {
                            <!-- Consumos por periodo -->
                            <div class="row g-4 mb-4">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Consumo Punta</label>
                                    <input type="number" 
                                           class="form-control form-control-lg text-end" 
                                           @bind="consumoPunta"
                                           step="1"
                                           min="0"
                                           placeholder="79"
                                           style="border: 2px solid #e0e0e0; border-radius: 10px;" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Consumo Llano</label>
                                    <input type="number" 
                                           class="form-control form-control-lg text-end" 
                                           @bind="consumoLlano"
                                           step="1"
                                           min="0"
                                           placeholder="94"
                                           style="border: 2px solid #e0e0e0; border-radius: 10px;" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Consumo Valle</label>
                                    <input type="number" 
                                           class="form-control form-control-lg text-end" 
                                           @bind="consumoValle"
                                           step="1"
                                           min="0"
                                           placeholder="153"
                                           style="border: 2px solid #e0e0e0; border-radius: 10px;" />
                                </div>
                            </div>
                            }

                            <!-- Potencias (dinámicas según tipo de tarifa) -->
                            @if (tarifaActual == "2.0TD")
                            {
                                <!-- Potencias para 2.0TD -->
                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Potencia Punta</label>
                                        <div class="input-group input-group-lg">
                                            <input type="number" 
                                                   class="form-control text-end" 
                                                   @bind="potenciaPunta"
                                                   step="0.01"
                                                   min="0"
                                                   placeholder="7,89"
                                                   style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px;" />
                                            <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">kW</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Potencia Valle</label>
                                        <div class="input-group input-group-lg">
                                            <input type="number" 
                                                   class="form-control text-end" 
                                                   @bind="potenciaValle"
                                                   step="0.01"
                                                   min="0"
                                                   placeholder="7,89"
                                                   style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px;" />
                                            <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">kW</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (tarifaActual == "3.0TD" || tarifaActual == "6.1TD")
                            {
                                <!-- Potencias para 3.0TD y 6.1TD (P1-P6) -->
                                <div class="row g-3 mb-4">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Potencia P1</label>
                                        <div class="input-group">
                                            <input type="number" 
                                                   class="form-control text-end" 
                                                   @bind="potenciaP1"
                                                   step="0.01"
                                                   min="0"
                                                   placeholder="0"
                                                   style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px;" />
                                            <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">kW</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Potencia P2</label>
                                        <div class="input-group">
                                            <input type="number" 
                                                   class="form-control text-end" 
                                                   @bind="potenciaP2"
                                                   step="0.01"
                                                   min="0"
                                                   placeholder="0"
                                                   style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px;" />
                                            <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">kW</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Potencia P3</label>
                                        <div class="input-group">
                                            <input type="number" 
                                                   class="form-control text-end" 
                                                   @bind="potenciaP3"
                                                   step="0.01"
                                                   min="0"
                                                   placeholder="0"
                                                   style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px;" />
                                            <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">kW</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Potencia P4</label>
                                        <div class="input-group">
                                            <input type="number" 
                                                   class="form-control text-end" 
                                                   @bind="potenciaP4"
                                                   step="0.01"
                                                   min="0"
                                                   placeholder="0"
                                                   style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px;" />
                                            <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">kW</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Potencia P5</label>
                                        <div class="input-group">
                                            <input type="number" 
                                                   class="form-control text-end" 
                                                   @bind="potenciaP5"
                                                   step="0.01"
                                                   min="0"
                                                   placeholder="0"
                                                   style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px;" />
                                            <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">kW</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Potencia P6</label>
                                        <div class="input-group">
                                            <input type="number" 
                                                   class="form-control text-end" 
                                                   @bind="potenciaP6"
                                                   step="0.01"
                                                   min="0"
                                                   placeholder="0"
                                                   style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px;" />
                                            <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">kW</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Potencias por defecto (2 periodos) -->
                                <div class="row g-4 mb-4">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">Potencia Punta</label>
                                        <div class="input-group input-group-lg">
                                            <input type="number" 
                                                   class="form-control text-end" 
                                                   @bind="potenciaPunta"
                                                   step="0.01"
                                                   min="0"
                                                   placeholder="7,89"
                                                   style="border: 2px solid #e0e0e0; border-radius: 10px 0 0 10px;" />
                                            <span class="input-group-text" style="border: 2px solid #e0e0e0; border-left: none; border-radius: 0 10px 10px 0; background-color: #f8f9fa;">kW</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
