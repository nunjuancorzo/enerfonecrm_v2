@page "/configuracion-empresa"
@layout Layout.MainLayout
@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@inject AuthService AuthService
@inject ConfiguracionService ConfiguracionService
@inject AparienciaService AparienciaService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Enerfone CRM</PageTitle>

@if (cargandoSesion)
{
    <div class="text-center mt-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (!AuthService.EstaAutenticado)
{
    <div class="text-center mt-5">
        <p>Redirigiendo al login...</p>
    </div>
}
else if (!AuthService.EsAdministrador && !AuthService.EsBackoffice)
{
    <div class="container mt-5">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Acceso Denegado</h4>
            <p>No tienes permisos para acceder a esta sección. Solo los administradores y usuarios con permisos pueden gestionar la configuración.</p>
            <hr>
            <a href="/" class="btn btn-primary">Volver al Inicio</a>
        </div>
    </div>
}
else
{
    <div class="container-fluid mt-4">
        <div class="row mb-4">
            <div class="col">
                <h2 class="fw-bold">Configuración de Empresa</h2>
                <p class="text-muted">Gestiona los datos de tu empresa</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@mensajeExito
                <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
                <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
            </div>
        }

        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        }
        else
        {
            @if (AuthService.EsAdministrador)
            {
                <div class="row mb-4">
                    <div class="col-lg-10 mx-auto">
                        <section class="appearance-panel" aria-labelledby="appearance-title">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                <div>
                                    <h5 id="appearance-title" class="mb-1"><i class="bi bi-palette me-2"></i>Apariencia</h5>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(configuracion.TemaActualizadoPor) || configuracion.TemaActualizadoEn.HasValue)
                                {
                                    <small class="text-muted">
                                        Último cambio: @(configuracion.TemaActualizadoPor ?? "-")
                                        @(configuracion.TemaActualizadoEn?.ToString("dd/MM/yyyy HH:mm") ?? "")
                                    </small>
                                }
                            </div>

                            <div class="row g-3 align-items-stretch">
                                <div class="col-lg-8">
                                    <div class="row row-cols-2 row-cols-md-4 g-2">
                                        @foreach (var paleta in PaletasDisponibles)
                                        {
                                            <div class="col">
                                                <button type="button"
                                                        class="appearance-option @(paletaSeleccionada == paleta.Id ? "selected" : "")"
                                                        aria-pressed="@(paletaSeleccionada == paleta.Id)"
                                                        @onclick="() => PrevisualizarPaleta(paleta.Id)">
                                                    <span class="appearance-swatches" aria-hidden="true">
                                                        <span style="background-color:@paleta.Acento"></span>
                                                        <span style="background-color:@paleta.BarraLateral"></span>
                                                        <span style="background-color:@paleta.Fondo"></span>
                                                    </span>
                                                    <span class="appearance-option-name">@paleta.Nombre</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                                @if (paletaSeleccionada == AparienciaService.PaletaPersonalizada)
                                {
                                    <div class="col-12">
                                        <div class="row g-2 align-items-end appearance-custom-colors">
                                            <div class="col-sm-4">
                                                <label class="form-label small fw-semibold" for="customAccent">Acento principal</label>
                                                <input id="customAccent" type="color" class="form-control form-control-color" @bind="colorAcento" @bind:after="PrevisualizarColoresPersonalizados" />
                                            </div>
                                            <div class="col-sm-4">
                                                <label class="form-label small fw-semibold" for="customSidebar">Barra lateral</label>
                                                <input id="customSidebar" type="color" class="form-control form-control-color" @bind="colorBarra" @bind:after="PrevisualizarColoresPersonalizados" />
                                            </div>
                                            <div class="col-sm-4">
                                                <label class="form-label small fw-semibold" for="customCanvas">Fondo de página</label>
                                                <input id="customCanvas" type="color" class="form-control form-control-color" @bind="colorFondo" @bind:after="PrevisualizarColoresPersonalizados" />
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div class="col-lg-4">
                                    <div class="appearance-preview" aria-label="Vista previa de la paleta seleccionada">
                                        <div class="appearance-preview-sidebar" style="background-color:@PaletaSeleccionada.BarraLateral">
                                            <span></span><span></span><span></span>
                                        </div>
                                        <div class="appearance-preview-content" style="background-color:@PaletaSeleccionada.Fondo">
                                            <strong>Vista previa</strong>
                                            <div class="appearance-preview-row"></div>
                                            <button type="button" class="btn btn-sm mt-2" style="background-color:@PaletaSeleccionada.Acento;color:@PaletaSeleccionada.TextoAccion;border-color:@PaletaSeleccionada.Acento">Acción principal</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                <button type="button" class="btn btn-primary" @onclick="AplicarPaletaAsync" disabled="@(guardandoPaleta || paletaSeleccionada == paletaAplicada)">
                                    @if (guardandoPaleta)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    <i class="bi bi-check2 me-1"></i>Aplicar a la empresa
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelarPrevisualizacion" disabled="@guardandoPaleta">
                                    Cancelar
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="RestaurarPaletaAnteriorAsync" disabled="@guardandoPaleta">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Restaurar anterior
                                </button>
                                <span class="small text-muted ms-lg-auto">Paleta activa: @NombrePaleta(paletaAplicada)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(mensajeApariencia))
                            {
                                <div class="small mt-2 @(errorApariencia ? "text-danger" : "text-success")" role="status">@mensajeApariencia</div>
                            }
                        </section>
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <EditForm Model="@configuracion" OnValidSubmit="GuardarConfiguracion">
                                <DataAnnotationsValidator />

                                <h5 class="mb-3"><i class="bi bi-building me-2"></i>Datos de la Empresa</h5>
                                
                                <div class="row mb-3">
                                    <div class="col-md-8">
                                        <label class="form-label">Nombre de la Empresa *</label>
                                        <InputText class="form-control" @bind-Value="configuracion.NombreEmpresa" />
                                        <ValidationMessage For="@(() => configuracion.NombreEmpresa)" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">CIF/NIF</label>
                                        <InputText class="form-control" @bind-Value="configuracion.Cif" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Dirección</label>
                                    <InputText class="form-control" @bind-Value="configuracion.Direccion" />
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Código Postal</label>
                                        <div class="input-group">
                                            <SelectorCodigoPostal @bind-Value="configuracion.CodigoPostal" maxlength="5"
                                                                  OnSeleccionado="@(codigo => { configuracion.CodigoPostal = codigo.CodigoPostalValor; configuracion.Ciudad = codigo.Ciudad; configuracion.Provincia = codigo.Provincia; })" />
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label">Ciudad</label>
                                        <InputText class="form-control" @bind-Value="configuracion.Ciudad" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Provincia</label>
                                        <InputText class="form-control" @bind-Value="configuracion.Provincia" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">País</label>
                                    <InputText class="form-control" @bind-Value="configuracion.Pais" />
                                </div>

                                <hr class="my-4" />

                                <h5 class="mb-3"><i class="bi bi-envelope me-2"></i>Datos de Contacto</h5>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Teléfono</label>
                                        <InputText class="form-control" @bind-Value="configuracion.Telefono" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Email</label>
                                        <InputText class="form-control" type="email" @bind-Value="configuracion.Email" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Sitio Web</label>
                                    <InputText class="form-control" @bind-Value="configuracion.Web" placeholder="https://www.ejemplo.com" />
                                </div>

                                <hr class="my-4" />

                                <h5 class="mb-3"><i class="bi bi-envelope-at me-2"></i>Configuración de Email SMTP</h5>
                                <p class="text-muted small mb-3">Configura el servidor SMTP para enviar emails desde la aplicación</p>

                                <div class="row mb-3">
                                    <div class="col-md-8">
                                        <label class="form-label">Servidor SMTP</label>
                                        <InputText class="form-control" @bind-Value="configuracion.SmtpServidor" placeholder="smtp.gmail.com" />
                                        <small class="text-muted">Ejemplo: smtp.gmail.com, smtp.office365.com</small>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Puerto</label>
                                        <InputNumber class="form-control" @bind-Value="configuracion.SmtpPuerto" />
                                        <small class="text-muted">Común: 587 o 465</small>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Usuario SMTP</label>
                                        <InputText class="form-control" @bind-Value="configuracion.SmtpUsuario" placeholder="tu-email@ejemplo.com" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Contraseña SMTP</label>
                                        <InputText type="password" class="form-control" @bind-Value="configuracion.SmtpPassword" />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Email Remitente</label>
                                        <InputText class="form-control" type="email" @bind-Value="configuracion.SmtpEmailDesde" placeholder="noreply@ejemplo.com" />
                                        <small class="text-muted">Email que aparecerá como remitente</small>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Nombre Remitente</label>
                                        <InputText class="form-control" @bind-Value="configuracion.SmtpNombreDesde" placeholder="Mi Empresa" />
                                        <small class="text-muted">Nombre que aparecerá como remitente</small>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" id="usarSsl" @bind-Value="configuracion.SmtpUsarSsl" />
                                        <label class="form-check-label" for="usarSsl">
                                            Usar SSL/TLS (recomendado)
                                        </label>
                                    </div>
                                </div>

                                <hr class="my-4" />

                                <h5 class="mb-3"><i class="bi bi-toggles me-2"></i>Control de Módulos</h5>
                                <p class="text-muted small mb-3">Activa o desactiva módulos del sistema</p>

                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <InputCheckbox class="form-check-input" id="moduloLiquidaciones" @bind-Value="configuracion.ModuloLiquidacionesActivo" />
                                        <label class="form-check-label" for="moduloLiquidaciones">
                                            <strong>Módulo de Liquidaciones</strong>
                                            <br />
                                            <small class="text-muted">
                                                Cuando está desactivado, ningún usuario podrá acceder al módulo de liquidaciones. 
                                                Se mostrará un mensaje de módulo en mantenimiento.
                                            </small>
                                        </label>
                                    </div>
                                </div>

                                @if (AuthService.EsSuperAdmin)
                                {
                                    <div class="mb-3">
                                        <div class="form-check form-switch">
                                            <InputCheckbox class="form-check-input" id="moduloSips" @bind-Value="configuracion.ModuloSipsActivo" />
                                            <label class="form-check-label" for="moduloSips">
                                                <strong>Módulo SIPS</strong>
                                                <span class="badge bg-warning text-dark ms-2">Solo SuperAdmin</span>
                                                <br />
                                                <small class="text-muted">
                                                    Control de acceso al módulo SIPS (Sistema de Información de Puntos de Suministro). 
                                                    Cuando está desactivado, ningún usuario podrá acceder a las consultas SIPS.
                                                </small>
                                            </label>
                                        </div>
                                    </div>
                                }

                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <InputCheckbox class="form-check-input" id="envioAutomaticoFirma" @bind-Value="configuracion.EnvioDocumentosFirmaAutomatico" />
                                        <label class="form-check-label" for="envioAutomaticoFirma">
                                            <strong>Enviar automáticamente documentación a firma al crear contratos</strong>
                                            <br />
                                            <small class="text-muted">
                                                Si está desactivado, no se enviará automáticamente al cliente al crear un contrato.
                                                Los botones manuales de envío seguirán funcionando aunque el valor esté desactivado.
                                            </small>
                                        </label>
                                    </div>
                                </div>

                                <hr class="my-4" />

                                <h5 class="mb-3"><i class="bi bi-image me-2"></i>Imagen Corporativa</h5>

                                <div class="mb-3">
                                    <label class="form-label">Logo de la Empresa</label>
                                    <div class="input-group">
                                        <label class="form-control" style="cursor: pointer; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            <InputFile id="logoInput" OnChange="CargarImagen" accept="image/*" style="display: none;" />
                                            @if (string.IsNullOrEmpty(nombreArchivoSeleccionado))
                                            {
                                                <span class="text-muted">Ningún archivo seleccionado</span>
                                            }
                                            else
                                            {
                                                <span>@nombreArchivoSeleccionado</span>
                                            }
                                        </label>
                                        <label for="logoInput" class="btn btn-outline-secondary" style="cursor: pointer;">
                                            <i class="bi bi-upload me-1"></i>Seleccionar archivo
                                        </label>
                                    </div>
                                    <small class="text-muted">Selecciona una imagen (PNG, JPG, GIF). Tamaño máximo recomendado: 500KB</small>
                                </div>

                                @if (!string.IsNullOrEmpty(configuracion.LogoUrl))
                                {
                                    <div class="mb-3">
                                        <label class="form-label">Vista previa del logo:</label>
                                        <div class="border rounded p-3 bg-light text-center">
                                            <img src="@configuracion.LogoUrl" alt="Logo" style="max-width: 300px; max-height: 150px;" class="img-fluid" />
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="EliminarLogo">
                                            <i class="bi bi-trash me-1"></i> Eliminar Logo
                                        </button>
                                    </div>
                                }

                                <div class="d-flex justify-content-between mt-4">
                                    <button type="button" class="btn btn-secondary" @onclick="Cancelar">
                                        <i class="bi bi-x-circle me-1"></i> Cancelar
                                    </button>
                                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                                        @if (guardando)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Guardando...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-save me-1"></i>
                                            <span>Guardar Configuración</span>
                                        }
                                    </button>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool cargandoSesion = true;
    private bool cargando = true;
    private bool guardando = false;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;
    private ConfiguracionEmpresa configuracion = new();
    private string nombreArchivoSeleccionado = string.Empty;
    private string paletaAplicada = AparienciaService.PaletaPredeterminada;
    private string paletaSeleccionada = AparienciaService.PaletaPredeterminada;
    private string colorAcento = AparienciaService.ObtenerBasePersonalizada().Acento;
    private string colorBarra = AparienciaService.ObtenerBasePersonalizada().BarraLateral;
    private string colorFondo = AparienciaService.ObtenerBasePersonalizada().Fondo;
    private bool guardandoPaleta;
    private bool errorApariencia;
    private string mensajeApariencia = string.Empty;
    private IReadOnlyList<PaletaVisual> PaletasDisponibles => AparienciaService.Paletas
        .Append(AparienciaService.CrearPersonalizada(colorAcento, colorBarra, colorFondo))
        .ToArray();
    private PaletaVisual PaletaSeleccionada => AparienciaService.Resolver(paletaSeleccionada, colorAcento, colorBarra, colorFondo);
    private bool HayCambiosDePaleta => paletaSeleccionada != configuracion.TemaVisual ||
        paletaSeleccionada == AparienciaService.PaletaPersonalizada &&
        (colorAcento != configuracion.TemaColorAcento || colorBarra != configuracion.TemaColorBarra || colorFondo != configuracion.TemaColorFondo);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.CargarSesionAsync();
            
            if (!AuthService.EstaAutenticado)
            {
                Navigation.NavigateTo("/login", false);
                return;
            }
            
            if (!AuthService.EsAdministrador && !AuthService.EsBackoffice)
            {
                cargandoSesion = false;
                StateHasChanged();
                return;
            }
            
            cargandoSesion = false;
            await CargarConfiguracion();
            StateHasChanged();
        }
    }

    private async Task CargarConfiguracion()
    {
        cargando = true;
        try
        {
            var config = await ConfiguracionService.ObtenerConfiguracionAsync();
            if (config != null)
            {
                configuracion = config;
            }

            paletaAplicada = AparienciaService.EsPaletaValida(configuracion.TemaVisual)
                ? configuracion.TemaVisual
                : AparienciaService.PaletaPredeterminada;
            paletaSeleccionada = paletaAplicada;
            var paletaPersonalizadaBase = AparienciaService.ObtenerBasePersonalizada();
            colorAcento = AparienciaService.EsColorValido(configuracion.TemaColorAcento) ? configuracion.TemaColorAcento! : paletaPersonalizadaBase.Acento;
            colorBarra = AparienciaService.EsColorValido(configuracion.TemaColorBarra) ? configuracion.TemaColorBarra! : paletaPersonalizadaBase.BarraLateral;
            colorFondo = AparienciaService.EsColorValido(configuracion.TemaColorFondo) ? configuracion.TemaColorFondo! : paletaPersonalizadaBase.Fondo;
            AparienciaService.Aplicar(paletaAplicada, configuracion.TemaColorAcento, configuracion.TemaColorBarra, configuracion.TemaColorFondo);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar la configuración: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarConfiguracion()
    {
        guardando = true;
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        try
        {
            var (exito, mensaje) = await ConfiguracionService.GuardarConfiguracionAsync(configuracion);
            
            if (exito)
            {
                mensajeExito = mensaje;
            }
            else
            {
                mensajeError = mensaje;
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private void PrevisualizarPaleta(string paleta)
    {
        if (!AuthService.EsAdministrador || !AparienciaService.EsPaletaValida(paleta))
            return;

        paletaSeleccionada = paleta;
        mensajeApariencia = string.Empty;
        AplicarPrevisualizacion();
    }

    private void PrevisualizarColoresPersonalizados()
    {
        if (paletaSeleccionada == AparienciaService.PaletaPersonalizada)
            AplicarPrevisualizacion();
    }

    private void AplicarPrevisualizacion() =>
        AparienciaService.Aplicar(paletaSeleccionada, colorAcento, colorBarra, colorFondo);

    private void CancelarPrevisualizacion()
    {
        paletaSeleccionada = paletaAplicada;
        mensajeApariencia = string.Empty;
        AparienciaService.Aplicar(paletaAplicada, configuracion.TemaColorAcento, configuracion.TemaColorBarra, configuracion.TemaColorFondo);
    }

    private async Task AplicarPaletaAsync()
    {
        if (!AuthService.EsAdministrador || guardandoPaleta || !HayCambiosDePaleta)
            return;

        guardandoPaleta = true;
        errorApariencia = false;
        mensajeApariencia = string.Empty;
        try
        {
            var paletaAnterior = AparienciaService.Resolver(
                configuracion.TemaVisual,
                configuracion.TemaColorAcento,
                configuracion.TemaColorBarra,
                configuracion.TemaColorFondo);
            var nuevaPaleta = PaletaSeleccionada;
            var resultado = await ConfiguracionService.GuardarPaletaAsync(
                nuevaPaleta,
                AuthService.UsuarioActual?.NombreUsuario ?? "Administrador");
            if (resultado.exito)
            {
                paletaAplicada = paletaSeleccionada;
                configuracion.TemaVisualAnterior = paletaAnterior.Id;
                configuracion.TemaAnteriorColorAcento = paletaAnterior.Acento;
                configuracion.TemaAnteriorColorBarra = paletaAnterior.BarraLateral;
                configuracion.TemaAnteriorColorFondo = paletaAnterior.Fondo;
                configuracion.TemaVisual = nuevaPaleta.Id;
                if (nuevaPaleta.Id == AparienciaService.PaletaPersonalizada)
                {
                    configuracion.TemaColorAcento = nuevaPaleta.Acento;
                    configuracion.TemaColorBarra = nuevaPaleta.BarraLateral;
                    configuracion.TemaColorFondo = nuevaPaleta.Fondo;
                }
                configuracion.TemaActualizadoPor = AuthService.UsuarioActual?.NombreUsuario;
                configuracion.TemaActualizadoEn = DateTime.Now;
                AparienciaService.Aplicar(nuevaPaleta.Id, nuevaPaleta.Acento, nuevaPaleta.BarraLateral, nuevaPaleta.Fondo);
                mensajeApariencia = resultado.mensaje;
            }
            else
            {
                errorApariencia = true;
                paletaSeleccionada = paletaAplicada;
                AparienciaService.Aplicar(paletaAplicada, configuracion.TemaColorAcento, configuracion.TemaColorBarra, configuracion.TemaColorFondo);
                mensajeApariencia = resultado.mensaje;
            }
        }
        catch (Exception ex)
        {
            errorApariencia = true;
            paletaSeleccionada = paletaAplicada;
            AparienciaService.Aplicar(paletaAplicada, configuracion.TemaColorAcento, configuracion.TemaColorBarra, configuracion.TemaColorFondo);
            mensajeApariencia = $"Error al aplicar la apariencia: {ex.Message}";
        }
        finally
        {
            guardandoPaleta = false;
        }
    }

    private async Task RestaurarPaletaAnteriorAsync()
    {
        var anterior = AparienciaService.Resolver(
            configuracion.TemaVisualAnterior,
            configuracion.TemaAnteriorColorAcento,
            configuracion.TemaAnteriorColorBarra,
            configuracion.TemaAnteriorColorFondo);
        paletaSeleccionada = anterior.Id;
        colorAcento = anterior.Acento;
        colorBarra = anterior.BarraLateral;
        colorFondo = anterior.Fondo;
        AplicarPrevisualizacion();
        if (HayCambiosDePaleta)
            await AplicarPaletaAsync();
        else
            mensajeApariencia = "La paleta ya está aplicada.";
    }

    private string NombrePaleta(string id) =>
        AparienciaService.Paletas.FirstOrDefault(paleta => paleta.Id == id)?.Nombre ?? id;

    private void Cancelar()
    {
        Navigation.NavigateTo("/home", false);
    }

    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        try
        {
            var archivo = e.File;
            nombreArchivoSeleccionado = archivo.Name;
            
            // Validar tamaño (máximo 2MB)
            if (archivo.Size > 2 * 1024 * 1024)
            {
                mensajeError = "El archivo es demasiado grande. Tamaño máximo: 2MB";
                return;
            }

            // Validar tipo de archivo
            if (!archivo.ContentType.StartsWith("image/"))
            {
                mensajeError = "Solo se permiten archivos de imagen";
                return;
            }

            // Leer el archivo y convertir a Base64
            using var stream = archivo.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var bytes = memoryStream.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            
            // Crear data URI con el tipo MIME correcto
            configuracion.LogoUrl = $"data:{archivo.ContentType};base64,{base64}";
            
            mensajeError = string.Empty;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar la imagen: {ex.Message}";
        }
    }

    private void EliminarLogo()
    {
        configuracion.LogoUrl = null;
        nombreArchivoSeleccionado = string.Empty;
        StateHasChanged();
    }
}
