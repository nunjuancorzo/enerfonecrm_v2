    private async Task GuardarCambios()
    {
        try
        {
            guardando = true;
            erroresValidacion.Clear();

            if (!ValidarTarifas())
            {
                mensajeError = "Hay errores de validación. Por favor corrígelos antes de guardar.";
                return;
            }

            using var context = DbContextProvider.CreateDbContext();

            int creados = 0;
            int actualizados = 0;

            foreach (var tarifa in tarifas)
            {
                if (tarifa.Id == 0)
                {
                    context.TarifasLuz.Add(tarifa);
                    creados++;
                }
                else
                {
                    context.TarifasLuz.Update(tarifa);
                    actualizados++;
                }
            }

            await context.SaveChangesAsync();

            mensajeExito = $"Cambios guardados correctamente. {creados} creadas, {actualizados} actualizadas.";

            await CargarTarifas();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar cambios: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private bool ValidarTarifas()
    {
        bool esValido = true;

        for (int i = 0; i < tarifas.Count; i++)
        {
            var tarifa = tarifas[i];

            if (string.IsNullOrWhiteSpace(tarifa.Empresa))
            {
                erroresValidacion.Add($"Fila {i + 1}: La empresa es obligatoria");
                esValido = false;
            }

            if (string.IsNullOrWhiteSpace(tarifa.TipoCliente))
            {
                erroresValidacion.Add($"Fila {i + 1}: El tipo de cliente es obligatorio");
                esValido = false;
            }

            if (string.IsNullOrWhiteSpace(tarifa.Nombre))
            {
                erroresValidacion.Add($"Fila {i + 1}: El nombre es obligatorio");
                esValido = false;
            }
        }

        return esValido;
    }

