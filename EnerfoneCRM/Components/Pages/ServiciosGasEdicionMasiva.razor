@page "/servicios-gas/edicion-masiva"
@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@using Microsoft.JSInterop
@rendermode InteractiveServer
@inject ServicioGasService ServicioGasService
@inject AuthService AuthService
@inject DbContextProvider DbContextProvider
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Edición Masiva de Servicios Gas</PageTitle>

@if (AuthService.UsuarioActual?.Rol != "Administrador")
{
    <div class="container mt-5">
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            No tienes permisos para acceder a esta sección.
        </div>
    </div>
}
else
{
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-fire me-2"></i>Edición Masiva de Servicios Gas</h2>
        <button class="btn btn-outline-secondary" @onclick="@(() => Navigation.NavigateTo("/inicio-rapido"))">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@mensajeError
            <button type="button" class="btn-close" @onclick="@(() => mensajeError = string.Empty)"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@mensajeExito
            <button type="button" class="btn-close" @onclick="@(() => mensajeExito = string.Empty)"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex gap-2 flex-wrap mb-3">
                <button class="btn btn-success" @onclick="AgregarNuevaFila" disabled="@guardando">
                    <i class="bi bi-plus-circle me-2"></i>Nueva Fila
                </button>
                <button class="btn btn-primary" @onclick="CopiarFilasSeleccionadas" disabled="@(guardando || !filasSeleccionadas.Any())">
                    <i class="bi bi-files me-2"></i>Copiar (@filasSeleccionadas.Count)
                </button>
                <button class="btn btn-info" @onclick="PegarFilas" disabled="@guardando">
                    <i class="bi bi-clipboard me-2"></i>Pegar
                </button>
                <button class="btn btn-warning" @onclick="GuardarCambios" disabled="@guardando">
                    @if (guardando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-save me-2"></i>
                    }
                    Guardar Cambios
                </button>
            </div>

            <div class="alert alert-info py-2">
                <small>
                    <strong>Atajos de teclado:</strong>
                    <kbd>Ctrl+C</kbd> Copiar con ID |
                    <kbd>Ctrl+V</kbd> Pegar desde Excel |
                    <strong>Tip:</strong> Copia desde Excel con cabeceras. Si incluyes ID, se actualizarán las filas existentes.
                </small>
            </div>

            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-3">Cargando servicios...</p>
                </div>
            }
            else
            {
                <div class="table-responsive" style="max-height: 70vh; overflow: auto;">
                    <table class="table table-sm table-bordered table-hover mb-0" id="serviciosGasTable" style="table-layout: fixed; width: 100%; min-width: 1200px;">
                        <thead class="table-light sticky-top" style="top: 0; z-index: 10;">
                            <tr>
                                <th style="width: 50px;">
                                    <input type="checkbox" class="form-check-input"
                                           @onchange="ToggleSeleccionarTodas"
                                           checked="@(filasSeleccionadas.Count == servicios.Count && servicios.Any())" />
                                </th>
                                <th style="width: 80px;">ID</th>
                                <th style="width: 200px;">Tipo*</th>
                                <th style="width: 350px;">Nombre Servicio*</th>
                                <th style="width: 150px;">Precio*</th>
                                <th style="width: 250px;">Empresa</th>
                                <th style="width: 100px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (servicio, index) in servicios.Select((s, i) => (s, i)))
                            {
                                <tr class="@(filasSeleccionadas.Contains(index) ? "table-active" : "")">
                                    <td>
                                        <input type="checkbox" class="form-check-input"
                                               checked="@filasSeleccionadas.Contains(index)"
                                               @onchange="@(() => ToggleSeleccionFila(index))" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm"
                                               @bind="servicio.Id" readonly style="background-color: #e9ecef;" />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm"
                                               @bind="servicio.Tipo" placeholder="Tipo" required />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm"
                                               @bind="servicio.NombreServicio" placeholder="Nombre" required />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm"
                                               @bind="servicio.Precio" placeholder="Precio" required />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm"
                                               @bind="servicio.Empresa" placeholder="Empresa" />
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-danger" @onclick="@(() => EliminarFila(index))" disabled="@guardando">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <small class="text-muted">
                        Total de servicios: <strong>@servicios.Count</strong> |
                        Seleccionados: <strong>@filasSeleccionadas.Count</strong>
                    </small>
                </div>
            }
        </div>
    </div>
</div>
}

@code {
    private List<ServicioGas> servicios = new();
    private List<ServicioGas> filasCopia = new();
    private HashSet<int> filasSeleccionadas = new();
    private bool cargando = true;
    private bool guardando = false;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private DotNetObjectReference<ServiciosGasEdicionMasiva>? dotNetReference;

    protected override async Task OnInitializedAsync()
    {
        await CargarServicios();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetReference = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initializeExcelLikePaste", dotNetReference);
        }
    }

    private async Task CargarServicios()
    {
        try
        {
            cargando = true;
            mensajeExito = string.Empty;
            mensajeError = string.Empty;

            var todosLosServicios = await ServicioGasService.ObtenerTodosAsync();
            servicios = todosLosServicios.OrderByDescending(s => s.Id).ToList();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar servicios: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AgregarNuevaFila()
    {
        var nuevoServicio = new ServicioGas
        {
            Id = 0,
            Tipo = string.Empty,
            NombreServicio = string.Empty,
            Precio = string.Empty
        };
        servicios.Insert(0, nuevoServicio);
    }

    private void EliminarFila(int index)
    {
        if (index >= 0 && index < servicios.Count)
        {
            servicios.RemoveAt(index);
        }
    }

    private void ToggleSeleccionFila(int index)
    {
        if (!filasSeleccionadas.Add(index))
        {
            filasSeleccionadas.Remove(index);
        }
    }

    private void ToggleSeleccionarTodas(ChangeEventArgs e)
    {
        if ((bool?)e.Value == true)
        {
            filasSeleccionadas = Enumerable.Range(0, servicios.Count).ToHashSet();
        }
        else
        {
            filasSeleccionadas.Clear();
        }
    }

    private async Task CopiarFilasSeleccionadas()
    {
        filasCopia.Clear();
        var datosParaPortapapeles = new List<string>();

        foreach (var index in filasSeleccionadas.OrderBy(x => x))
        {
            if (index >= 0 && index < servicios.Count)
            {
                var servicioOriginal = servicios[index];

                var copia = new ServicioGas
                {
                    Id = servicioOriginal.Id,
                    Tipo = servicioOriginal.Tipo,
                    NombreServicio = servicioOriginal.NombreServicio,
                    Precio = servicioOriginal.Precio,
                    Empresa = servicioOriginal.Empresa
                };
                filasCopia.Add(copia);

                var fila = string.Join("\t",
                    servicioOriginal.Id.ToString(),
                    servicioOriginal.Tipo ?? "",
                    servicioOriginal.NombreServicio ?? "",
                    servicioOriginal.Precio ?? "",
                    servicioOriginal.Empresa ?? ""
                );
                datosParaPortapapeles.Add(fila);
            }
        }

        if (datosParaPortapapeles.Any())
        {
            var cabeceras = string.Join("\t",
                "ID", "Tipo", "NombreServicio", "Precio", "Empresa"
            );

            var textoConCabeceras = cabeceras + "\n" + string.Join("\n", datosParaPortapapeles);
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", textoConCabeceras);
            mensajeExito = $"✓ {filasCopia.Count} fila(s) copiada(s) con ID. Al pegar, los registros con ID se actualizarán, sin ID se crearán como nuevos.";
        }
        else
        {
            mensajeExito = "No hay filas seleccionadas para copiar.";
        }

        StateHasChanged();
    }

    private async Task PegarFilas()
    {
        try
        {
            var textoPortapapeles = await JSRuntime.InvokeAsync<string>("navigator.clipboard.readText");

            if (string.IsNullOrWhiteSpace(textoPortapapeles))
            {
                mensajeError = "El portapapeles está vacío.";
                return;
            }

            await ProcesarYAgregarFilas(textoPortapapeles);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al leer del portapapeles: {ex.Message}";
        }
    }

    [JSInvokable]
    public async Task PasteRowsFromJS(List<List<string>> rowsData)
    {
        try
        {
            if (rowsData == null || rowsData.Count == 0) return;

            int filasCreadas = 0;
            int filasActualizadas = 0;
            var serviciosNuevos = new List<ServicioGas>();
            var serviciosActualizados = new List<(ServicioGas servicio, int indiceOriginal)>();

            foreach (var rowData in rowsData)
            {
                int idServicio = 0;
                if (rowData.Count > 0 && int.TryParse(rowData[0], out int parsedId))
                {
                    idServicio = parsedId;
                }

                var servicio = new ServicioGas
                {
                    Id = idServicio,
                    Tipo = string.Empty,
                    NombreServicio = string.Empty,
                    Precio = string.Empty
                };

                if (rowData.Count > 1 && !string.IsNullOrWhiteSpace(rowData[1])) servicio.Tipo = rowData[1];
                if (rowData.Count > 2 && !string.IsNullOrWhiteSpace(rowData[2])) servicio.NombreServicio = rowData[2];
                if (rowData.Count > 3 && !string.IsNullOrWhiteSpace(rowData[3])) servicio.Precio = rowData[3];
                if (rowData.Count > 4 && !string.IsNullOrWhiteSpace(rowData[4])) servicio.Empresa = rowData[4];

                if (idServicio > 0)
                {
                    var indiceExistente = servicios.FindIndex(s => s.Id == idServicio);
                    if (indiceExistente >= 0)
                    {
                        ActualizarServicio(servicios[indiceExistente], servicio);
                        serviciosActualizados.Add((servicios[indiceExistente], indiceExistente));
                        filasActualizadas++;
                    }
                    else
                    {
                        serviciosNuevos.Add(servicio);
                        filasCreadas++;
                    }
                }
                else
                {
                    servicio.Id = 0;
                    serviciosNuevos.Add(servicio);
                    filasCreadas++;
                }
            }

            if (serviciosActualizados.Any())
            {
                foreach (var (servicio, indice) in serviciosActualizados.OrderByDescending(x => x.indiceOriginal))
                {
                    servicios.RemoveAt(indice);
                }
                serviciosActualizados.Reverse();
                foreach (var (servicio, _) in serviciosActualizados)
                {
                    servicios.Insert(0, servicio);
                }
            }

            if (serviciosNuevos.Any())
            {
                serviciosNuevos.Reverse();
                foreach (var servicio in serviciosNuevos)
                {
                    servicios.Insert(0, servicio);
                }
            }

            if (filasCreadas > 0 || filasActualizadas > 0)
            {
                var mensajes = new List<string>();
                if (filasCreadas > 0) mensajes.Add($"{filasCreadas} nueva(s)");
                if (filasActualizadas > 0) mensajes.Add($"{filasActualizadas} actualizada(s)");

                mensajeExito = $"✓ {string.Join(" y ", mensajes)} fila(s) al inicio. No olvides guardar.";
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al pegar filas: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task PegarDesdePortapapeles(string textoPortapapeles)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(textoPortapapeles))
            {
                return;
            }

            await ProcesarYAgregarFilas(textoPortapapeles);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al pegar: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ProcesarYAgregarFilas(string textoPortapapeles)
    {
        var lineas = textoPortapapeles.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);

        if (lineas.Length == 0)
        {
            mensajeError = "No hay datos para pegar.";
            return;
        }

        var primeraLinea = lineas[0].Split('\t');
        var esLineaCabecera = primeraLinea.Length > 0 &&
                              primeraLinea[0].Trim().Equals("ID", StringComparison.OrdinalIgnoreCase);

        var indiceInicio = esLineaCabecera ? 1 : 0;

        var rowsData = new List<List<string>>();
        for (int i = indiceInicio; i < lineas.Length; i++)
        {
            var columnas = lineas[i].Split('\t');
            rowsData.Add(columnas.ToList());
        }

        await PasteRowsFromJS(rowsData);
    }

    private void ActualizarServicio(ServicioGas destino, ServicioGas origen)
    {
        destino.Tipo = origen.Tipo;
        destino.NombreServicio = origen.NombreServicio;
        destino.Precio = origen.Precio;
        destino.Empresa = origen.Empresa;
    }

    private async Task GuardarCambios()
    {
        try
        {
            guardando = true;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;
            StateHasChanged();

            await using var context = DbContextProvider.CreateDbContext();

            int creados = 0;
            int actualizados = 0;
            var errores = new List<string>();

            foreach (var servicio in servicios)
            {
                if (string.IsNullOrWhiteSpace(servicio.Tipo))
                {
                    errores.Add($"Fila con ID {servicio.Id}: El campo Tipo es obligatorio");
                    continue;
                }

                if (string.IsNullOrWhiteSpace(servicio.NombreServicio))
                {
                    errores.Add($"Fila con ID {servicio.Id}: El campo Nombre Servicio es obligatorio");
                    continue;
                }

                if (string.IsNullOrWhiteSpace(servicio.Precio))
                {
                    errores.Add($"Fila con ID {servicio.Id}: El campo Precio es obligatorio");
                    continue;
                }

                if (servicio.Id == 0)
                {
                    context.ServiciosGas.Add(servicio);
                    creados++;
                }
                else
                {
                    var existente = await context.ServiciosGas.FindAsync(servicio.Id);
                    if (existente != null)
                    {
                        existente.Tipo = servicio.Tipo;
                        existente.NombreServicio = servicio.NombreServicio;
                        existente.Precio = servicio.Precio;
                        existente.Empresa = servicio.Empresa;

                        context.ServiciosGas.Update(existente);
                        actualizados++;
                    }
                }
            }

            await context.SaveChangesAsync();

            if (errores.Any())
            {
                mensajeError = string.Join("<br/>", errores);
            }

            var mensaje = new List<string>();
            if (creados > 0) mensaje.Add($"{creados} servicio(s) creado(s)");
            if (actualizados > 0) mensaje.Add($"{actualizados} servicio(s) actualizado(s)");

            if (mensaje.Any())
            {
                mensajeExito = $"✓ {string.Join(" y ", mensaje)}";
            }

            await CargarServicios();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar cambios: {ex.Message}";
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        dotNetReference?.Dispose();
    }
}
