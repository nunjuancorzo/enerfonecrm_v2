    private void ToggleSeleccionarTodas(ChangeEventArgs e)
    {
        if ((bool?)e.Value == true)
        {
            filasSeleccionadas = Enumerable.Range(0, clientes.Count).ToHashSet();
        }
        else
        {
            filasSeleccionadas.Clear();
        }
    }

    private async Task CopiarFilasSeleccionadas()
    {
        filasCopia.Clear();
        var datosParaPortapapeles = new List<string>();
        
        foreach (var index in filasSeleccionadas.OrderBy(x => x))
        {
            if (index >= 0 && index < clientes.Count)
            {
                var clienteOriginal = clientes[index];
                
                // Crear una copia del cliente
                var copia = new Cliente
                {
                    Id = clienteOriginal.Id, // Incluir el ID para permitir edición al pegar
                    TipoCliente = clienteOriginal.TipoCliente,
                    Nombre = clienteOriginal.Nombre,
                    DniCif = clienteOriginal.DniCif,
                    Email = clienteOriginal.Email,
                    Telefono = clienteOriginal.Telefono,
                    Empresa = clienteOriginal.Empresa,
                    Cif = clienteOriginal.Cif,
                    TipoVia = clienteOriginal.TipoVia,
                    Direccion = clienteOriginal.Direccion,
                    Numero = clienteOriginal.Numero,
                    Escalera = clienteOriginal.Escalera,
                    Piso = clienteOriginal.Piso,
                    Puerta = clienteOriginal.Puerta,
                    Aclarador = clienteOriginal.Aclarador,
                    Poblacion = clienteOriginal.Poblacion,
                    Ciudad = clienteOriginal.Ciudad,
                    Provincia = clienteOriginal.Provincia,
                    CodigoPostal = clienteOriginal.CodigoPostal,
                    Pais = clienteOriginal.Pais,
                    Iban = clienteOriginal.Iban,
                    Representante = clienteOriginal.Representante,
                    Dni = clienteOriginal.Dni,
                    Cnae = clienteOriginal.Cnae,
                    Procedencia = clienteOriginal.Procedencia,
                    IdUsuario = clienteOriginal.IdUsuario,
                    Observaciones = clienteOriginal.Observaciones,
                    CopiaReciboBancario = clienteOriginal.CopiaReciboBancario
                };
                filasCopia.Add(copia);
                
                // Construir fila en formato TSV para portapapeles (compatible con Excel)
                // IMPORTANTE: Incluir ID como primera columna para permitir edición al pegar
                var fila = string.Join("\t",
                    clienteOriginal.Id.ToString(), // ID como primera columna
                    clienteOriginal.TipoCliente ?? "",
                    clienteOriginal.Nombre ?? "",
                    clienteOriginal.DniCif ?? "",
                    clienteOriginal.Email ?? "",
                    clienteOriginal.Telefono ?? "",
                    clienteOriginal.Empresa ?? "",
                    clienteOriginal.Cif ?? "",
                    clienteOriginal.TipoVia ?? "",
                    clienteOriginal.Direccion ?? "",
                    clienteOriginal.Numero ?? "",
                    clienteOriginal.Escalera ?? "",
                    clienteOriginal.Piso ?? "",
                    clienteOriginal.Puerta ?? "",
                    clienteOriginal.Aclarador ?? "",
                    clienteOriginal.Poblacion ?? "",
                    clienteOriginal.Ciudad ?? "",
                    clienteOriginal.Provincia ?? "",
                    clienteOriginal.CodigoPostal ?? "",
                    clienteOriginal.Pais ?? "",
                    clienteOriginal.Iban ?? "",
                    clienteOriginal.Representante ?? "",
                    clienteOriginal.Dni ?? "",
                    clienteOriginal.Cnae ?? "",
                    clienteOriginal.Procedencia ?? "",
                    clienteOriginal.IdUsuario?.ToString() ?? "",
                    clienteOriginal.Observaciones ?? "",
                    clienteOriginal.CopiaReciboBancario ?? ""
                );
                datosParaPortapapeles.Add(fila);
            }
        }
        
        // Copiar al portapapeles del sistema en formato TSV con cabeceras
        if (datosParaPortapapeles.Any())
        {
            // Agregar línea de cabeceras (ID como primera columna)
            var cabeceras = string.Join("\t",
                "ID", "TipoCliente", "Nombre", "DniCif", "Email", "Telefono",
                "Empresa", "Cif", "TipoVia", "Direccion", "Numero", "Escalera",
                "Piso", "Puerta", "Aclarador", "Poblacion", "Ciudad", "Provincia",
                "CodigoPostal", "Pais", "Iban", "Representante", "Dni", "Cnae",
                "Procedencia", "IdUsuario", "Observaciones", "CopiaReciboBancario"
            );
            
            var textoConCabeceras = cabeceras + "\n" + string.Join("\n", datosParaPortapapeles);
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", textoConCabeceras);
            mensajeExito = $"✓ {filasCopia.Count} fila(s) copiada(s) con ID. Al pegar, los registros con ID se actualizarán, sin ID se crearán como nuevos.";
        }
        else
        {
            mensajeExito = "No hay filas seleccionadas para copiar.";
        }
        
        StateHasChanged(); // Forzar actualización de UI
    }

    private async Task PegarFilas()
    {
        try
        {
            // Leer el contenido del portapapeles
            var textoPortapapeles = await JSRuntime.InvokeAsync<string>("navigator.clipboard.readText");
            
            if (string.IsNullOrWhiteSpace(textoPortapapeles))
            {
                mensajeError = "El portapapeles está vacío.";
                return;
            }

            // Procesar el texto del portapapeles (formato TSV)
            await ProcesarYAgregarFilas(textoPortapapeles);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al leer del portapapeles: {ex.Message}";
        }
    }

    [JSInvokable]
    public async Task PegarDesdePortapapeles(string textoPortapapeles)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(textoPortapapeles))
            {
                return;
            }

            await ProcesarYAgregarFilas(textoPortapapeles);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al pegar: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task ProcesarYAgregarFilas(string textoPortapapeles)
    {
        var lineas = textoPortapapeles.Split(new[] { '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
        int filasCreadas = 0;
        int filasActualizadas = 0;
        var clientesNuevos = new List<Cliente>();
        var clientesActualizados = new List<(Cliente cliente, int indiceOriginal)>();
        
        foreach (var linea in lineas)
        {
            var columnas = linea.Split('\t');
            
            // Omitir línea de cabeceras si existe (detecta si la primera columna dice "ID")
            if (columnas.Length > 0 && (columnas[0].Trim().Equals("ID", StringComparison.OrdinalIgnoreCase) || 
                                        columnas[0].Trim().Equals("TipoCliente", StringComparison.OrdinalIgnoreCase)))
                continue;
            
            // Verificar que tengamos al menos las columnas mínimas
            if (columnas.Length < 2)
                continue;

            // Leer el ID de la primera columna
            int idCliente = 0;
            if (columnas.Length > 0 && int.TryParse(columnas[0].Trim(), out int parsedId))
            {
                idCliente = parsedId;
            }

            // Crear objeto cliente con los datos
            var cliente = new Cliente
            {
                Id = idCliente,
                TipoCliente = columnas.Length > 1 ? columnas[1].Trim() : "",
                Nombre = columnas.Length > 2 ? columnas[2].Trim() : "",
                DniCif = columnas.Length > 3 ? columnas[3].Trim() : "",
                Email = columnas.Length > 4 ? columnas[4].Trim() : "",
                Telefono = columnas.Length > 5 ? columnas[5].Trim() : "",
                Empresa = columnas.Length > 6 ? columnas[6].Trim() : "",
                Cif = columnas.Length > 7 ? columnas[7].Trim() : "",
                TipoVia = columnas.Length > 8 ? columnas[8].Trim() : "",
                Direccion = columnas.Length > 9 ? columnas[9].Trim() : "",
                Numero = columnas.Length > 10 ? columnas[10].Trim() : "",
                Escalera = columnas.Length > 11 ? columnas[11].Trim() : "",
                Piso = columnas.Length > 12 ? columnas[12].Trim() : "",
                Puerta = columnas.Length > 13 ? columnas[13].Trim() : "",
                Aclarador = columnas.Length > 14 ? columnas[14].Trim() : "",
                Poblacion = columnas.Length > 15 ? columnas[15].Trim() : "",
                Ciudad = columnas.Length > 16 ? columnas[16].Trim() : "",
                Provincia = columnas.Length > 17 ? columnas[17].Trim() : "",
                CodigoPostal = columnas.Length > 18 ? columnas[18].Trim() : "",
                Pais = columnas.Length > 19 ? columnas[19].Trim() : "España",
                Iban = columnas.Length > 20 ? columnas[20].Trim() : "",
                Representante = columnas.Length > 21 ? columnas[21].Trim() : "",
                Dni = columnas.Length > 22 ? columnas[22].Trim() : "",
                Cnae = columnas.Length > 23 ? columnas[23].Trim() : "",
                Procedencia = columnas.Length > 24 ? columnas[24].Trim() : "",
                IdUsuario = columnas.Length > 25 && int.TryParse(columnas[25].Trim(), out int idUsuario) ? idUsuario : null,
                Observaciones = columnas.Length > 26 ? columnas[26].Trim() : "",
                CopiaReciboBancario = columnas.Length > 27 ? columnas[27].Trim() : ""
            };

            // Si tiene ID válido, buscar y actualizar el existente
            if (idCliente > 0)
            {
                var indiceExistente = clientes.FindIndex(c => c.Id == idCliente);
                if (indiceExistente >= 0)
                {
                    // Actualizar el cliente existente con los nuevos datos
                    var clienteExistente = clientes[indiceExistente];
                    clienteExistente.TipoCliente = cliente.TipoCliente;
                    clienteExistente.Nombre = cliente.Nombre;
                    clienteExistente.DniCif = cliente.DniCif;
                    clienteExistente.Email = cliente.Email;
                    clienteExistente.Telefono = cliente.Telefono;
                    clienteExistente.Empresa = cliente.Empresa;
                    clienteExistente.Cif = cliente.Cif;
                    clienteExistente.TipoVia = cliente.TipoVia;
                    clienteExistente.Direccion = cliente.Direccion;
                    clienteExistente.Numero = cliente.Numero;
                    clienteExistente.Escalera = cliente.Escalera;
                    clienteExistente.Piso = cliente.Piso;
                    clienteExistente.Puerta = cliente.Puerta;
                    clienteExistente.Aclarador = cliente.Aclarador;
                    clienteExistente.Poblacion = cliente.Poblacion;
                    clienteExistente.Ciudad = cliente.Ciudad;
                    clienteExistente.Provincia = cliente.Provincia;
                    clienteExistente.CodigoPostal = cliente.CodigoPostal;
                    clienteExistente.Pais = cliente.Pais;
                    clienteExistente.Iban = cliente.Iban;
                    clienteExistente.Representante = cliente.Representante;
                    clienteExistente.Dni = cliente.Dni;
                    clienteExistente.Cnae = cliente.Cnae;
                    clienteExistente.Procedencia = cliente.Procedencia;
                    clienteExistente.IdUsuario = cliente.IdUsuario;
                    clienteExistente.Observaciones = cliente.Observaciones;
                    clienteExistente.CopiaReciboBancario = cliente.CopiaReciboBancario;
                    
                    clientesActualizados.Add((clienteExistente, indiceExistente));
                    filasActualizadas++;
                }
                else
                {
                    // ID no encontrado, agregar como nuevo
                    clientesNuevos.Add(cliente);
                    filasCreadas++;
                }
            }
            else
            {
                // Sin ID, agregar como nuevo
                cliente.Id = 0;
                clientesNuevos.Add(cliente);
                filasCreadas++;
            }
        }
        
        // Mover clientes actualizados al inicio
        if (clientesActualizados.Any())
        {
            // Ordenar por índice descendente para eliminarlos correctamente
            foreach (var (cliente, indice) in clientesActualizados.OrderByDescending(x => x.indiceOriginal))
            {
                clientes.RemoveAt(indice);
            }
            // Insertar todos los actualizados al inicio
            clientesActualizados.Reverse();
            foreach (var (cliente, _) in clientesActualizados)
            {
                clientes.Insert(0, cliente);
            }
        }
        
        // Insertar todas las filas nuevas al inicio de la lista
        if (clientesNuevos.Any())
        {
            clientesNuevos.Reverse(); // Revertir para que mantengan el orden al insertar
            foreach (var cliente in clientesNuevos)
            {
                clientes.Insert(0, cliente);
            }
        }
        
        if (filasCreadas > 0 || filasActualizadas > 0)
        {
            var mensajes = new List<string>();
            if (filasCreadas > 0) mensajes.Add($"{filasCreadas} nueva(s)");
            if (filasActualizadas > 0) mensajes.Add($"{filasActualizadas} actualizada(s)");
            
            mensajeExito = $"✓ {string.Join(" y ", mensajes)} fila(s) al inicio de la lista. No olvides guardar.";
            filasSeleccionadas.Clear();
        }
        else
        {
            mensajeError = "No se pudieron procesar las filas del portapapeles.";
        }
        
        StateHasChanged();
    }

    private async Task GuardarCambios()
    {
        try
        {
            guardando = true;
            erroresValidacion.Clear();
            mensajeExito = string.Empty;
            mensajeError = string.Empty;

            // Validar todos los clientes
            if (!await ValidarClientesAsync())
            {
                mensajeError = "Por favor, corrige los errores de validación antes de guardar.";
                return;
            }

            int creados = 0;
            int actualizados = 0;
            int errores = 0;

            foreach (var cliente in clientes)
            {
                try
                {
                    // Limpiar IBAN antes de guardar
                    if (!string.IsNullOrEmpty(cliente.Iban))
                    {
                        cliente.Iban = cliente.Iban.Replace(" ", "");
                        if (cliente.Iban.Length > 24)
                        {
                            cliente.Iban = cliente.Iban.Substring(0, 24);
                        }
                    }

                    // Asignar usuario actual si no tiene
                    if (cliente.IdUsuario == null || cliente.IdUsuario == 0)
                    {
                        cliente.IdUsuario = AuthService.UsuarioActual?.Id;
                    }

                    // Asignar fecha de alta si es nuevo
                    if (cliente.Id == 0 && cliente.FechaAlta == null)
                    {
                        cliente.FechaAlta = DateTime.Now;
                    }

                    if (cliente.Id == 0)
                    {
                        var (exito, mensaje) = await ClienteService.CrearAsync(cliente);
                        if (exito)
                        {
                            creados++;
                        }
                        else
                        {
                            errores++;
                            erroresValidacion.Add($"Error en cliente nuevo: {mensaje}");
                        }
                    }
                    else
                    {
                        var (exito, mensaje) = await ClienteService.ActualizarAsync(cliente);
                        if (exito)
                        {
                            actualizados++;
                        }
                        else
                        {
                            errores++;
                            erroresValidacion.Add($"Error en cliente {cliente.Id}: {mensaje}");
                        }
                    }
                }
                catch (Exception ex)
                {
                    errores++;
                    erroresValidacion.Add($"Error en cliente {(cliente.Id > 0 ? cliente.Id.ToString() : "nuevo")}: {ex.Message}");
                }
            }

            if (errores == 0)
            {
                mensajeExito = $"✓ Cambios guardados correctamente. Creados: {creados}, Actualizados: {actualizados}";
                await CargarClientes(); // Recargar para obtener los IDs de los nuevos
            }
            else
            {
                mensajeError = $"Se guardaron algunos cambios pero hubo {errores} error(es). Creados: {creados}, Actualizados: {actualizados}";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar cambios: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task<bool> ValidarClientesAsync()
    {
        bool esValido = true;
        erroresValidacion.Clear();

        // Verificar duplicados de DNI/CIF dentro de la lista
        var dnisDuplicados = clientes
            .Where(c => !string.IsNullOrWhiteSpace(c.DniCif))
            .GroupBy(c => c.DniCif)
            .Where(g => g.Count() > 1)
            .Select(g => g.Key)
            .ToList();

        if (dnisDuplicados.Any())
        {
            erroresValidacion.Add($"DNI/CIF duplicados en la lista: {string.Join(", ", dnisDuplicados)}");
            esValido = false;
        }

        // Obtener todos los IDs de usuarios válidos
        await using var context = DbContextProvider.CreateDbContext();
        var usuariosValidos = await context.Usuarios.Select(u => u.Id).ToListAsync();

        for (int i = 0; i < clientes.Count; i++)
        {
            var cliente = clientes[i];
            var prefijo = $"Fila {i + 1}";

            // Validación 1: Tipo de cliente obligatorio
            if (string.IsNullOrWhiteSpace(cliente.TipoCliente))
            {
                erroresValidacion.Add($"{prefijo}: Tipo de cliente es obligatorio");
                esValido = false;
            }

            // Validación 2: Nombre obligatorio
            if (string.IsNullOrWhiteSpace(cliente.Nombre))
            {
                erroresValidacion.Add($"{prefijo}: Nombre es obligatorio");
                esValido = false;
            }

            // Validación 3: ID Usuario debe existir si tiene valor
            if (cliente.IdUsuario.HasValue && cliente.IdUsuario.Value > 0)
            {
                if (!usuariosValidos.Contains(cliente.IdUsuario.Value))
                {
                    erroresValidacion.Add($"{prefijo}: El ID Usuario {cliente.IdUsuario.Value} no existe");
                    esValido = false;
                }
            }
        }

        return esValido;
    }

