@inherits LayoutComponentBase
@using EnerfoneCRM.Services
@inject EnerfoneCRM.Services.EnvironmentService EnvService
@inject EnerfoneCRM.Services.AuthService AuthService
@inject ConfiguracionService ConfiguracionService
@inject AparienciaService AparienciaService
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="page app-shell">
    <NavMenu />

    <main class="main-content">
        <article class="content-wrapper">
            @Body
        </article>
        <Footer />
    </main>
    <VoltiChat />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        AparienciaService.OnChange += ActualizarApariencia;
    }

    private async Task CargarAparienciaEmpresaAsync()
    {
        try
        {
            var configuracion = await ConfiguracionService.ObtenerConfiguracionAsync();
            AparienciaService.Aplicar(
                configuracion?.TemaVisual,
                configuracion?.TemaColorAcento,
                configuracion?.TemaColorBarra,
                configuracion?.TemaColorFondo);
        }
        catch
        {
            AparienciaService.Aplicar(AparienciaService.PaletaPredeterminada);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Cargar sesión solo UNA VEZ cuando la app se carga
            await AuthService.CargarSesionAsync();
            await CargarAparienciaEmpresaAsync();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        AparienciaService.OnChange -= ActualizarApariencia;
    }

    private void ActualizarApariencia() => _ = InvokeAsync(StateHasChanged);
}
