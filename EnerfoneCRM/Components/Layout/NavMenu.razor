@code {
    private bool cargado = false;
    private bool reaplicarPaletaTrasNavegacion;
    private string? logoUrl;
    private string LogoMenuUrl => AuthService.EsSuperAdmin || string.IsNullOrWhiteSpace(logoUrl) ? "VoltiaSolutions.jpeg?v=3" : logoUrl;
    private bool mostrarModalAvisos = false;
    private bool cargandoModificaciones = false;
    private bool marcandoTodosAvisos = false;
    private bool hayModificacionesNoVistas = false;
    private string? errorAvisos;
    private string tipoAvisoSeleccionado = "energia";
    private string? grupoPrincipalAbierto;
    private List<Contrato> contratosModificados = new();
    private const string STORAGE_KEY = "contratos_vistos_v2";
    private readonly SemaphoreSlim contratosVistosLock = new(1, 1);
    private string RutaContratos => !AuthService.EsProveedor || AuthService.EsProveedorEnergia
        ? "contratos/energia"
        : AuthService.EsProveedorTelefonia
            ? "contratos/telefonia"
            : AuthService.EsProveedorAlarmas
                ? "contratos/alarmas"
                : "contratos/energia";

    private string ClaseRuta(string ruta)
    {
        var rutaActual = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        return string.Equals(rutaActual, ruta, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    }

    private void AlternarGrupoPrincipal(string grupo)
    {
        if (grupoPrincipalAbierto == grupo)
        {
            grupoPrincipalAbierto = null;
            return;
        }

        grupoPrincipalAbierto = grupo;
    }

    private IEnumerable<(string Tipo, string Nombre, string Icono, string Color, List<Contrato> Contratos)> ObtenerGruposContratosModificados()
    {
        var categorias = new[]
        {
            (Tipo: "energia", Nombre: "Energía", Icono: "lightning-charge-fill", Color: "warning"),
            (Tipo: "telefonia", Nombre: "Telefonía", Icono: "telephone-fill", Color: "primary"),
            (Tipo: "alarma", Nombre: "Alarmas", Icono: "shield-check", Color: "danger")
        };

        return categorias.Select(categoria =>
        {
            var contratos = contratosModificados
                .Where(contrato => NormalizarTipoContrato(contrato.Tipo) == categoria.Tipo)
                .OrderByDescending(contrato => contrato.FechaModificacion)
                .ToList();
            return (categoria.Tipo, categoria.Nombre, categoria.Icono, categoria.Color, Contratos: contratos);
        });
    }

    private static string NormalizarTipoContrato(string? tipo) => tipo?.Trim().ToLowerInvariant() switch
    {
        "energia" or "energía" => "energia",
        "telefonia" or "telefonía" => "telefonia",
        "alarma" or "alarmas" => "alarma",
        _ => string.Empty
    };

    private System.Timers.Timer? verificacionTimer;

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += StateHasChanged;
        ContratoService.ContratosActualizados += AlActualizarContratos;
        Navigation.LocationChanged += AlCambiarUbicacion;
    }

    private void AlActualizarContratos() => _ = InvokeAsync(async () =>
    {
        await VerificarModificacionesNoVistas();
        if (mostrarModalAvisos)
            await MostrarAvisosModificaciones();
        StateHasChanged();
    });

    private void AlCambiarUbicacion(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        grupoPrincipalAbierto = null;
        reaplicarPaletaTrasNavegacion = true;
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !cargado)
        {
            Console.WriteLine("[NavMenu] Iniciando componente NavMenu");
            await AuthService.CargarSesionAsync();
            await CargarLogoAsync();
            await CargarAparienciaAsync();
            await VerificarModificacionesNoVistas();
            
            // Iniciar timer para verificar cada 30 segundos
            if (AuthService.PuedeVerContratos)
            {
                Console.WriteLine("[NavMenu] Timer iniciado - verificará cada 30 segundos");
                verificacionTimer = new System.Timers.Timer(30000); // 30 segundos
                verificacionTimer.Elapsed += async (sender, e) => await OnTimerElapsed();
                verificacionTimer.AutoReset = true;
                verificacionTimer.Start();
            }
            else
            {
                Console.WriteLine("[NavMenu] Timer NO iniciado - usuario no puede ver contratos");
            }
            
            cargado = true;
            StateHasChanged();
        }
        else if (reaplicarPaletaTrasNavegacion)
        {
            reaplicarPaletaTrasNavegacion = false;
            await JS.InvokeVoidAsync("voltiaApariencia.inicializar");
        }
    }

    private async Task OnTimerElapsed()
    {
        Console.WriteLine("[NavMenu] ⏰ Timer ejecutado - verificando modificaciones...");
        await InvokeAsync(async () =>
        {
            await VerificarModificacionesNoVistas();
            StateHasChanged();
        });
    }

    private async Task CargarLogoAsync()
    {
        logoUrl = null;
        if (!AuthService.EstaAutenticado || AuthService.EmpresaId <= 0 || AuthService.EsSuperAdmin)
            return;

        try
        {
            var configuracion = await ConfiguracionService.ObtenerConfiguracionAsync();
            logoUrl = configuracion?.LogoUrl;
        }
        catch (Exception)
        {
            logoUrl = null;
        }
    }

    private async Task CargarAparienciaAsync()
    {
        if (!AuthService.EstaAutenticado)
            return;

        if (AuthService.EsSuperAdmin)
        {
            AparienciaService.Aplicar(AparienciaService.PaletaPredeterminada);
            await JS.InvokeVoidAsync("voltiaApariencia.establecerModo", "superadmin");
            return;
        }

        if (AuthService.EmpresaId <= 0)
            return;

        try
        {
            await JS.InvokeVoidAsync("voltiaApariencia.establecerModo", "empresa");
            var configuracion = await ConfiguracionService.ObtenerConfiguracionAsync();
            AparienciaService.Aplicar(
                configuracion?.TemaVisual,
                configuracion?.TemaColorAcento,
                configuracion?.TemaColorBarra,
                configuracion?.TemaColorFondo);
            await JS.InvokeVoidAsync("voltiaApariencia.aplicar", AparienciaService.PaletaActualVisual, AuthService.EmpresaId, true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavMenu] No se pudo aplicar la apariencia de la empresa: {ex.Message}");
        }
    }

    private async Task VerificarModificacionesNoVistas()
    {
        try
        {
            if (AuthService.PuedeVerContratos)
            {
                var contratosEnergia = await ContratoService.ObtenerTodosPorTipoAsync("energia", AuthService.UsuarioActual?.Rol, AuthService.UsuarioActual?.NombreUsuario, AuthService.UsuarioActual?.Id);
                var contratosTelefonia = await ContratoService.ObtenerTodosPorTipoAsync("telefonia", AuthService.UsuarioActual?.Rol, AuthService.UsuarioActual?.NombreUsuario, AuthService.UsuarioActual?.Id);
                var contratosAlarmas = await ContratoService.ObtenerTodosPorTipoAsync("alarma", AuthService.UsuarioActual?.Rol, AuthService.UsuarioActual?.NombreUsuario, AuthService.UsuarioActual?.Id);
                
                Console.WriteLine($"[NavMenu] Contratos obtenidos - Energía: {contratosEnergia.Count()}, Telefonía: {contratosTelefonia.Count()}, Alarmas: {contratosAlarmas.Count()}");
                
                var todosContratos = contratosEnergia.Concat(contratosTelefonia).Concat(contratosAlarmas)
                    .Where(c => c.FechaModificacion.HasValue)
                    .OrderByDescending(c => c.FechaModificacion)
                    .ToList();

                Console.WriteLine($"[NavMenu] Total contratos con FechaModificacion: {todosContratos.Count}");
                
                // Obtener contratos vistos con sus fechas de modificación
                Dictionary<int, DateTime> contratosVistos;
                await contratosVistosLock.WaitAsync();
                try
                {
                    contratosVistos = await SessionStorage.GetItemAsync<Dictionary<int, DateTime>>(STORAGE_KEY) ?? new Dictionary<int, DateTime>();
                }
                finally
                {
                    contratosVistosLock.Release();
                }
                
                Console.WriteLine($"[NavMenu] Contratos vistos en storage: {contratosVistos.Count}");
                
                // Verificar si hay contratos nuevos o modificados después de ser vistos
                hayModificacionesNoVistas = todosContratos.Any(c => 
                    !contratosVistos.ContainsKey(c.Id) || 
                    (c.FechaModificacion.HasValue && contratosVistos[c.Id] < c.FechaModificacion.Value));
                
                Console.WriteLine($"[NavMenu] Hay modificaciones no vistas: {hayModificacionesNoVistas}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavMenu] Error en VerificarModificacionesNoVistas: {ex.Message}");
            hayModificacionesNoVistas = false;
        }
    }

    private async Task MostrarAvisosModificaciones()
    {
        mostrarModalAvisos = true;
        cargandoModificaciones = true;
        StateHasChanged();

        try
        {
            var contratosEnergia = await ContratoService.ObtenerTodosPorTipoAsync("energia", AuthService.UsuarioActual?.Rol, AuthService.UsuarioActual?.NombreUsuario, AuthService.UsuarioActual?.Id);
            var contratosTelefonia = await ContratoService.ObtenerTodosPorTipoAsync("telefonia", AuthService.UsuarioActual?.Rol, AuthService.UsuarioActual?.NombreUsuario, AuthService.UsuarioActual?.Id);
            var contratosAlarmas = await ContratoService.ObtenerTodosPorTipoAsync("alarma", AuthService.UsuarioActual?.Rol, AuthService.UsuarioActual?.NombreUsuario, AuthService.UsuarioActual?.Id);
            
            var todosContratos = contratosEnergia.Concat(contratosTelefonia).Concat(contratosAlarmas).ToList();
            await contratosVistosLock.WaitAsync();
            try
            {
                var contratosVistos = await SessionStorage.GetItemAsync<Dictionary<int, DateTime>>(STORAGE_KEY) ?? new Dictionary<int, DateTime>();
                contratosModificados = todosContratos
                    .Where(contrato => contrato.FechaModificacion.HasValue)
                    .Where(contrato => !contratosVistos.TryGetValue(contrato.Id, out var fechaVista) || fechaVista < contrato.FechaModificacion!.Value)
                    .OrderByDescending(contrato => contrato.FechaModificacion)
                    .Take(20)
                    .ToList();
            }
            finally
            {
                contratosVistosLock.Release();
            }

            Console.WriteLine($"[NavMenu] Modal abierto - Contratos modificados a mostrar: {contratosModificados.Count}");
            foreach (var c in contratosModificados)
            {
                Console.WriteLine($"[NavMenu] Contrato #{c.Id} - {c.NombreCliente} - Última modificación: {c.FechaModificacion}");
            }

            await VerificarModificacionesNoVistas();
        }
        catch (Exception)
        {
            contratosModificados = new List<Contrato>();
        }
        finally
        {
            cargandoModificaciones = false;
            StateHasChanged();
        }
    }

    private void CerrarModalAvisos()
    {
        mostrarModalAvisos = false;
        StateHasChanged();
    }

    private async Task MarcarContratoVistoAsync(Contrato contrato, ChangeEventArgs args)
    {
        var marcado = args.Value is bool valor && valor || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (!marcado || !contrato.FechaModificacion.HasValue) return;

        var actualizado = false;
        await contratosVistosLock.WaitAsync();
        try
        {
            var contratosVistos = await SessionStorage.GetItemAsync<Dictionary<int, DateTime>>(STORAGE_KEY) ?? new Dictionary<int, DateTime>();
            contratosVistos[contrato.Id] = contrato.FechaModificacion.Value;
            await SessionStorage.SetItemAsync(STORAGE_KEY, contratosVistos);
            contratosModificados.RemoveAll(item => item.Id == contrato.Id);
            actualizado = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar el estado Visto del contrato: {ex.Message}");
        }
        finally
        {
            contratosVistosLock.Release();
        }

        if (actualizado)
            await VerificarModificacionesNoVistas();
        StateHasChanged();
    }

    private async Task MarcarTipoComoVistoAsync(string tipo)
    {
        if (marcandoTodosAvisos || !AuthService.PuedeVerContratos || AuthService.UsuarioActual == null) return;

        marcandoTodosAvisos = true;
        errorAvisos = null;
        try
        {
            var empresaId = AuthService.EmpresaId;
            var usuario = AuthService.UsuarioActual;
            var contratos = await ContratoService.ObtenerTodosPorTipoAsync(tipo, usuario.Rol, usuario.NombreUsuario, usuario.Id);
            if (AuthService.EmpresaId != empresaId || AuthService.UsuarioActual?.Id != usuario.Id)
                throw new UnauthorizedAccessException("La sesión o empresa cambió durante la operación.");

            var modificados = contratos.Where(contrato => contrato.FechaModificacion.HasValue).ToList();
            await contratosVistosLock.WaitAsync();
            try
            {
                var contratosVistos = await SessionStorage.GetItemAsync<Dictionary<int, DateTime>>(STORAGE_KEY) ?? new Dictionary<int, DateTime>();
                foreach (var contrato in modificados)
                {
                    var fechaModificacion = contrato.FechaModificacion!.Value;
                    if (!contratosVistos.TryGetValue(contrato.Id, out var fechaVista) || fechaVista < fechaModificacion)
                        contratosVistos[contrato.Id] = fechaModificacion;
                }

                if (modificados.Count > 0)
                    await SessionStorage.SetItemAsync(STORAGE_KEY, contratosVistos);
            }
            finally
            {
                contratosVistosLock.Release();
            }

            var tipoNormalizado = NormalizarTipoContrato(tipo);
            contratosModificados.RemoveAll(contrato => NormalizarTipoContrato(contrato.Tipo) == tipoNormalizado);
            await VerificarModificacionesNoVistas();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al marcar todos los avisos de {tipo} como vistos: {ex.Message}");
            errorAvisos = "No se pudieron marcar todos los contratos como vistos. Vuelve a intentarlo.";
        }
        finally
        {
            marcandoTodosAvisos = false;
            StateHasChanged();
        }
    }

    private Task IrAContrato(Contrato contrato)
    {
        var tipo = contrato.Tipo?.ToLower() ?? "";
        if (tipo == "energia" || tipo == "energía")
        {
            Navigation.NavigateTo($"/contratos/energia?id={contrato.Id}", true);
        }
        else if (tipo == "telefonia" || tipo == "telefonía")
        {
            Navigation.NavigateTo($"/contratos/telefonia?id={contrato.Id}", true);
        }
        else if (tipo == "alarma" || tipo == "alarmas")
        {
            Navigation.NavigateTo($"/contratos/alarmas?id={contrato.Id}", true);
        }
        return Task.CompletedTask;
    }

    private async Task Logout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/login", true);
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= StateHasChanged;
        ContratoService.ContratosActualizados -= AlActualizarContratos;
        Navigation.LocationChanged -= AlCambiarUbicacion;
        
        if (verificacionTimer != null)
        {
            verificacionTimer.Stop();
            verificacionTimer.Dispose();
        }
    }
}


