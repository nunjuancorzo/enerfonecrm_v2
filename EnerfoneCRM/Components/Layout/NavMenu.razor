                    <button class="btn btn-link text-white text-decoration-none" 
                            @onclick="Logout"
                            style="padding: 8px 12px; background: rgba(220, 53, 69, 0.2); border-radius: 8px; border: 1px solid rgba(220, 53, 69, 0.5);">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        <span class="d-none d-md-inline">Salir</span>
                    </button>
                </div>
            }
        </div>
    </div>
</nav>

<!-- Modal de Avisos de Modificaciones -->
@if (mostrarModalAvisos)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); color: white;">
                    <h5 class="modal-title">
                        <i class="bi bi-bell-fill text-warning me-2"></i>
                        Notificaciones de contratos
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalAvisos"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(errorAvisos))
                    {
                        <div class="alert alert-danger" role="alert">@errorAvisos</div>
                    }
                    @if (cargandoModificaciones)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-3 text-muted">Cargando modificaciones...</p>
                        </div>
                    }
                    else if (!contratosModificados.Any())
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            No hay contratos modificados recientemente
                        </div>
                    }
                    else
                    {
                        var gruposAvisos = ObtenerGruposContratosModificados().ToList();
                        var grupoAvisosActivo = gruposAvisos.First(grupo => grupo.Tipo == tipoAvisoSeleccionado);
                        <div class="nav nav-tabs mb-3" role="tablist" aria-label="Tipo de contrato modificado">
                            @foreach (var grupo in gruposAvisos)
                            {
                                var seleccionado = grupo.Tipo == tipoAvisoSeleccionado;
                                <button type="button" class="nav-link @(seleccionado ? "active" : string.Empty)" role="tab" aria-controls="@($"avisos-panel-{grupo.Tipo}")" aria-selected="@seleccionado" @onclick="() => tipoAvisoSeleccionado = grupo.Tipo">
                                    <i class="bi bi-@grupo.Icono text-@grupo.Color me-1" aria-hidden="true"></i>
                                    @grupo.Nombre <span class="badge bg-secondary ms-1">@grupo.Contratos.Count</span>
                                </button>
                            }
                        </div>
                        <div id="@($"avisos-panel-{grupoAvisosActivo.Tipo}")" role="tabpanel" aria-label="@grupoAvisosActivo.Nombre">
                            <div class="d-flex justify-content-end mb-3">
                                <button type="button" class="btn btn-outline-primary btn-sm" disabled="@marcandoTodosAvisos" @onclick="async () => await MarcarTipoComoVistoAsync(grupoAvisosActivo.Tipo)">
                                    @if (marcandoTodosAvisos)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span><span>Marcando...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check2-all me-1"></i><span>Marcar todos como vistos</span>
                                    }
                                </button>
                            </div>
                            @if (!grupoAvisosActivo.Contratos.Any())
                            {
                                <div class="alert alert-info mb-0">
                                    <i class="bi bi-info-circle me-2"></i>No hay contratos modificados de @grupoAvisosActivo.Nombre.ToLowerInvariant().
                                </div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @foreach (var contrato in grupoAvisosActivo.Contratos)
                                    {
                                        <div @key="contrato.Id" class="list-group-item">
                                            <div class="d-flex w-100 justify-content-between align-items-center">
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center mb-1">
                                                        <i class="bi bi-@grupoAvisosActivo.Icono text-@grupoAvisosActivo.Color me-2" aria-hidden="true"></i>
                                                        <h6 class="mb-0"><strong>Contrato #@contrato.Id</strong> - @contrato.NombreCliente</h6>
                                                    </div>
                                                    <p class="mb-1 text-muted" style="font-size: 0.9rem;"><strong>Estado:</strong> @contrato.Estado | <strong>Comercial:</strong> @contrato.Comercial</p>
                                                    @if (!string.IsNullOrEmpty(contrato.Direccion))
                                                    {
                                                        <p class="mb-0 text-muted" style="font-size: 0.85rem;"><i class="bi bi-geo-alt me-1"></i>@contrato.Direccion</p>
                                                    }
                                                </div>
                                                <div class="text-end ms-3 d-flex flex-column align-items-end gap-2">
                                                    <small class="text-muted d-block"><i class="bi bi-clock me-1"></i>@contrato.FechaModificacion?.ToString("dd/MM/yyyy HH:mm")</small>
                                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="async () => await IrAContrato(contrato)">Ver contrato</button>
                                                    <div class="form-check">
                                                        <input id="@($"contrato-visto-{contrato.Id}")" class="form-check-input" type="checkbox" aria-label="Marcar contrato @contrato.Id como visto" @onchange="args => MarcarContratoVistoAsync(contrato, args)" />
                                                        <label class="form-check-label" for="@($"contrato-visto-{contrato.Id}")">Visto</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalAvisos">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

