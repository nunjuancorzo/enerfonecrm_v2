@using EnerfoneCRM.Models
@using EnerfoneCRM.Services
@using Microsoft.JSInterop
@inject FirmaService FirmaService
@inject AuthService AuthService
@inject IJSRuntime JS

@if (ContratoId > 0 && AuthService.EstaAutenticado)
{
    <div class="card shadow-sm mb-3 border-primary">
        <div class="card-header bg-primary text-white">
            <h6 class="mb-0"><i class="bi bi-pen me-2"></i>Firma de documentacion</h6>
        </div>
        <div class="card-body">
            @if (solicitud == null)
            {
                <p class="text-muted mb-3">No se ha enviado documentacion a firma.</p>
                <button type="button" class="btn btn-primary" @onclick="Enviar" disabled="@cargando">
                    <i class="bi bi-send me-1"></i>Enviar documentacion al cliente
                </button>
            }
            else
            {
                <div class="row g-2 small mb-3">
                    <div class="col-md-3"><strong>Estado:</strong> <span class="badge @ColorEstado(solicitud.Estado)">@solicitud.Estado</span></div>
                    <div class="col-md-3"><strong>Destinatario:</strong> @solicitud.EmailDestinatario</div>
                    <div class="col-md-3"><strong>Enviado:</strong> @solicitud.FechaCreacionUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="col-md-3"><strong>Caducidad:</strong> @solicitud.FechaCaducidadUtc.ToLocalTime().ToString("dd/MM/yyyy")</div>
                    <div class="col-md-3"><strong>Firma:</strong> @(solicitud.FechaFirmaUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                    <div class="col-md-3"><strong>Documentos:</strong> 1 original@(solicitud.DocumentoFirmadoId.HasValue ? " + 1 firmado" : "")</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (solicitud.Estado is EstadoSolicitudFirma.Enviado or EstadoSolicitudFirma.Pendiente or EstadoSolicitudFirma.EnProceso or EstadoSolicitudFirma.Caducado)
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="Enviar" disabled="@cargando"><i class="bi bi-arrow-repeat me-1"></i>@(solicitud.Estado == EstadoSolicitudFirma.Caducado ? "Enviar de nuevo" : "Reenviar")</button>
                        @if (solicitud.Estado != EstadoSolicitudFirma.Caducado)
                        {
                            <button type="button" class="btn btn-outline-danger" @onclick="Cancelar" disabled="@cargando"><i class="bi bi-x-circle me-1"></i>Cancelar</button>
                        }
                    }
                    @if (solicitud.DocumentoFirmadoId.HasValue)
                    {
                        <button type="button" class="btn btn-outline-success" @onclick="VerDocumentoFirmado"><i class="bi bi-file-earmark-pdf me-1"></i>Ver documento firmado</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="ConsultarOriginal"><i class="bi bi-eye me-1"></i>Ver documentacion</button>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @(error ? "alert-danger" : "alert-success") mt-3 mb-0">@mensaje</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int ContratoId { get; set; }
    private SolicitudFirma? solicitud;
    private bool cargando;
    private bool error;
    private string mensaje = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (ContratoId > 0 && AuthService.EstaAutenticado)
        {
            solicitud = await FirmaService.ObtenerUltimaSolicitudAsync(ContratoId);
        }
    }

    private async Task Enviar()
    {
        cargando = true;
        var resultado = await FirmaService.CrearSolicitudAsync(ContratoId);
        error = !resultado.Exito;
        mensaje = resultado.Mensaje;
        solicitud = await FirmaService.ObtenerUltimaSolicitudAsync(ContratoId);
        cargando = false;
    }

    private async Task Cancelar()
    {
        cargando = true;
        var resultado = await FirmaService.CancelarSolicitudAsync(ContratoId);
        error = !resultado.Exito;
        mensaje = resultado.Mensaje;
        solicitud = await FirmaService.ObtenerUltimaSolicitudAsync(ContratoId);
        cargando = false;
    }

    private async Task VerDocumentoFirmado()
    {
        if (!solicitud?.DocumentoFirmadoId.HasValue ?? true) return;
        var documento = await FirmaService.ObtenerDocumentoPrivadoAsync(ContratoId, solicitud.DocumentoFirmadoId.Value);
        if (documento.Contenido == null) return;
        await JS.InvokeVoidAsync("openFileInNewTab", documento.Nombre ?? "contrato-firmado.pdf", Convert.ToBase64String(documento.Contenido), "application/pdf");
    }

    private async Task ConsultarOriginal()
    {
        var documento = await FirmaService.ObtenerDocumentoPrivadoAsync(ContratoId, solicitud?.DocumentoOriginalId ?? 0);
        if (documento.Contenido == null) return;
        await JS.InvokeVoidAsync("openFileInNewTab", documento.Nombre ?? "contrato-original.pdf", Convert.ToBase64String(documento.Contenido), "application/pdf");
    }

    private static string ColorEstado(string estado) => estado switch
    {
        EstadoSolicitudFirma.Firmado => "bg-success",
        EstadoSolicitudFirma.Cancelado or EstadoSolicitudFirma.Caducado => "bg-secondary",
        EstadoSolicitudFirma.Enviado or EstadoSolicitudFirma.EnProceso => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}